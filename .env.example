# Altrix Labs Health Copilot - Environment Configuration Template
# Copy this file to .env for local development. Never commit real keys or secrets.

# Browser-safe Supabase configuration (Publishable Key only, protected by Row Level Security)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only AI configuration (NEVER prefix with PUBLIC_, NEVER expose to client)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Application settings
PUBLIC_APP_NAME="Altrix Health Copilot"
PUBLIC_APP_ENV="development"
