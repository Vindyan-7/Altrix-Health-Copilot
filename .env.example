# Altrix Labs Health Copilot - Environment Configuration Template
# Copy this file to .env for local development. Never commit real keys or secrets.

# AI Provider Configuration (Server-side only)
# For Milestone 1, the app operates fully offline with synthetic fixtures.
# When a real Gemini key is configured in future milestones, provide it below:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Supabase Configuration (Deferred for Milestone 1 - do not connect yet)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Application settings
PUBLIC_APP_NAME="Altrix Health Copilot"
PUBLIC_APP_ENV="development"
