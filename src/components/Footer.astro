---
import { Activity, Check, AlertTriangle } from '@lucide/astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-aura-sidebar-deep text-aura-sidebar-text border-t border-white/10 text-xs mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      <!-- Col 1: Brand & Purpose -->
      <div class="md:col-span-2 space-y-2.5">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-md bg-aura-accent-orange/20 border border-aura-accent-orange/40 text-aura-accent-orange flex items-center justify-center font-bold text-xs">
            <Activity class="w-3.5 h-3.5" stroke-width={2.2} />
          </div>
          <span class="text-white font-serif font-bold text-base tracking-tight">Altrix Health Copilot</span>
          <span class="bg-white/10 text-aura-sidebar-active text-[10px] px-2.5 py-0.5 rounded-full font-sans font-medium">Privacy-First</span>
        </div>
        <p class="text-aura-sidebar-text text-xs leading-relaxed max-w-xl">
          An AI-powered personal health companion engineered to organize medical records into traceable,
          plain-language insights grounded in reviewed evidence without fabricating diagnoses or medication advice.
        </p>
        <div class="text-[11px] text-aura-sidebar-text/80 space-y-0.5 pt-1">
          <div><strong class="text-white">Architecture:</strong> Privacy-First Health Assistant</div>
          <div><strong class="text-white">Security:</strong> PostgreSQL Row Level Security (RLS)</div>
          <div><strong class="text-white">Clinical Scope:</strong> Educational & Non-Diagnostic</div>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h3 class="text-white font-semibold text-[11px] uppercase tracking-wider mb-2.5">Platform Navigation</h3>
        <ul class="space-y-1.5 text-xs">
          <li><a href="/" class="hover:text-aura-sidebar-active transition">Home (Overview)</a></li>
          <li><a href="/dashboard" class="hover:text-aura-sidebar-active transition">Health Dashboard</a></li>
          <li><a href="/copilot" class="hover:text-aura-sidebar-active transition">Health Copilot (40 Scenarios)</a></li>
          <li><a href="/records" class="hover:text-aura-sidebar-active transition">Medical Records Intake</a></li>
          <li><a href="/review" class="hover:text-aura-sidebar-active transition">Report Review & Inspection</a></li>
          <li><a href="/timeline" class="hover:text-aura-sidebar-active transition">Health Timeline</a></li>
          <li><a href="/auth" class="hover:text-aura-sidebar-active transition">Account & Sign In</a></li>
        </ul>
      </div>

      <!-- Col 3: Safety Guardrails -->
      <div>
        <h3 class="text-white font-semibold text-[11px] uppercase tracking-wider mb-2.5">Safety Guardrails</h3>
        <ul class="space-y-1.5 text-[11px] text-aura-sidebar-text">
          <li class="flex items-start gap-1.5">
            <Check class="w-3.5 h-3.5 text-emerald-400 shrink-0 mt-0.5" stroke-width={2.2} />
            <span>Deterministic red-flag routing before LLM execution</span>
          </li>
          <li class="flex items-start gap-1.5">
            <Check class="w-3.5 h-3.5 text-emerald-400 shrink-0 mt-0.5" stroke-width={2.2} />
            <span>Zero fabrication of test values or ranges</span>
          </li>
          <li class="flex items-start gap-1.5">
            <Check class="w-3.5 h-3.5 text-emerald-400 shrink-0 mt-0.5" stroke-width={2.2} />
            <span>Explicit user review & uncertainty flags</span>
          </li>
          <li class="flex items-start gap-1.5">
            <Check class="w-3.5 h-3.5 text-emerald-400 shrink-0 mt-0.5" stroke-width={2.2} />
            <span>Offline fallback with synthetic fixtures</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Safety Disclaimer Bar -->
    <div class="mt-6 pt-5 border-t border-white/10 text-[11px] text-aura-sidebar-text leading-relaxed">
      <div class="bg-white/5 rounded-xl p-3 border border-white/5 mb-3 flex items-start gap-2.5">
        <AlertTriangle class="w-4 h-4 text-aura-accent-orange shrink-0 mt-0.5" stroke-width={2} />
        <div>
          <strong class="text-aura-accent-orange block mb-0.5">Clinical & Regulatory Safety Notice:</strong>
          Altrix Health Copilot is an educational technology prototype. It is NOT a medical device, diagnostic engine,
          or clinical prescribing tool. It does not provide individualized medication dosages or validate emergencies.
          If you are experiencing severe symptoms, chest pain, difficulty breathing, or other urgent conditions,
          immediately dial local emergency services or visit the nearest emergency medical facility.
        </div>
      </div>
      <div class="flex flex-col sm:flex-row justify-between items-center gap-2 text-aura-sidebar-text/70">
        <div>© {currentYear} Altrix Health. All rights reserved.</div>
        <div>Zero PHI stored • Server-side secret isolation • PostgreSQL Row Level Security</div>
      </div>
    </div>
  </div>
</footer>
