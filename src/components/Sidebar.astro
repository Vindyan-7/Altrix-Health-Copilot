---
import {
  LayoutDashboard,
  FileText,
  CheckSquare,
  Clock,
  MessageSquare,
  MapPin,
  X,
  Activity,
  UserCheck,
} from '@lucide/astro';

export interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;

const navItems = [
  {
    href: '/',
    label: 'Home',
    icon: LayoutDashboard,
  },
  {
    href: '/dashboard',
    label: 'Workspace',
    icon: LayoutDashboard,
  },
  {
    href: '/copilot',
    label: 'Health Copilot',
    icon: MessageSquare,
  },
  {
    href: '/records',
    label: 'My Records',
    icon: FileText,
  },
  {
    href: '/review',
    label: 'Report Review',
    icon: CheckSquare,
  },
  {
    href: '/timeline',
    label: 'Health Timeline',
    icon: Clock,
  },
];

function isCurrent(href: string) {
  if (href === '/') {
    return activePath === '/' || activePath === '';
  }
  return activePath.startsWith(href);
}
---

<!-- Desktop Sidebar -->
<aside
  class="hidden lg:flex flex-col w-[244px] shrink-0 bg-aura-sidebar text-aura-sidebar-text min-h-screen p-5 select-none"
  aria-label="Primary Navigation"
>
  <!-- Brand Header -->
  <div class="flex items-center gap-3 pt-1 pb-6 px-1">
    <div class="w-8 h-8 rounded-lg bg-aura-accent-orange/20 border border-aura-accent-orange/40 flex items-center justify-center text-aura-accent-orange shrink-0">
      <Activity class="w-4 h-4" stroke-width={2.2} />
    </div>
    <div class="flex flex-col">
      <span class="text-white font-serif font-bold text-lg leading-tight tracking-tight">Altrix Health</span>
      <span class="text-[9.5px] font-semibold text-aura-sidebar-text tracking-[0.16em] uppercase">Health Copilot</span>
    </div>
  </div>

  <!-- Navigation items -->
  <nav class="space-y-1.5 flex-grow" aria-label="Main menu">
    {navItems.map((item) => {
      const active = isCurrent(item.href);
      const IconComponent = item.icon;
      return (
        <a
          href={item.href}
          aria-current={active ? 'page' : undefined}
          class={`flex items-center justify-between px-3.5 py-2.5 rounded-full text-xs font-medium transition-all group focus:outline-none focus:ring-2 focus:ring-aura-sidebar-active ${
            active
              ? 'bg-aura-sidebar-active text-aura-text font-semibold shadow-xs'
              : 'text-aura-sidebar-text hover:text-white hover:bg-white/5'
          }`}
        >
          <div class="flex items-center gap-3">
            <IconComponent class="w-4 h-4 shrink-0" stroke-width={1.9} />
            <span>{item.label}</span>
          </div>

          {item.badge && (
            <span class={`text-[10px] px-2 py-0.5 rounded-full font-semibold ${
              active
                ? 'bg-aura-action text-white'
                : 'bg-aura-accent-orange/25 text-aura-accent-orange'
            }`}>
              {item.badge}
            </span>
          )}
        </a>
      );
    })}

    <!-- Account & Exploration Items -->
    <div class="pt-4 mt-4 border-t border-white/10 space-y-1">
      <div class="px-3 text-[10px] font-semibold tracking-wider text-aura-sidebar-text/70 uppercase">
        Security & Vault
      </div>
      <a
        href="/auth"
        class={`flex items-center gap-3 px-3.5 py-2 rounded-full text-xs transition ${
          isCurrent('/auth')
            ? 'bg-aura-sidebar-active text-aura-text font-semibold shadow-xs'
            : 'text-aura-sidebar-text hover:text-white hover:bg-white/5'
        }`}
      >
        <UserCheck class="w-4 h-4 shrink-0" stroke-width={1.8} />
        <span>Account & Auth</span>
      </a>
      <a
        href="/copilot"
        class="flex items-center gap-3 px-3.5 py-2 rounded-full text-xs text-aura-sidebar-text hover:text-white hover:bg-white/5 transition"
      >
        <MapPin class="w-4 h-4 shrink-0" stroke-width={1.8} />
        <span>Nearby Care (Demo)</span>
      </a>
    </div>
  </nav>

  <!-- Bottom Session Card (links to /auth) -->
  <a
    href="/auth"
    class="bg-aura-sidebar-deep hover:bg-black/40 transition rounded-2xl p-3.5 mt-auto border border-white/5 shadow-inner block group cursor-pointer"
    title="View Account Details & Authentication State"
  >
    <div class="flex items-center justify-between mb-1.5">
      <span class="text-[9.5px] font-semibold text-aura-sidebar-active tracking-wider uppercase">Session State</span>
      <span id="sidebar-session-badge" class="inline-flex items-center gap-1 text-[10px] text-aura-sidebar-text">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
        Guest Mode
      </span>
    </div>
    <div id="sidebar-session-title" class="text-white text-xs font-semibold truncate group-hover:text-aura-sidebar-active transition">
      Guest Visitor
    </div>
    <div id="sidebar-session-sub" class="text-[11px] text-aura-sidebar-text leading-tight mt-0.5">Explore Guided Copilot</div>
    <div class="text-[10px] text-aura-sidebar-text/80 mt-2 pt-2 border-t border-white/5 flex items-center justify-between">
      <span>Account & Sign In</span>
      <span class="text-aura-sidebar-active font-mono text-[11px]">→</span>
    </div>
  </a>
</aside>

<!-- Mobile Navigation Drawer Overlay (Hidden by default) -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-50 lg:hidden bg-aura-sidebar-deep/60 backdrop-blur-xs hidden transition-opacity"
  aria-modal="true"
  role="dialog"
  aria-label="Mobile Navigation"
>
  <div class="w-[280px] max-w-[85vw] h-full bg-aura-sidebar text-aura-sidebar-text p-5 flex flex-col shadow-2xl">
    <div class="flex items-center justify-between pb-6 border-b border-white/10">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-aura-accent-orange/20 border border-aura-accent-orange/40 flex items-center justify-center text-aura-accent-orange">
          <Activity class="w-4 h-4" stroke-width={2.2} />
        </div>
        <div>
          <div class="text-white font-serif font-bold text-base leading-tight">Altrix Health</div>
          <div class="text-[9px] font-semibold text-aura-sidebar-text tracking-widest uppercase">Health Copilot</div>
        </div>
      </div>
      <button
        id="btn-close-drawer"
        type="button"
        class="text-aura-sidebar-text hover:text-white p-1 rounded-lg focus:outline-none focus:ring-2 focus:ring-aura-sidebar-active"
        aria-label="Close navigation"
      >
        <X class="w-5 h-5" stroke-width={2} />
      </button>
    </div>

    <!-- Mobile Nav Links -->
    <nav class="py-4 space-y-1.5 flex-grow overflow-y-auto">
      {navItems.map((item) => {
        const active = isCurrent(item.href);
        const IconComponent = item.icon;
        return (
          <a
            href={item.href}
            class={`flex items-center justify-between px-3.5 py-3 rounded-full text-sm font-medium transition ${
              active
                ? 'bg-aura-sidebar-active text-aura-text font-semibold shadow-xs'
                : 'text-aura-sidebar-text hover:text-white hover:bg-white/5'
            }`}
          >
            <div class="flex items-center gap-3">
              <IconComponent class="w-4 h-4 shrink-0" stroke-width={1.9} />
              <span>{item.label}</span>
            </div>
          </a>
        );
      })}
    </nav>

    <!-- Mobile Session Info -->
    <a href="/auth" class="bg-aura-sidebar-deep rounded-xl p-3 border border-white/5 mt-auto block">
      <div id="mobile-session-user" class="text-xs font-semibold text-white">Guest Visitor</div>
      <div id="mobile-session-sub" class="text-[11px] text-aura-sidebar-text">Tap to sign in or view account</div>
    </a>
  </div>
</div>

<script>
  import { getSupabaseClient } from '../lib/supabase/client';

  const mobileDrawer = document.getElementById('mobile-drawer');
  const btnCloseDrawer = document.getElementById('btn-close-drawer');

  if (mobileDrawer && btnCloseDrawer) {
    btnCloseDrawer.addEventListener('click', () => {
      mobileDrawer.classList.add('hidden');
    });

    mobileDrawer.addEventListener('click', (e) => {
      if (e.target === mobileDrawer) {
        mobileDrawer.classList.add('hidden');
      }
    });
  }

  // Dynamic session updater for sidebar
  const supabase = getSupabaseClient();
  if (supabase) {
    const updateSidebarUI = (user: any) => {
      const titleEl = document.getElementById('sidebar-session-title');
      const subEl = document.getElementById('sidebar-session-sub');
      const badgeEl = document.getElementById('sidebar-session-badge');
      const mobileUserEl = document.getElementById('mobile-session-user');
      const mobileSubEl = document.getElementById('mobile-session-sub');

      if (user) {
        const displayName = user.email ? user.email.split('@')[0] : 'Member';
        if (titleEl) titleEl.textContent = displayName;
        if (subEl) subEl.textContent = 'Authenticated Vault';
        if (badgeEl) {
          badgeEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Signed In';
        }
        if (mobileUserEl) mobileUserEl.textContent = user.email || 'Member';
        if (mobileSubEl) mobileSubEl.textContent = 'Authenticated Session';
      }
    };

    supabase.auth.getSession().then(({ data: { session } }) => {
      if (session?.user) updateSidebarUI(session.user);
    });

    supabase.auth.onAuthStateChange((_event, session) => {
      if (session?.user) updateSidebarUI(session.user);
    });
  }
</script>
