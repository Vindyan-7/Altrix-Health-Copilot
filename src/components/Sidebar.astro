---
import {
  LayoutDashboard,
  FileText,
  CheckSquare,
  Clock,
  MessageSquare,
  MapPin,
  X,
  Activity,
  UserCheck,
  User,
  LogOut,
  LogIn,
} from '@lucide/astro';

export interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;

const navItems = [
  {
    href: '/dashboard',
    label: 'Dashboard',
    icon: LayoutDashboard,
  },
  {
    href: '/copilot',
    label: 'Health Copilot',
    icon: MessageSquare,
  },
  {
    href: '/records',
    label: 'My Records',
    icon: FileText,
  },
  {
    href: '/review',
    label: 'Report Review',
    icon: CheckSquare,
  },
  {
    href: '/timeline',
    label: 'Health Timeline',
    icon: Clock,
  },
];

function isCurrent(href: string) {
  return activePath.startsWith(href);
}
---

<!-- Desktop Sidebar (Fixed Left Navigation Rail) -->
<aside
  class="hidden lg:flex flex-col w-[256px] shrink-0 bg-aura-sidebar text-aura-sidebar-text h-screen overflow-y-auto p-5 select-none"
  aria-label="Primary Navigation"
>
  <!-- Brand Header -->
  <div class="flex items-center gap-3 pt-1 pb-6 px-1 shrink-0">
    <div class="w-8 h-8 rounded-lg bg-aura-accent-orange/20 border border-aura-accent-orange/40 flex items-center justify-center text-aura-accent-orange shrink-0">
      <Activity class="w-4 h-4" stroke-width={2.2} />
    </div>
    <div class="flex flex-col">
      <span class="text-white font-serif font-bold text-lg leading-tight tracking-tight">Altrix Health</span>
      <span class="text-[9.5px] font-semibold text-aura-sidebar-text tracking-[0.16em] uppercase">Health Copilot</span>
    </div>
  </div>

  <!-- Primary Navigation items -->
  <nav class="space-y-1.5 flex-grow" aria-label="Main menu">
    <div class="px-3 pb-1 text-[10px] font-semibold tracking-wider text-aura-sidebar-text/70 uppercase">
      Dashboard Navigation
    </div>
    {navItems.map((item) => {
      const active = isCurrent(item.href);
      const IconComponent = item.icon;
      return (
        <a
          href={item.href}
          aria-current={active ? 'page' : undefined}
          class={`flex items-center justify-between px-3.5 py-2.5 rounded-full text-xs font-medium transition-all group focus:outline-none focus:ring-2 focus:ring-aura-sidebar-active ${
            active
              ? 'bg-aura-sidebar-active text-aura-text font-semibold shadow-xs'
              : 'text-aura-sidebar-text hover:text-white hover:bg-white/5'
          }`}
        >
          <div class="flex items-center gap-3">
            <IconComponent class="w-4 h-4 shrink-0" stroke-width={1.9} />
            <span>{item.label}</span>
          </div>

          {item.badge && (
            <span class={`text-[10px] px-2 py-0.5 rounded-full font-semibold ${
              active
                ? 'bg-aura-action text-white'
                : 'bg-aura-accent-orange/25 text-aura-accent-orange'
            }`}>
              {item.badge}
            </span>
          )}
        </a>
      );
    })}

    <!-- Secondary / Utilities Section -->
    <div class="pt-5 mt-5 border-t border-white/10 space-y-1">
      <div class="px-3 pb-1 text-[10px] font-semibold tracking-wider text-aura-sidebar-text/70 uppercase">
        Account & Services
      </div>
      <a
        href="/profile"
        class={`flex items-center gap-3 px-3.5 py-2 rounded-full text-xs transition ${
          isCurrent('/profile')
            ? 'bg-aura-sidebar-active text-aura-text font-semibold shadow-xs'
            : 'text-aura-sidebar-text hover:text-white hover:bg-white/5'
        }`}
      >
        <User class="w-4 h-4 shrink-0" stroke-width={1.8} />
        <span>My Profile</span>
      </a>
      <a
        href="/copilot"
        class="flex items-center gap-3 px-3.5 py-2 rounded-full text-xs text-aura-sidebar-text hover:text-white hover:bg-white/5 transition"
      >
        <MapPin class="w-4 h-4 shrink-0" stroke-width={1.8} />
        <span>Nearby Care (Coming Soon)</span>
      </a>
    </div>
  </nav>

  <!-- Bottom Session Card & Logout Section -->
  <div class="mt-auto pt-4 shrink-0 space-y-2">
    <!-- Session Card -->
    <a
      id="sidebar-session-link"
      href="/profile"
      class="bg-aura-sidebar-deep hover:bg-black/40 transition rounded-2xl p-3.5 border border-white/5 shadow-inner block group cursor-pointer"
      title="View Profile & Account Settings"
    >
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-[9.5px] font-semibold text-aura-sidebar-active tracking-wider uppercase">Identity</span>
        <span id="sidebar-session-badge" class="inline-flex items-center gap-1 text-[10px] text-aura-sidebar-text">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          Guest Mode
        </span>
      </div>
      <div class="flex items-center gap-2.5">
        <div id="sidebar-user-avatar" class="w-7 h-7 rounded-full bg-white/10 text-white font-bold text-[11px] flex items-center justify-center shrink-0 border border-white/10">
          GV
        </div>
        <div class="min-w-0 flex-1">
          <div id="sidebar-session-title" class="text-white text-xs font-semibold truncate group-hover:text-aura-sidebar-active transition">
            Guest Visitor
          </div>
          <div id="sidebar-session-sub" class="text-[10px] text-aura-sidebar-text leading-tight truncate">
            Explore Guided Copilot
          </div>
        </div>
      </div>
    </a>

    <!-- Working Sign Out button (visible when authenticated) -->
    <button
      id="btn-sidebar-signout"
      type="button"
      class="hidden w-full items-center justify-center gap-2 px-3.5 py-2 rounded-xl text-xs font-medium text-rose-300 hover:text-white hover:bg-rose-500/20 transition cursor-pointer border border-rose-500/20"
      title="Sign out of Altrix Health"
    >
      <LogOut class="w-3.5 h-3.5 shrink-0" />
      <span>Sign Out</span>
    </button>
  </div>
</aside>

<!-- Mobile Navigation Drawer Overlay (Hidden by default) -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-50 lg:hidden bg-aura-sidebar-deep/60 backdrop-blur-xs hidden transition-opacity"
  aria-modal="true"
  role="dialog"
  aria-label="Mobile Navigation"
>
  <div class="w-[280px] max-w-[85vw] h-full bg-aura-sidebar text-aura-sidebar-text p-5 flex flex-col shadow-2xl">
    <div class="flex items-center justify-between pb-6 border-b border-white/10">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-aura-accent-orange/20 border border-aura-accent-orange/40 flex items-center justify-center text-aura-accent-orange">
          <Activity class="w-4 h-4" stroke-width={2.2} />
        </div>
        <div>
          <div class="text-white font-serif font-bold text-base leading-tight">Altrix Health</div>
          <div class="text-[9px] font-semibold text-aura-sidebar-text tracking-widest uppercase">Health Copilot</div>
        </div>
      </div>
      <button
        id="btn-close-drawer"
        type="button"
        class="text-aura-sidebar-text hover:text-white p-1 rounded-lg focus:outline-none focus:ring-2 focus:ring-aura-sidebar-active"
        aria-label="Close navigation"
      >
        <X class="w-5 h-5" stroke-width={2} />
      </button>
    </div>

    <!-- Mobile Nav Links -->
    <nav class="py-4 space-y-1.5 flex-grow overflow-y-auto">
      {navItems.map((item) => {
        const active = isCurrent(item.href);
        const IconComponent = item.icon;
        return (
          <a
            href={item.href}
            class={`flex items-center justify-between px-3.5 py-3 rounded-full text-sm font-medium transition ${
              active
                ? 'bg-aura-sidebar-active text-aura-text font-semibold shadow-xs'
                : 'text-aura-sidebar-text hover:text-white hover:bg-white/5'
            }`}
          >
            <div class="flex items-center gap-3">
              <IconComponent class="w-4 h-4 shrink-0" stroke-width={1.9} />
              <span>{item.label}</span>
            </div>
          </a>
        );
      })}

      <div class="pt-3 mt-3 border-t border-white/10 space-y-1">
        <a
          href="/profile"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-full text-xs transition ${
            isCurrent('/profile')
              ? 'bg-aura-sidebar-active text-aura-text font-semibold shadow-xs'
              : 'text-aura-sidebar-text hover:text-white hover:bg-white/5'
          }`}
        >
          <User class="w-4 h-4 shrink-0" stroke-width={1.8} />
          <span>My Profile</span>
        </a>
      </div>
    </nav>

    <!-- Mobile Session Info & Logout -->
    <div class="mt-auto pt-3 border-t border-white/10 space-y-2">
      <a href="/profile" class="bg-aura-sidebar-deep rounded-xl p-3 border border-white/5 block">
        <div id="mobile-session-user" class="text-xs font-semibold text-white">Guest Visitor</div>
        <div id="mobile-session-sub" class="text-[11px] text-aura-sidebar-text">Tap to view profile or sign in</div>
      </a>
      <button
        id="btn-mobile-signout"
        type="button"
        class="hidden w-full items-center justify-center gap-2 px-3 py-2 rounded-xl text-xs font-medium text-rose-300 hover:text-white hover:bg-rose-500/20 transition cursor-pointer border border-rose-500/20"
      >
        <LogOut class="w-3.5 h-3.5 shrink-0" />
        <span>Sign Out</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { getSupabaseClient } from '../lib/supabase/client';
  import { signOutUser } from '../lib/supabase/auth';

  const mobileDrawer = document.getElementById('mobile-drawer');
  const btnCloseDrawer = document.getElementById('btn-close-drawer');

  if (mobileDrawer && btnCloseDrawer) {
    btnCloseDrawer.addEventListener('click', () => {
      mobileDrawer.classList.add('hidden');
    });

    mobileDrawer.addEventListener('click', (e) => {
      if (e.target === mobileDrawer) {
        mobileDrawer.classList.add('hidden');
      }
    });
  }

  // Helper to compute initials from full name or email
  function getInitials(name?: string, email?: string): string {
    if (name && name.trim()) {
      const parts = name.trim().split(/\s+/);
      if (parts.length >= 2) {
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
      }
      return parts[0].slice(0, 2).toUpperCase();
    }
    if (email) {
      return email.slice(0, 2).toUpperCase();
    }
    return 'GV';
  }

  // Dynamic session updater for sidebar
  const supabase = getSupabaseClient();
  const updateSidebarUI = (user: any) => {
    const titleEl = document.getElementById('sidebar-session-title');
    const subEl = document.getElementById('sidebar-session-sub');
    const badgeEl = document.getElementById('sidebar-session-badge');
    const avatarEl = document.getElementById('sidebar-user-avatar');
    const linkEl = document.getElementById('sidebar-session-link') as HTMLAnchorElement | null;
    const btnSignOut = document.getElementById('btn-sidebar-signout');
    const btnMobileSignOut = document.getElementById('btn-mobile-signout');
    const mobileUserEl = document.getElementById('mobile-session-user');
    const mobileSubEl = document.getElementById('mobile-session-sub');

    if (user) {
      const fullName = user.user_metadata?.full_name?.trim();
      const displayName = fullName || (user.email ? user.email.split('@')[0] : 'Member');
      const initials = getInitials(fullName, user.email);

      if (titleEl) titleEl.textContent = displayName;
      if (subEl) subEl.textContent = user.email || 'Authenticated Vault';
      if (avatarEl) {
        avatarEl.textContent = initials;
        avatarEl.className = 'w-7 h-7 rounded-full bg-emerald-500/20 text-emerald-300 font-bold text-[11px] flex items-center justify-center shrink-0 border border-emerald-500/30';
      }
      if (badgeEl) {
        badgeEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Signed In';
      }
      if (linkEl) linkEl.href = '/profile';
      if (btnSignOut) {
        btnSignOut.classList.remove('hidden');
        btnSignOut.classList.add('flex');
      }
      if (btnMobileSignOut) {
        btnMobileSignOut.classList.remove('hidden');
        btnMobileSignOut.classList.add('flex');
      }
      if (mobileUserEl) mobileUserEl.textContent = displayName;
      if (mobileSubEl) mobileSubEl.textContent = 'Authenticated Session (Tap for Profile)';
    } else {
      if (titleEl) titleEl.textContent = 'Guest Visitor';
      if (subEl) subEl.textContent = 'Explore Guided Copilot';
      if (avatarEl) {
        avatarEl.textContent = 'GV';
        avatarEl.className = 'w-7 h-7 rounded-full bg-white/10 text-white font-bold text-[11px] flex items-center justify-center shrink-0 border border-white/10';
      }
      if (badgeEl) {
        badgeEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Guest Mode';
      }
      if (linkEl) linkEl.href = '/auth';
      if (btnSignOut) {
        btnSignOut.classList.add('hidden');
        btnSignOut.classList.remove('flex');
      }
      if (btnMobileSignOut) {
        btnMobileSignOut.classList.add('hidden');
        btnMobileSignOut.classList.remove('flex');
      }
      if (mobileUserEl) mobileUserEl.textContent = 'Guest Visitor';
      if (mobileSubEl) mobileSubEl.textContent = 'Tap to sign in or view account';
    }
  };

  // Sign out handlers
  const handleSignOut = async () => {
    await signOutUser();
    window.location.href = '/';
  };

  const btnSignOut = document.getElementById('btn-sidebar-signout');
  if (btnSignOut) {
    btnSignOut.addEventListener('click', handleSignOut);
  }

  const btnMobileSignOut = document.getElementById('btn-mobile-signout');
  if (btnMobileSignOut) {
    btnMobileSignOut.addEventListener('click', handleSignOut);
  }

  if (supabase) {
    supabase.auth.getSession().then(({ data: { session } }) => {
      updateSidebarUI(session?.user || null);
    });

    supabase.auth.onAuthStateChange((_event, session) => {
      updateSidebarUI(session?.user || null);
    });
  }
</script>
