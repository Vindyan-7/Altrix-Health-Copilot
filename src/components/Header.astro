---
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Dashboard' },
  { href: '/records', label: 'Medical Records' },
  { href: '/review', label: 'Report Review' },
  { href: '/timeline', label: 'Health Timeline' },
  { href: '/copilot', label: 'Guided Copilot' },
];

function isActive(href: string) {
  if (href === '/') {
    return pathname === '/' || pathname === '';
  }
  return pathname.startsWith(href);
}
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <!-- Logo & Brand -->
      <div class="flex items-center gap-3">
        <a
          href="/"
          class="flex items-center gap-2.5 text-slate-900 font-bold text-lg tracking-tight focus:outline-none focus:ring-2 focus:ring-sky-500 rounded-lg p-1"
        >
          <div class="w-9 h-9 rounded-lg bg-sky-600 text-white flex items-center justify-center shadow-sm">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              />
            </svg>
          </div>
          <span class="flex flex-col">
            <span class="leading-none text-slate-900 font-extrabold text-base sm:text-lg">Altrix Copilot</span>
            <span class="text-[11px] font-medium text-sky-700 tracking-normal">HacXLerate Prototype</span>
          </span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1" aria-label="Main Navigation">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-sky-500 ${
                active
                  ? 'bg-sky-50 text-sky-800 font-semibold border border-sky-100 shadow-xs'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right controls: Patient demo badge & Mobile menu button -->
      <div class="flex items-center gap-3">
        <a
          href="/review"
          class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 text-xs font-semibold rounded-lg bg-sky-50 text-sky-800 border border-sky-200 hover:bg-sky-100 transition"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Sample Patient: Priya Sharma (34F)</span>
        </a>

        <!-- Mobile hamburger toggle -->
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open mobile navigation menu"
          class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-sky-500"
        >
          <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile navigation drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-2 pb-4 space-y-1 shadow-md">
    <div class="py-2 px-3 mb-2 bg-sky-50 rounded-lg border border-sky-100">
      <div class="text-xs font-semibold text-sky-900">Current Synthetic Session</div>
      <div class="text-xs text-sky-700">Priya Sharma • Demo Adult Profile</div>
    </div>
    {navItems.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          aria-current={active ? 'page' : undefined}
          class={`block px-3 py-2.5 rounded-lg text-base font-medium ${
            active
              ? 'bg-sky-50 text-sky-800 font-semibold border-l-4 border-sky-600'
              : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900'
          }`}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
