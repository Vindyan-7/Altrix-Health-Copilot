---
import { Activity, Menu, X, ArrowRight, ShieldCheck, LogIn, UserPlus } from '@lucide/astro';

export interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;

const isHome = activePath === '/' || activePath === '';
const isCopilot = activePath.startsWith('/copilot');
const isAuth = activePath.startsWith('/auth');
---

<header class="w-full bg-aura-canvas/95 backdrop-blur-md border-b border-aura-border/60 sticky top-0 z-40 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
    <!-- Brand -->
    <a
      href="/"
      class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-aura-sidebar rounded-xl p-1"
      aria-label="Altrix Health Copilot Home"
    >
      <div class="w-9 h-9 rounded-xl bg-aura-sidebar text-white flex items-center justify-center shadow-2xs group-hover:bg-aura-sidebar-deep transition">
        <Activity class="w-5 h-5 text-aura-accent-orange" stroke-width={2.2} />
      </div>
      <div class="flex flex-col">
        <span class="font-serif font-bold text-lg sm:text-xl text-aura-text tracking-tight leading-tight">
          Altrix Health
        </span>
        <span class="text-[9.5px] font-semibold text-aura-text-muted tracking-[0.16em] uppercase">
          Health Copilot
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-2" aria-label="Public Navigation">
      <a
        href="/"
        aria-current={isHome ? 'page' : undefined}
        class={`px-4 py-2 rounded-full text-xs sm:text-sm font-medium transition ${
          isHome
            ? 'bg-aura-surface-cream text-aura-text font-bold shadow-2xs border border-black/5'
            : 'text-aura-text-muted hover:text-aura-text hover:bg-aura-surface-blush'
        }`}
      >
        Home
      </a>
      <a
        href="/copilot"
        aria-current={isCopilot ? 'page' : undefined}
        class={`px-4 py-2 rounded-full text-xs sm:text-sm font-medium transition flex items-center gap-1.5 ${
          isCopilot
            ? 'bg-aura-surface-cream text-aura-text font-bold shadow-2xs border border-black/5'
            : 'text-aura-text-muted hover:text-aura-text hover:bg-aura-surface-blush'
        }`}
      >
        <span>Health Copilot</span>
        <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-aura-surface-cream text-aura-text border border-black/5">
          40 Guides
        </span>
      </a>
    </nav>

    <!-- Desktop Auth Actions -->
    <div class="hidden md:flex items-center gap-2.5">
      <!-- State when signed out (default) -->
      <div id="public-nav-guest-actions" class="flex items-center gap-2.5">
        <a
          id="public-nav-login"
          href="/auth?mode=signin"
          class={`px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition border border-aura-border/80 hover:border-aura-text hover:bg-aura-surface-blush text-aura-text ${
            isAuth ? 'bg-aura-surface-blush' : 'bg-white'
          }`}
        >
          Log in
        </a>
        <a
          id="public-nav-signup"
          href="/auth?mode=signup"
          class="px-5 py-2 rounded-full bg-aura-action hover:bg-aura-action-hover text-white text-xs sm:text-sm font-semibold transition shadow-xs flex items-center gap-1.5"
        >
          <span>Create account</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- State when signed in (enhanced via client script) -->
      <div id="public-nav-auth-actions" class="hidden items-center gap-2.5">
        <a
          href="/dashboard"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-aura-surface-cream hover:bg-aura-surface-cream-light text-aura-text text-xs sm:text-sm font-semibold transition border border-black/5 shadow-2xs"
        >
          <ShieldCheck class="w-4 h-4 text-emerald-700" />
          <span>My Dashboard</span>
        </a>
        <a
          id="public-nav-user-chip"
          href="/auth"
          class="w-9 h-9 rounded-full bg-aura-accent-peach text-aura-text font-bold text-xs flex items-center justify-center border border-aura-border shadow-xs hover:border-aura-action transition"
          title="Account Settings"
        >
          AU
        </a>
      </div>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        id="btn-public-menu"
        type="button"
        class="p-2 rounded-xl bg-white border border-aura-border text-aura-text hover:bg-aura-surface-blush focus:outline-none focus:ring-2 focus:ring-aura-sidebar cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <Menu id="icon-menu-open" class="w-5 h-5" stroke-width={2} />
        <X id="icon-menu-close" class="w-5 h-5 hidden" stroke-width={2} />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Hidden by default) -->
  <div
    id="public-mobile-menu"
    class="md:hidden hidden bg-aura-canvas border-b border-aura-border px-4 py-4 space-y-3"
  >
    <nav class="flex flex-col space-y-1.5" aria-label="Mobile Navigation">
      <a
        href="/"
        class={`px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition ${
          isHome
            ? 'bg-aura-surface-cream text-aura-text font-bold'
            : 'text-aura-text hover:bg-aura-surface-blush'
        }`}
      >
        Home
      </a>
      <a
        href="/copilot"
        class={`px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition flex items-center justify-between ${
          isCopilot
            ? 'bg-aura-surface-cream text-aura-text font-bold'
            : 'text-aura-text hover:bg-aura-surface-blush'
        }`}
      >
        <span>Health Copilot</span>
        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-aura-surface-cream text-aura-text">
          Guest Mode
        </span>
      </a>
    </nav>

    <!-- Mobile Auth Links -->
    <div class="pt-3 border-t border-aura-border/60 flex flex-col gap-2">
      <div id="mobile-guest-actions" class="flex flex-col gap-2">
        <a
          href="/auth?mode=signin"
          class="w-full py-2.5 text-center rounded-xl bg-white border border-aura-border text-aura-text text-xs font-semibold hover:bg-aura-surface-blush transition"
        >
          Log in
        </a>
        <a
          href="/auth?mode=signup"
          class="w-full py-2.5 text-center rounded-xl bg-aura-action text-white text-xs font-semibold hover:bg-aura-action-hover transition shadow-xs"
        >
          Create account
        </a>
      </div>
      <div id="mobile-auth-actions" class="hidden flex-col gap-2">
        <a
          href="/dashboard"
          class="w-full py-2.5 text-center rounded-xl bg-aura-action text-white text-xs font-semibold hover:bg-aura-action-hover transition shadow-xs"
        >
          Go to Dashboard
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { getSupabaseClient } from '../lib/supabase/client';

  // Mobile menu toggle
  const btnMenu = document.getElementById('btn-public-menu');
  const menuContainer = document.getElementById('public-mobile-menu');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');

  if (btnMenu && menuContainer && iconOpen && iconClose) {
    btnMenu.addEventListener('click', () => {
      const isExpanded = menuContainer.classList.contains('hidden');
      if (isExpanded) {
        menuContainer.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        btnMenu.setAttribute('aria-expanded', 'true');
      } else {
        menuContainer.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        btnMenu.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Session listener to toggle authenticated workspace shortcuts
  const supabase = getSupabaseClient();
  if (supabase) {
    const updateNavUI = (user: any) => {
      const guestActions = document.getElementById('public-nav-guest-actions');
      const authActions = document.getElementById('public-nav-auth-actions');
      const userChip = document.getElementById('public-nav-user-chip');
      const mobileGuestActions = document.getElementById('mobile-guest-actions');
      const mobileAuthActions = document.getElementById('mobile-auth-actions');

      if (user) {
        if (guestActions) guestActions.classList.add('hidden');
        if (authActions) {
          authActions.classList.remove('hidden');
          authActions.classList.add('flex');
        }
        if (mobileGuestActions) mobileGuestActions.classList.add('hidden');
        if (mobileAuthActions) {
          mobileAuthActions.classList.remove('hidden');
          mobileAuthActions.classList.add('flex');
        }
        if (userChip) {
          userChip.textContent = user.email ? user.email.slice(0, 2).toUpperCase() : 'AU';
        }
      } else {
        if (guestActions) guestActions.classList.remove('hidden');
        if (authActions) {
          authActions.classList.add('hidden');
          authActions.classList.remove('flex');
        }
        if (mobileGuestActions) mobileGuestActions.classList.remove('hidden');
        if (mobileAuthActions) {
          mobileAuthActions.classList.add('hidden');
          mobileAuthActions.classList.remove('flex');
        }
      }
    };

    supabase.auth.getSession().then(({ data: { session } }) => {
      if (session?.user) updateNavUI(session.user);
    });

    supabase.auth.onAuthStateChange((_event, session) => {
      updateNavUI(session?.user || null);
    });
  }
</script>
