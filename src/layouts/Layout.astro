---
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import PublicNav from '../components/PublicNav.astro';

export interface Props {
  title: string;
  description?: string;
  subtext?: string;
  isWorkspace?: boolean;
  hideNav?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description = 'Altrix Health Copilot — Personal health records companion and guided health assistant.',
  subtext,
  isWorkspace: isWorkspaceProp,
  hideNav = false,
  hideFooter = false,
} = Astro.props;

const currentPath = Astro.url.pathname;

// Automatic layout determination: workspace paths use Sidebar + TopBar, public paths use PublicNav
const isWorkspacePath =
  currentPath.startsWith('/dashboard') ||
  currentPath.startsWith('/records') ||
  currentPath.startsWith('/timeline') ||
  currentPath.startsWith('/review') ||
  currentPath.startsWith('/profile');

const isWorkspace = isWorkspaceProp !== undefined ? isWorkspaceProp : isWorkspacePath;
---

<!doctype html>
<html lang="en" class="h-full bg-aura-canvas antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | Altrix Health Copilot</title>

    <!-- Google Fonts: DM Serif Display & DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=DM+Serif+Display:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-full bg-aura-canvas text-aura-text font-sans selection:bg-aura-accent-peach selection:text-aura-text flex flex-col">
    <!-- Accessible skip link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-aura-action focus:text-white focus:rounded-md focus:shadow-lg text-xs font-semibold"
    >
      Skip to main content
    </a>

    {isWorkspace ? (
      <!-- Workspace Layout: Left Navigation Rail (Fixed/Sticky) + Right Scrollable Column -->
      <div class="h-screen w-full flex overflow-hidden">
        <!-- Full-Height Fixed Left Navigation Rail -->
        <Sidebar activePath={currentPath} />

        <!-- Main Independently Scrollable Column -->
        <div class="flex-1 flex flex-col min-w-0 h-screen overflow-y-auto bg-aura-canvas">
          <!-- Top Utility Bar -->
          <TopBar />

          <!-- Main Viewport Content -->
          <main id="main-content" class="flex-grow min-w-0">
            <slot />
          </main>

          <!-- Footer -->
          <Footer />
        </div>
      </div>
    ) : (
      <!-- Public Website Layout: Responsive Public Navigation + Full-Width Main Viewport -->
      <div class="flex-grow flex flex-col min-w-0 w-full bg-aura-canvas">
        <!-- Public Top Navigation -->
        {!hideNav && <PublicNav activePath={currentPath} />}

        <!-- Main Viewport -->
        <main id="main-content" class="flex-grow min-w-0">
          <slot />
        </main>

        <!-- Footer -->
        {!hideFooter && <Footer />}
      </div>
    )}
    <!-- Global Tactile Navigation Loading Progress Bar -->
    <div
      id="global-page-progress"
      class="fixed top-0 left-0 right-0 h-[3px] z-[9999] pointer-events-none opacity-0 transition-opacity duration-150 overflow-hidden"
    >
      <div
        id="global-page-progress-bar"
        class="h-full bg-gradient-to-r from-aura-accent-orange via-aura-accent-peach to-aura-sidebar w-full -translate-x-full transition-transform duration-500 ease-out"
      ></div>
    </div>

    <script>
      // Instant tactile feedback on link navigation
      document.addEventListener('DOMContentLoaded', () => {
        const progressBar = document.getElementById('global-page-progress-bar');
        const progressContainer = document.getElementById('global-page-progress');

        document.querySelectorAll('a[href]').forEach((link) => {
          link.addEventListener('click', (e) => {
            const anchor = link as HTMLAnchorElement;
            const href = anchor.getAttribute('href');
            if (
              !href ||
              href.startsWith('#') ||
              href.startsWith('mailto:') ||
              href.startsWith('tel:') ||
              anchor.target === '_blank' ||
              e.metaKey ||
              e.ctrlKey ||
              e.shiftKey
            ) {
              return;
            }

            if (progressContainer && progressBar) {
              progressContainer.classList.remove('opacity-0');
              progressContainer.classList.add('opacity-100');
              progressBar.style.transform = 'translateX(-25%)';
            }
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;

    --color-sidebar: #381840;
    --color-sidebar-deep: #200028;
    --color-sidebar-text: #BCA5C2;
    --color-sidebar-active: #F0E0C0;

    --color-canvas: #FFF8FA;
    --color-surface: #FFFFFF;
    --color-surface-blush: #FFF5FA;
    --color-surface-cream: #F0E0C0;
    --color-surface-cream-light: #F8EEDC;

    --color-text: #28152D;
    --color-text-muted: #827783;
    --color-text-subtle: #A59AA5;

    --color-action: #300D05;
    --color-action-hover: #451A10;
    --color-accent-purple: #EEDCF3;
    --color-accent-purple-strong: #4A2054;
    --color-accent-peach: #F9D8C9;
    --color-accent-orange: #E9865D;
    --color-accent-pink: #FBE6F5;
    --color-success: #6F7860;
    --color-border: #F0E9EF;

    --font-ui: "DM Sans", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-display: "DM Serif Display", Georgia, serif;

    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-7: 32px;
    --space-8: 40px;

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-card: 17px;
    --radius-panel: 20px;
    --radius-pill: 999px;

    --shadow-card: 0 5px 18px rgba(47, 20, 45, 0.045);
    --shadow-float: 0 8px 24px rgba(47, 20, 45, 0.08);
  }

  body {
    font-family: var(--font-ui);
    color: var(--color-text);
    background-color: var(--color-canvas);
  }

  h1, h2, h3, .font-serif {
    font-family: var(--font-display);
  }

  /* Universal Shimmer / Skeleton Animation */
  @keyframes altrix-shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  .skeleton-shimmer {
    background: linear-gradient(
      90deg,
      rgba(240, 233, 239, 0.5) 25%,
      rgba(255, 248, 250, 0.95) 50%,
      rgba(240, 233, 239, 0.5) 75%
    );
    background-size: 200% 100%;
    animation: altrix-shimmer 1.5s infinite linear;
  }
</style>
