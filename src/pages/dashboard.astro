---
import {
  MessageSquare,
  Upload,
  Files,
  ArrowRight,
  ShieldCheck,
  LogOut,
  FolderPlus,
  Clock,
  CheckSquare,
  Lock,
} from '@lucide/astro';
import Layout from '../layouts/Layout.astro';

// Formatted current date
const formattedDate = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(new Date());
---

<Layout title="Dashboard" description="Your authenticated health dashboard and personal health vault.">
  <div class="px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8 max-w-7xl mx-auto">
    <!-- Authenticated View (Rendered when valid Supabase session is active) -->
    <div id="dashboard-auth-view" class="hidden space-y-6 sm:space-y-8">
      <!-- 1. Header Greeting -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-2 border-b border-aura-border/40">
        <div class="space-y-2 max-w-2xl">
          <div class="flex flex-wrap items-center gap-2 text-xs text-aura-text-muted">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-semibold border border-emerald-200 shadow-2xs">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              AUTHENTICATED DASHBOARD
            </span>
            <span class="hidden sm:inline">•</span>
            <span class="font-medium text-aura-text-muted">{formattedDate}</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-[40px] font-serif font-normal text-aura-text tracking-tight leading-[1.1]">
            Welcome, <em id="dashboard-user-greeting" class="italic font-normal">Member</em>
          </h1>

          <p class="text-xs sm:text-sm text-aura-text-muted leading-relaxed max-w-xl">
            This is your private health dashboard. All records and extraction parameters are tenant-isolated and protected by PostgreSQL Row Level Security.
          </p>
        </div>

        <!-- Account Actions (Right-aligned desktop) -->
        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href="/copilot"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-aura-surface-cream hover:bg-aura-surface-cream-light text-aura-text text-xs sm:text-sm font-semibold shadow-xs transition border border-black/5"
          >
            <MessageSquare class="w-4 h-4 text-aura-accent-orange" stroke-width={2} />
            <span>Open Health Copilot</span>
          </a>

          <a
            href="/records"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-aura-surface-cream hover:bg-aura-surface-cream-light text-aura-text text-xs sm:text-sm font-semibold transition border border-black/5"
            title="Upload health documents to your private vault"
          >
            <Upload class="w-4 h-4 text-aura-action" stroke-width={2} />
            <span>Upload Document</span>
          </a>

          <button
            id="btn-dashboard-signout"
            type="button"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-white hover:bg-rose-50 text-rose-700 border border-rose-200 text-xs font-semibold shadow-2xs transition cursor-pointer"
            title="Sign out of your session"
          >
            <LogOut class="w-3.5 h-3.5" />
            <span>Sign Out</span>
          </button>
        </div>
      </div>

      <!-- 2. Account Security & Identity Pill -->
      <div class="bg-white rounded-2xl p-4 sm:p-5 border border-aura-border shadow-aura-card flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-sm">
            <ShieldCheck class="w-5 h-5" />
          </div>
          <div>
            <div class="text-xs font-bold text-aura-text">Authenticated Account</div>
            <div id="dashboard-user-email" class="text-xs text-aura-text-muted font-mono">user@example.com</div>
          </div>
        </div>
        <div class="flex items-center gap-2 text-xs text-aura-text-muted">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Row Level Security Enforced (Only you can access this vault)</span>
        </div>
      </div>

      <!-- 3. Genuine Vault State & Documents List -->
      <div class="bg-aura-surface rounded-aura-panel p-6 border border-aura-border/40 shadow-aura-card space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-aura-border/40">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-aura-text-subtle">Personal Vault</div>
            <h2 class="text-xl font-serif font-normal text-aura-text mt-0.5">
              Your Stored Health Records
            </h2>
          </div>
          <span id="dashboard-records-count-badge" class="text-xs font-semibold px-3 py-1 rounded-full bg-aura-surface-cream text-aura-text border border-black/5 self-start sm:self-auto">
            Checking vault records...
          </span>
        </div>

        <!-- Dynamic Vault Content Container -->
        <div id="dashboard-vault-content" class="space-y-3">
          <div class="text-xs text-aura-text-muted p-6 text-center bg-aura-surface-cream/20 rounded-xl border border-aura-border/30">
            Loading your stored vault documents...
          </div>
        </div>
      </div>

      <!-- 4. Quick Navigation Grid to Workspace Sections -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
        <!-- Card 1: Health Copilot -->
        <a
          href="/copilot"
          class="bg-aura-surface hover:bg-aura-surface-blush rounded-aura-card p-5 shadow-aura-card border border-aura-border/40 flex flex-col justify-between min-h-[150px] space-y-3 group transition"
        >
          <div class="flex items-start justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-aura-text-subtle">Health Assistant</span>
            <div class="w-8 h-8 rounded-full bg-aura-accent-peach flex items-center justify-center text-aura-accent-orange">
              <MessageSquare class="w-4 h-4" />
            </div>
          </div>
          <div>
            <h3 class="font-serif font-normal text-aura-text text-lg group-hover:text-aura-action transition">Health Copilot</h3>
            <p class="text-[11px] text-aura-text-muted mt-0.5">40 guided scenarios & general AI assistant</p>
          </div>
          <div class="pt-2 border-t border-aura-border/40 flex items-center justify-between text-xs text-aura-action font-semibold">
            <span>Open Assistant</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </div>
        </a>

        <!-- Card 2: My Records -->
        <a
          href="/records"
          class="bg-aura-surface hover:bg-aura-surface-blush rounded-aura-card p-5 shadow-aura-card border border-aura-border/40 flex flex-col justify-between min-h-[150px] space-y-3 group transition"
        >
          <div class="flex items-start justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-aura-text-subtle">Stored Documents</span>
            <div class="w-8 h-8 rounded-full bg-aura-surface-cream flex items-center justify-center text-aura-text">
              <Files class="w-4 h-4" />
            </div>
          </div>
          <div>
            <h3 class="font-serif font-normal text-aura-text text-lg group-hover:text-aura-action transition">My Records</h3>
            <p class="text-[11px] text-aura-text-muted mt-0.5">View and organize stored health records</p>
          </div>
          <div class="pt-2 border-t border-aura-border/40 flex items-center justify-between text-xs text-aura-action font-semibold">
            <span>View Records</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </div>
        </a>

        <!-- Card 3: Report Review -->
        <a
          href="/review"
          class="bg-aura-surface hover:bg-aura-surface-blush rounded-aura-card p-5 shadow-aura-card border border-aura-border/40 flex flex-col justify-between min-h-[150px] space-y-3 group transition"
        >
          <div class="flex items-start justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-aura-text-subtle">Optical Check</span>
            <div class="w-8 h-8 rounded-full bg-amber-50 flex items-center justify-center text-amber-700">
              <CheckSquare class="w-4 h-4" />
            </div>
          </div>
          <div>
            <h3 class="font-serif font-normal text-aura-text text-lg group-hover:text-aura-action transition">Report Review</h3>
            <p class="text-[11px] text-aura-text-muted mt-0.5">Inspect parameters & optical confidence</p>
          </div>
          <div class="pt-2 border-t border-aura-border/40 flex items-center justify-between text-xs text-aura-action font-semibold">
            <span>Inspect Report</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </div>
        </a>

        <!-- Card 4: Health Timeline -->
        <a
          href="/timeline"
          class="bg-aura-surface hover:bg-aura-surface-blush rounded-aura-card p-5 shadow-aura-card border border-aura-border/40 flex flex-col justify-between min-h-[150px] space-y-3 group transition"
        >
          <div class="flex items-start justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-aura-text-subtle">History & Trends</span>
            <div class="w-8 h-8 rounded-full bg-aura-accent-pink flex items-center justify-center text-aura-sidebar">
              <Clock class="w-4 h-4" />
            </div>
          </div>
          <div>
            <h3 class="font-serif font-normal text-aura-text text-lg group-hover:text-aura-action transition">Health Timeline</h3>
            <p class="text-[11px] text-aura-text-muted mt-0.5">Longitudinal measurement trend history</p>
          </div>
          <div class="pt-2 border-t border-aura-border/40 flex items-center justify-between text-xs text-aura-action font-semibold">
            <span>View Timeline</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </div>
        </a>
      </div>
    </div>

    <!-- Unauthenticated Gate View (Rendered when no active session exists) -->
    <div id="dashboard-guest-view" class="max-w-2xl mx-auto py-12 space-y-8 text-center">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-aura-surface-cream text-aura-text flex items-center justify-center shadow-xs border border-black/5">
        <Lock class="w-8 h-8 text-aura-accent-orange" stroke-width={1.8} />
      </div>

      <div class="space-y-2">
        <h1 class="text-3xl font-serif font-normal text-aura-text">
          Sign In to Access Your Dashboard
        </h1>
        <p class="text-sm text-aura-text-muted leading-relaxed max-w-lg mx-auto">
          The Dashboard is your private health environment. Sign in with your Altrix account to access your stored documents, personal timeline, and private health vault.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href="/auth?returnTo=/dashboard"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-aura-action hover:bg-aura-action-hover text-white text-sm font-semibold shadow-xs transition"
        >
          <span>Sign In / Create Account</span>
          <ArrowRight class="w-4 h-4" />
        </a>

        <a
          href="/copilot"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-aura-surface-cream hover:bg-aura-surface-cream-light text-aura-text text-sm font-semibold border border-black/5 transition"
        >
          <MessageSquare class="w-4 h-4 text-aura-accent-orange" />
          <span>Try Health Copilot as Guest</span>
        </a>
      </div>

      <div class="p-4 rounded-2xl bg-aura-surface-blush border border-aura-border/60 text-xs text-aura-text-muted max-w-md mx-auto text-left flex items-start gap-3">
        <ShieldCheck class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
        <span>
          Guest mode is always available without an account. You can freely ask health questions, explore 40 clinical topics, and inspect sample lab reports.
        </span>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { getSupabaseClient, isSupabaseConfigured } from '../lib/supabase/client';
  import { signOutUser } from '../lib/supabase/auth';

  const authView = document.getElementById('dashboard-auth-view');
  const guestView = document.getElementById('dashboard-guest-view');
  const greetingEl = document.getElementById('dashboard-user-greeting');
  const emailEl = document.getElementById('dashboard-user-email');
  const vaultContentEl = document.getElementById('dashboard-vault-content');
  const countBadgeEl = document.getElementById('dashboard-records-count-badge');
  const btnSignOut = document.getElementById('btn-dashboard-signout');

  async function loadUserRecords(token: string) {
    if (!vaultContentEl || !countBadgeEl) return;
    try {
      const res = await fetch('/api/vault/documents', {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      if (!res.ok) {
        vaultContentEl.innerHTML = `
          <div class="text-xs text-rose-700 p-4 bg-rose-50 rounded-xl border border-rose-200">
            Failed to load vault records from server.
          </div>
        `;
        countBadgeEl.textContent = 'Error loading records';
        return;
      }

      const data = await res.json();
      const docs = data.documents || [];

      countBadgeEl.textContent = `${docs.length} ${docs.length === 1 ? 'Record' : 'Records'} in Vault`;

      if (docs.length === 0) {
        vaultContentEl.innerHTML = `
          <div class="p-8 text-center bg-aura-surface-cream/20 rounded-2xl border border-aura-border/40 space-y-3">
            <div class="w-12 h-12 mx-auto rounded-full bg-aura-surface-cream flex items-center justify-center text-aura-text-muted">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <div class="space-y-1">
              <h3 class="text-base font-serif font-normal text-aura-text">Your Health Vault is Empty</h3>
              <p class="text-xs text-aura-text-muted max-w-md mx-auto leading-relaxed">
                No medical records stored yet. Direct document uploads with OCR extraction are in development for an upcoming release.
              </p>
            </div>
            <div class="pt-2">
              <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-aura-surface-cream text-aura-text-muted text-xs font-semibold border border-black/5">
                <span>Document Uploads Coming Soon</span>
              </span>
            </div>
          </div>
        `;
      } else {
        vaultContentEl.innerHTML = `
          <div class="divide-y divide-aura-border/40">
            ${docs.map((doc: any) => `
              <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="space-y-0.5">
                  <div class="text-xs font-bold text-aura-text flex items-center gap-2">
                    <span>${doc.original_filename_sanitized || 'Document'}</span>
                    <span class="text-[10px] px-2 py-0.5 rounded-full font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                      Stored
                    </span>
                  </div>
                  <div class="text-[11px] text-aura-text-muted">
                    ${doc.source_facility || 'Clinical Facility'} • ${doc.document_date || new Date(doc.created_at).toLocaleDateString()}
                  </div>
                </div>
                <a
                  href="/review"
                  class="text-xs font-semibold px-3 py-1.5 rounded-full bg-aura-surface-cream hover:bg-aura-surface-cream-light text-aura-text transition border border-black/5 self-start sm:self-auto"
                >
                  Review Details →
                </a>
              </div>
            `).join('')}
          </div>
        `;
      }
    } catch {
      vaultContentEl.innerHTML = `
        <div class="text-xs text-rose-700 p-4 bg-rose-50 rounded-xl border border-rose-200">
          Network error loading vault documents.
        </div>
      `;
      countBadgeEl.textContent = 'Network error';
    }
  }

  async function checkSession() {
    const supabase = getSupabaseClient();
    if (!supabase || !isSupabaseConfigured) {
      if (guestView) guestView.classList.remove('hidden');
      if (authView) authView.classList.add('hidden');
      return;
    }

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session?.user && session?.access_token) {
        if (guestView) guestView.classList.add('hidden');
        if (authView) authView.classList.remove('hidden');

        const fullName = session.user.user_metadata?.full_name?.trim();
        const email = session.user.email || 'Member';
        const displayName = fullName || email.split('@')[0];
        if (greetingEl) greetingEl.textContent = displayName;
        if (emailEl) emailEl.textContent = email;

        await loadUserRecords(session.access_token);
      } else {
        if (guestView) guestView.classList.remove('hidden');
        if (authView) authView.classList.add('hidden');
      }
    } catch {
      if (guestView) guestView.classList.remove('hidden');
      if (authView) authView.classList.add('hidden');
    }
  }

  checkSession();

  const supabaseClient = getSupabaseClient();
  if (supabaseClient) {
    supabaseClient.auth.onAuthStateChange(async (_event, session) => {
      if (session?.user && session?.access_token) {
        if (guestView) guestView.classList.add('hidden');
        if (authView) authView.classList.remove('hidden');
        const fullName = session.user.user_metadata?.full_name?.trim();
        const email = session.user.email || 'Member';
        const displayName = fullName || email.split('@')[0];
        if (greetingEl) greetingEl.textContent = displayName;
        if (emailEl) emailEl.textContent = email;
        await loadUserRecords(session.access_token);
      } else {
        if (guestView) guestView.classList.remove('hidden');
        if (authView) authView.classList.add('hidden');
      }
    });
  }

  if (btnSignOut) {
    btnSignOut.addEventListener('click', async () => {
      btnSignOut.textContent = 'Signing out...';
      await signOutUser();
      window.location.href = '/';
    });
  }
</script>
