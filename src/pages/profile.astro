---
import Layout from '../layouts/Layout.astro';
import {
  User,
  Mail,
  Languages,
  ShieldCheck,
  Save,
  CheckCircle2,
  AlertTriangle,
  Lock,
  ArrowRight,
  LogOut,
  Calendar,
  KeyRound,
} from '@lucide/astro';

// Format current date
const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(new Date());
---

<Layout
  title="My Profile"
  description="Manage your account profile, full name, and preferred language."
  isWorkspace={true}
>
  <div class="px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8 max-w-4xl mx-auto">
    <!-- Unauthenticated / Guest Prompt (Hidden by default, shown if no active session) -->
    <div
      id="profile-guest-card"
      class="hidden rounded-3xl bg-white border border-aura-border shadow-aura-card p-6 sm:p-10 text-center space-y-5"
    >
      <div class="w-14 h-14 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center mx-auto border border-amber-500/20">
        <Lock class="w-7 h-7" stroke-width={1.8} />
      </div>

      <div class="space-y-2 max-w-md mx-auto">
        <h1 class="text-2xl font-serif font-bold text-aura-text">Account Authentication Required</h1>
        <p class="text-xs sm:text-sm text-aura-text-muted leading-relaxed">
          Your profile and personal preferences are protected by encrypted vault isolation. Please sign in or create an account to view and update your profile.
        </p>
      </div>

      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/auth?mode=signin&returnTo=/profile"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full bg-aura-action text-white text-xs font-semibold hover:bg-black transition shadow-xs"
        >
          <span>Sign In to Your Vault</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
        <a
          href="/auth?mode=signup&returnTo=/profile"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full bg-white border border-aura-border text-aura-text text-xs font-semibold hover:bg-aura-surface-blush transition"
        >
          <span>Create Account</span>
        </a>
      </div>
    </div>

    <!-- Authenticated Profile View (Rendered when valid Supabase session is active) -->
    <div id="profile-auth-view" class="space-y-6">
      <!-- Breadcrumb & Header -->
      <div class="space-y-2 pb-4 border-b border-aura-border/40">
        <div class="flex items-center gap-2 text-[11px] text-aura-text-muted">
          <a href="/dashboard" class="hover:text-aura-action transition">Dashboard</a>
          <span>/</span>
          <span class="font-semibold text-aura-text">My Profile</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl sm:text-3xl font-serif font-bold text-aura-text tracking-tight">
              Account Profile
            </h1>
            <p class="text-xs sm:text-sm text-aura-text-muted mt-1 leading-relaxed">
              Manage your personal identity, contact details, and bilingual language preferences.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-semibold border border-emerald-200 shadow-2xs">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              VERIFIED SESSION
            </span>
          </div>
        </div>
      </div>

      <!-- Incomplete Profile Prompt (Banner if full_name is missing) -->
      <div
        id="profile-incomplete-banner"
        class="hidden rounded-2xl bg-amber-50 border border-amber-200/80 p-4 text-xs text-amber-900 flex items-start gap-3 shadow-2xs"
        role="alert"
      >
        <AlertTriangle class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" />
        <div class="space-y-1">
          <p class="font-bold">Your profile is missing your name.</p>
          <p class="text-amber-800 text-[11px] leading-relaxed">
            Please enter your full name below and click <strong>Save Changes</strong> so your health workspace and reports reflect your identity.
          </p>
        </div>
      </div>

      <!-- Status Alert Box (Live Feedback) -->
      <div
        id="profile-status-alert"
        class="hidden rounded-2xl p-4 text-xs flex items-start gap-3 transition-all"
        role="alert"
        aria-live="polite"
      >
        <div id="profile-status-icon" class="shrink-0 mt-0.5"></div>
        <div id="profile-status-text" class="flex-grow text-xs leading-relaxed"></div>
      </div>

      <!-- Profile Form & Security Overview Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Form Column (Left 2 cols) -->
        <div class="lg:col-span-2 space-y-6">
          <form id="profile-form" class="rounded-3xl bg-white border border-aura-border shadow-aura-card p-6 sm:p-8 space-y-6">
            <!-- Full Name Field (Editable, Required) -->
            <div>
              <label for="profile-fullname" class="block text-xs font-bold text-aura-text mb-1.5">
                Full Name <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <input
                  id="profile-fullname"
                  name="full_name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="e.g. Dr. Sree / Alex Morgan"
                  class="w-full h-11 px-3.5 rounded-xl border border-aura-border bg-white text-xs text-aura-text focus:outline-none focus:ring-2 focus:ring-aura-action transition placeholder:text-aura-text-subtle"
                />
              </div>
              <p class="text-[11px] text-aura-text-muted mt-1.5">
                Displayed in your dashboard greeting, top utility bar, and workspace navigation.
              </p>
            </div>

            <!-- Email Address Field (Read-only) -->
            <div>
              <label for="profile-email" class="block text-xs font-bold text-aura-text mb-1.5">
                Email Address <span class="text-aura-text-muted font-normal">(Primary Login)</span>
              </label>
              <div class="relative">
                <input
                  id="profile-email"
                  name="email"
                  type="email"
                  readonly
                  disabled
                  class="w-full h-11 px-3.5 rounded-xl border border-aura-border/80 bg-aura-surface-blush/60 text-xs text-aura-text-muted cursor-not-allowed font-mono"
                />
              </div>
              <p class="text-[11px] text-aura-text-muted mt-1.5">
                Managed via Supabase Auth. Email changes require security verification.
              </p>
            </div>

            <!-- Preferred Language Field (Editable) -->
            <div>
              <label for="profile-language" class="block text-xs font-bold text-aura-text mb-1.5">
                Preferred Language
              </label>
              <div class="relative">
                <select
                  id="profile-language"
                  name="preferred_language"
                  class="w-full h-11 px-3.5 rounded-xl border border-aura-border bg-white text-xs text-aura-text focus:outline-none focus:ring-2 focus:ring-aura-action transition cursor-pointer"
                >
                  <option value="en">English (Default)</option>
                  <option value="te">తెలుగు (Telugu)</option>
                </select>
              </div>
              <p class="text-[11px] text-aura-text-muted mt-1.5">
                Sets default bilingual explanation responses in Health Copilot scenarios.
              </p>
            </div>

            <!-- Save Button Row -->
            <div class="pt-4 border-t border-aura-border/40 flex items-center justify-between">
              <span class="text-[11px] text-aura-text-muted">
                Last checked: <span class="font-medium text-aura-text">{formattedDate}</span>
              </span>

              <button
                id="btn-save-profile"
                type="submit"
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-aura-action hover:bg-aura-action-hover text-white text-xs font-semibold transition shadow-xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-aura-sidebar"
              >
                <Save class="w-3.5 h-3.5" />
                <span>Save Changes</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Side Card Column (Right 1 col): Account Identity & Security -->
        <div class="space-y-6">
          <!-- Identity Summary Card -->
          <div class="rounded-3xl bg-white border border-aura-border shadow-aura-card p-6 space-y-4">
            <div class="flex items-center gap-3 pb-3 border-b border-aura-border/40">
              <div id="profile-avatar-display" class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-800 font-bold text-sm flex items-center justify-center border border-emerald-300 shadow-2xs shrink-0">
                AU
              </div>
              <div class="min-w-0 flex-1">
                <div id="profile-name-display" class="text-sm font-bold text-aura-text truncate">
                  Authenticated User
                </div>
                <div id="profile-role-display" class="text-[11px] text-aura-text-muted truncate">
                  Vault Member
                </div>
              </div>
            </div>

            <div class="space-y-2.5 text-xs text-aura-text">
              <div class="flex items-center justify-between text-[11px]">
                <span class="text-aura-text-muted">User ID:</span>
                <span id="profile-uid-display" class="font-mono text-[10px] text-aura-text truncate max-w-[150px]"></span>
              </div>
              <div class="flex items-center justify-between text-[11px]">
                <span class="text-aura-text-muted">Security:</span>
                <span class="font-semibold text-emerald-700">PostgreSQL RLS Active</span>
              </div>
              <div class="flex items-center justify-between text-[11px]">
                <span class="text-aura-text-muted">Tenant Isolation:</span>
                <span class="font-medium">Strict (User-Scoped)</span>
              </div>
            </div>

            <div class="pt-2">
              <button
                id="btn-profile-signout"
                type="button"
                class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-white border border-rose-200 text-rose-600 hover:bg-rose-50 text-xs font-semibold transition cursor-pointer"
              >
                <LogOut class="w-3.5 h-3.5" />
                <span>Sign Out</span>
              </button>
            </div>
          </div>

          <!-- Privacy & Data Governance Card -->
          <div class="rounded-3xl bg-aura-surface-cream/50 border border-aura-border/60 p-6 space-y-3">
            <div class="flex items-center gap-2 text-aura-text">
              <ShieldCheck class="w-4 h-4 text-emerald-600" />
              <h2 class="text-xs font-bold">Privacy & Data Governance</h2>
            </div>
            <p class="text-[11px] text-aura-text-muted leading-relaxed">
              Your profile data and health records are protected with tenant-isolated database policies. Zero protected health information is transmitted to third-party ad networks or shared with other accounts.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { getSupabaseClient, isSupabaseConfigured } from '../lib/supabase/client';
  import { updateUserProfile, signOutUser } from '../lib/supabase/auth';

  const guestCard = document.getElementById('profile-guest-card');
  const authView = document.getElementById('profile-auth-view');
  const incompleteBanner = document.getElementById('profile-incomplete-banner');
  const statusAlert = document.getElementById('profile-status-alert');
  const statusIcon = document.getElementById('profile-status-icon');
  const statusText = document.getElementById('profile-status-text');

  const inputFullName = document.getElementById('profile-fullname') as HTMLInputElement | null;
  const inputEmail = document.getElementById('profile-email') as HTMLInputElement | null;
  const selectLanguage = document.getElementById('profile-language') as HTMLSelectElement | null;
  const profileForm = document.getElementById('profile-form') as HTMLFormElement | null;
  const btnSave = document.getElementById('btn-save-profile') as HTMLButtonElement | null;
  const btnSignOut = document.getElementById('btn-profile-signout');

  const avatarDisplay = document.getElementById('profile-avatar-display');
  const nameDisplay = document.getElementById('profile-name-display');
  const roleDisplay = document.getElementById('profile-role-display');
  const uidDisplay = document.getElementById('profile-uid-display');

  function showAlert(msg: string, isError: boolean) {
    if (!statusAlert || !statusIcon || !statusText) return;
    statusAlert.classList.remove('hidden', 'bg-rose-50', 'border-rose-200', 'text-rose-900', 'bg-emerald-50', 'border-emerald-200', 'text-emerald-900');
    if (isError) {
      statusAlert.classList.add('bg-rose-50', 'border', 'border-rose-200', 'text-rose-900');
      statusIcon.innerHTML = '<svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-width="2"/><line x1="12" y1="8" x2="12" y2="12" stroke-width="2"/><line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2"/></svg>';
    } else {
      statusAlert.classList.add('bg-emerald-50', 'border', 'border-emerald-200', 'text-emerald-900');
      statusIcon.innerHTML = '<svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
    }
    statusText.textContent = msg;
    statusAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideAlert() {
    statusAlert?.classList.add('hidden');
  }

  function getInitials(name?: string, email?: string): string {
    if (name && name.trim()) {
      const parts = name.trim().split(/\s+/);
      if (parts.length >= 2) {
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
      }
      return parts[0].slice(0, 2).toUpperCase();
    }
    if (email) {
      return email.slice(0, 2).toUpperCase();
    }
    return 'AU';
  }

  function populateUserProfile(user: any) {
    if (!user) {
      if (guestCard) guestCard.classList.remove('hidden');
      if (authView) authView.classList.add('hidden');
      return;
    }

    if (guestCard) guestCard.classList.add('hidden');
    if (authView) authView.classList.remove('hidden');

    const fullName = user.user_metadata?.full_name || '';
    const email = user.email || '';
    const preferredLanguage = user.user_metadata?.preferred_language || 'en';

    if (inputFullName) inputFullName.value = fullName;
    if (inputEmail) inputEmail.value = email;
    if (selectLanguage) selectLanguage.value = preferredLanguage;

    const displayName = fullName.trim() || email.split('@')[0] || 'Member';
    const initials = getInitials(fullName, email);

    if (nameDisplay) nameDisplay.textContent = displayName;
    if (roleDisplay) roleDisplay.textContent = email;
    if (avatarDisplay) avatarDisplay.textContent = initials;
    if (uidDisplay) uidDisplay.textContent = user.id;

    if (!fullName.trim() && incompleteBanner) {
      incompleteBanner.classList.remove('hidden');
    } else if (incompleteBanner) {
      incompleteBanner.classList.add('hidden');
    }
  }

  async function loadProfile() {
    const supabase = getSupabaseClient();
    if (!supabase || !isSupabaseConfigured) {
      if (guestCard) guestCard.classList.remove('hidden');
      if (authView) authView.classList.add('hidden');
      return;
    }

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) {
        if (guestCard) guestCard.classList.remove('hidden');
        if (authView) authView.classList.add('hidden');
        return;
      }

      populateUserProfile(session.user);

      // Also try fetching from public.profiles table if available
      try {
        const { data: profileRow } = await supabase
          .from('profiles')
          .select('*')
          .eq('id', session.user.id)
          .maybeSingle();

        if (profileRow) {
          if (profileRow.full_name && inputFullName && !inputFullName.value) {
            inputFullName.value = profileRow.full_name;
            if (nameDisplay) nameDisplay.textContent = profileRow.full_name;
            if (avatarDisplay) avatarDisplay.textContent = getInitials(profileRow.full_name, session.user.email);
            incompleteBanner?.classList.add('hidden');
          }
          if (profileRow.preferred_language && selectLanguage) {
            selectLanguage.value = profileRow.preferred_language;
          }
        }
      } catch {
        // Fallback to user_metadata is already active
      }
    } catch {
      if (guestCard) guestCard.classList.remove('hidden');
      if (authView) authView.classList.add('hidden');
    }
  }

  loadProfile();

  // Handle Profile Update Form Submission
  if (profileForm) {
    profileForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert();

      const fullName = inputFullName?.value?.trim() || '';
      const preferredLanguage = (selectLanguage?.value || 'en') as 'en' | 'te';

      if (!fullName) {
        showAlert('Please enter your full name.', true);
        return;
      }

      if (fullName.length < 2) {
        showAlert('Full name must be at least 2 characters long.', true);
        return;
      }

      if (btnSave) {
        btnSave.disabled = true;
        btnSave.textContent = 'Saving...';
      }

      const result = await updateUserProfile({
        fullName,
        preferredLanguage,
      });

      if (btnSave) {
        btnSave.disabled = false;
        btnSave.textContent = 'Save Changes';
      }

      if (result.error) {
        showAlert(result.error.message, true);
      } else {
        showAlert('Profile updated successfully! Your identity has been saved.', false);
        if (nameDisplay) nameDisplay.textContent = fullName;
        if (avatarDisplay) avatarDisplay.textContent = getInitials(fullName, inputEmail?.value);
        incompleteBanner?.classList.add('hidden');

        // Broadcast profile update locally
        const topbarName = document.getElementById('topbar-user-name');
        const topbarAvatar = document.getElementById('topbar-user-avatar');
        const sidebarTitle = document.getElementById('sidebar-session-title');
        const sidebarAvatar = document.getElementById('sidebar-user-avatar');

        if (topbarName) topbarName.textContent = fullName;
        if (topbarAvatar) topbarAvatar.textContent = getInitials(fullName, inputEmail?.value);
        if (sidebarTitle) sidebarTitle.textContent = fullName;
        if (sidebarAvatar) sidebarAvatar.textContent = getInitials(fullName, inputEmail?.value);
      }
    });
  }

  // Handle Sign Out from Profile Page
  if (btnSignOut) {
    btnSignOut.addEventListener('click', async () => {
      btnSignOut.textContent = 'Signing out...';
      await signOutUser();
      window.location.href = '/';
    });
  }
</script>
