---
import {
  FileUp,
  UploadCloud,
  Lock,
  AlertCircle,
  FlaskConical,
  Pill,
  Activity,
  ArrowRight,
  ShieldCheck,
  FileText,
  Database,
  Upload,
  CheckCircle2,
  Download,
  AlertTriangle,
} from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Medical Records" subtext="Private Health Vault">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8">
    <!-- 1. Page Header & Session Context -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-2 border-b border-aura-border/30">
      <div class="space-y-2 max-w-3xl">
        <div class="flex flex-wrap items-center gap-2 text-xs text-aura-text-muted">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-aura-surface-cream text-aura-text text-[11px] font-semibold border border-black/5 shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-aura-accent-orange"></span>
            HEALTH VAULT
          </span>
          <span class="hidden sm:inline">•</span>
          <span class="font-medium text-aura-text">Private Medical Records</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-serif font-normal text-aura-text tracking-tight">
          Medical Records Vault
        </h1>
        <p class="text-xs sm:text-sm text-aura-text-muted leading-relaxed max-w-2xl">
          Manage your laboratory reports, clinical prescriptions, and diagnostic summaries.
          Stored records are tenant-isolated and protected by PostgreSQL Row Level Security.
        </p>
      </div>

      <!-- Header status pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-aura-surface border border-aura-border/60 text-xs text-aura-text shrink-0 shadow-2xs self-start md:self-auto">
        <ShieldCheck class="w-4 h-4 text-emerald-600" stroke-width={2} />
        <span class="font-medium">Client Isolation Active</span>
      </div>
    </div>

    <!-- 2. Supabase Private Vault Records (Protected Cloud Workflow) -->
    <div id="cloud-vault-section" class="bg-white rounded-aura-panel border border-aura-border shadow-aura-card p-6 sm:p-7 space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-aura-border/40">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-800">
            <Database class="w-4 h-4" stroke-width={2} />
          </div>
          <div>
            <h2 class="text-base font-serif font-normal text-aura-text">
              Private Cloud Vault (Supabase RLS)
            </h2>
            <p class="text-xs text-aura-text-muted">
              PostgreSQL Row Level Security ensures only your authenticated user ID can read or insert your records.
            </p>
          </div>
        </div>

        <div id="vault-status-chip" class="self-start sm:self-auto">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-aura-surface-cream text-aura-text border border-black/5">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            Guest Mode (Unauthenticated)
          </span>
        </div>
      </div>

      <!-- Authenticated Vault View (Hidden when guest) -->
      <div id="vault-auth-view" class="hidden space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-xl bg-aura-surface-blush border border-aura-border/60">
          <div class="text-xs space-y-0.5">
            <div class="font-bold text-aura-text">Active Cloud Session:</div>
            <div id="vault-user-email" class="text-aura-text-muted font-mono text-[11px]">user@example.com</div>
          </div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-800 text-xs font-semibold border border-emerald-200">
            <ShieldCheck class="w-3.5 h-3.5 text-emerald-600" />
            <span>PostgreSQL RLS Active</span>
          </div>
        </div>

        <!-- Alert box for success / error messages -->
        <div id="vault-alert" class="hidden rounded-xl p-3 text-xs flex items-start gap-2"></div>

        <!-- Live Document Table / List -->
        <div class="space-y-2">
          <h3 class="text-xs font-bold text-aura-text uppercase tracking-wider">
            Your Stored Vault Documents
          </h3>
          <div id="vault-documents-list" class="space-y-2.5">
            <div class="p-3.5 rounded-xl border border-aura-border/60 bg-white/70 flex items-center justify-between gap-3">
              <div class="flex items-center gap-3 flex-1 min-w-0">
                <div class="w-8 h-8 rounded-lg skeleton-shimmer shrink-0"></div>
                <div class="space-y-1.5 flex-1 min-w-0">
                  <div class="h-3.5 w-48 rounded-md skeleton-shimmer"></div>
                  <div class="h-2.5 w-32 rounded-md skeleton-shimmer"></div>
                </div>
              </div>
              <div class="h-6 w-20 rounded-full skeleton-shimmer shrink-0"></div>
            </div>
            <div class="p-3.5 rounded-xl border border-aura-border/60 bg-white/70 flex items-center justify-between gap-3">
              <div class="flex items-center gap-3 flex-1 min-w-0">
                <div class="w-8 h-8 rounded-lg skeleton-shimmer shrink-0"></div>
                <div class="space-y-1.5 flex-1 min-w-0">
                  <div class="h-3.5 w-40 rounded-md skeleton-shimmer"></div>
                  <div class="h-2.5 w-28 rounded-md skeleton-shimmer"></div>
                </div>
              </div>
              <div class="h-6 w-20 rounded-full skeleton-shimmer shrink-0"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Unauthenticated Guest View (Shown by default) -->
      <div id="vault-guest-view" class="p-4 sm:p-5 rounded-xl bg-aura-surface-cream/40 border border-aura-border/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1 text-xs">
          <p class="font-bold text-aura-text">Want to test private document storage & multi-user isolation?</p>
          <p class="text-aura-text-muted text-[11px]">
            Sign in with an Altrix account to access your private Supabase vault and verify that other users cannot access your records.
          </p>
        </div>
        <a
          href="/auth"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-aura-action text-white text-xs font-semibold hover:bg-black transition shadow-xs shrink-0"
        >
          <span>Sign In / Create Account</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <!-- 3. Document Intake & Upload Panel -->
    <div class="bg-aura-surface rounded-aura-panel border border-aura-border/40 shadow-aura-card p-6 sm:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-aura-border/30">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-aura-accent-peach/40 flex items-center justify-center text-aura-accent-orange">
            <UploadCloud class="w-4 h-4" stroke-width={2} />
          </div>
          <div>
            <h2 class="text-base font-serif font-normal text-aura-text">
              Upload Health Document
            </h2>
            <p class="text-xs text-aura-text-muted">
              Securely ingest medical records into your private, tenant-isolated Supabase vault
            </p>
          </div>
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
          <ShieldCheck class="w-3.5 h-3.5 text-emerald-600" />
          <span>Private Vault Storage Active</span>
        </div>
      </div>

      <!-- Live Upload Form (Available for authenticated users) -->
      <div id="upload-container" class="space-y-4">
        <!-- Document Category Selector -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="upload-doc-type" class="block text-xs font-bold text-aura-text mb-1.5">
              Document Category
            </label>
            <select
              id="upload-doc-type"
              class="w-full h-10 px-3 rounded-xl border border-aura-border bg-white text-xs text-aura-text focus:outline-none focus:ring-2 focus:ring-aura-action transition cursor-pointer"
            >
              <option value="lab_report">Laboratory Panel / Blood Test (e.g. CBC, Lipid, Metabolic)</option>
              <option value="prescription">Clinical Prescription (Rx)</option>
              <option value="diagnostic_report">Diagnostic / Imaging Report (Ultrasound, MRI, CT)</option>
              <option value="discharge_summary">Hospital Discharge Summary</option>
              <option value="wellness_log">Home Wellness Log (BP, Blood Sugar)</option>
              <option value="other">Other Clinical Document</option>
            </select>
          </div>

          <div>
            <label for="upload-source-facility" class="block text-xs font-bold text-aura-text mb-1.5">
              Facility / Hospital Name <span class="text-aura-text-muted font-normal">(Optional)</span>
            </label>
            <input
              id="upload-source-facility"
              type="text"
              placeholder="e.g. Apollo Diagnostics, Care Hospital"
              class="w-full h-10 px-3.5 rounded-xl border border-aura-border bg-white text-xs text-aura-text focus:outline-none focus:ring-2 focus:ring-aura-action transition placeholder:text-aura-text-subtle"
            />
          </div>
        </div>

        <!-- Drag & Drop Zone -->
        <div
          id="dropzone"
          class="border-2 border-dashed border-aura-border/80 hover:border-aura-accent-orange/60 transition rounded-2xl p-6 sm:p-8 text-center bg-white/70 space-y-3 cursor-pointer group"
        >
          <input
            id="file-input"
            type="file"
            accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg"
            class="hidden"
          />

          <div class="w-12 h-12 mx-auto rounded-2xl bg-aura-surface-cream text-aura-accent-orange flex items-center justify-center shadow-2xs border border-black/5 group-hover:scale-105 transition">
            <Upload class="w-6 h-6" stroke-width={2} />
          </div>

          <div class="space-y-1">
            <p class="text-xs sm:text-sm font-semibold text-aura-text">
              <span class="text-aura-action underline">Click to choose a file</span> or drag and drop here
            </p>
            <p class="text-[11px] text-aura-text-muted">
              PDF, PNG, or JPEG • Maximum 10 MB per file
            </p>
          </div>

          <!-- Selected File Indicator (hidden by default) -->
          <div id="selected-file-pill" class="hidden inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-aura-surface-blush text-aura-text text-xs border border-aura-border">
            <FileText class="w-3.5 h-3.5 text-aura-action" />
            <span id="selected-file-name" class="font-medium truncate max-w-[200px]"></span>
            <span id="selected-file-size" class="text-aura-text-muted text-[10px]"></span>
          </div>
        </div>

        <!-- Upload Status Box -->
        <div id="upload-status" class="hidden rounded-xl p-3 text-xs flex items-start gap-2.5 transition">
          <div id="upload-status-icon" class="shrink-0 mt-0.5"></div>
          <div id="upload-status-text" class="flex-grow"></div>
        </div>

        <!-- Submit Button Row -->
        <div class="flex items-center justify-between pt-1">
          <div class="text-[11px] text-aura-text-muted flex items-center gap-2">
            <Lock class="w-3.5 h-3.5 text-emerald-600" />
            <span>Files are encrypted & tenant-isolated to your account ID</span>
          </div>

          <button
            id="btn-upload-file"
            type="button"
            disabled
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-aura-action hover:bg-black text-white text-xs font-semibold transition shadow-xs disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
          >
            <UploadCloud class="w-4 h-4" />
            <span id="btn-upload-text">Upload to Vault</span>
          </button>
        </div>
      </div>
    </div>

    <!-- 4. Supported Document Types Information Cards (3-Column) -->
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs text-aura-text-subtle font-semibold uppercase tracking-wider">
        <FileText class="w-4 h-4 text-aura-accent-orange" stroke-width={2} />
        <span>Supported Document Categories</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Card 1: Laboratory Panels -->
        <div class="bg-aura-surface p-5 sm:p-6 rounded-aura-card border border-aura-border/40 shadow-aura-card space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <div class="w-9 h-9 rounded-xl bg-aura-accent-peach/50 flex items-center justify-center text-aura-accent-orange">
                <FlaskConical class="w-4.5 h-4.5" stroke-width={2} />
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-aura-text-subtle bg-white px-2.5 py-0.5 rounded-full border border-aura-border/40">
                Panel
              </span>
            </div>
            <h3 class="font-serif font-normal text-aura-text text-base sm:text-lg">
              Laboratory Panels
            </h3>
            <p class="text-xs text-aura-text-muted leading-relaxed">
              Complete blood counts (CBC), comprehensive metabolic profiles (CMP), lipid panels, thyroid panels, and HbA1c diabetic markers.
            </p>
          </div>
          <div class="pt-2 text-[11px] font-medium text-aura-accent-orange flex items-center gap-1">
            <span>Range comparison & unit extraction</span>
          </div>
        </div>

        <!-- Card 2: Prescriptions -->
        <div class="bg-aura-surface p-5 sm:p-6 rounded-aura-card border border-aura-border/40 shadow-aura-card space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <div class="w-9 h-9 rounded-xl bg-aura-surface-cream flex items-center justify-center text-aura-action">
                <Pill class="w-4.5 h-4.5" stroke-width={2} />
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-aura-text-subtle bg-white px-2.5 py-0.5 rounded-full border border-aura-border/40">
                Rx
              </span>
            </div>
            <h3 class="font-serif font-normal text-aura-text text-base sm:text-lg">
              Clinical Prescriptions
            </h3>
            <p class="text-xs text-aura-text-muted leading-relaxed">
              Medications recorded verbatim with dosage frequencies, intake timings, and doctor notes. Instructions are never modified.
            </p>
          </div>
          <div class="pt-2 text-[11px] font-medium text-aura-action flex items-center gap-1">
            <span>Verbatim extraction without dosing advice</span>
          </div>
        </div>

        <!-- Card 3: Wellness & Diagnostic Logs -->
        <div class="bg-aura-surface p-5 sm:p-6 rounded-aura-card border border-aura-border/40 shadow-aura-card space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <div class="w-9 h-9 rounded-xl bg-aura-accent-peach/50 flex items-center justify-center text-aura-accent-orange">
                <Activity class="w-4.5 h-4.5" stroke-width={2} />
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-aura-text-subtle bg-white px-2.5 py-0.5 rounded-full border border-aura-border/40">
                Logs
              </span>
            </div>
            <h3 class="font-serif font-normal text-aura-text text-base sm:text-lg">
              Wellness & Diagnostic Logs
            </h3>
            <p class="text-xs text-aura-text-muted leading-relaxed">
              Home blood pressure measurements, glucometer morning logs, ultrasound impressions, and hospital discharge summaries.
            </p>
          </div>
          <div class="pt-2 text-[11px] font-medium text-aura-accent-orange flex items-center gap-1">
            <span>Longitudinal timeline aggregation</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 5. AI Safety & Privacy Notice Callout -->
    <div class="bg-aura-surface-cream/50 rounded-aura-panel p-5 sm:p-6 border border-black/5 space-y-3">
      <div class="flex items-center gap-2 text-aura-text font-bold text-xs uppercase tracking-wider">
        <ShieldCheck class="w-4 h-4 text-emerald-700" stroke-width={2} />
        <span>Privacy & Document Handling Architecture</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-aura-text-muted leading-relaxed">
        <div>
          <strong class="text-aura-text block mb-0.5">1. Local Client Isolation</strong>
          Files are validated directly in your browser. Documents are never logged to public caches or third-party servers during demo mode.
        </div>
        <div>
          <strong class="text-aura-text block mb-0.5">2. Mandatory Verification Step</strong>
          AI extractions are suggestions, not clinical ground truth. You must review and confirm all fields before adding them to your timeline.
        </div>
        <div>
          <strong class="text-aura-text block mb-0.5">3. Non-Diagnostic Purpose</strong>
          Altrix assists in personal organization and doctor consultation preparation. It does not prescribe medicines or adjust dosages.
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // --- Supabase Cloud Vault Document Management & Live Upload ---
  import { getSupabaseClient, isSupabaseConfigured } from '../lib/supabase/client';

  const vaultStatusChip = document.getElementById('vault-status-chip');
  const vaultAuthView = document.getElementById('vault-auth-view');
  const vaultGuestView = document.getElementById('vault-guest-view');
  const vaultUserEmail = document.getElementById('vault-user-email');
  const vaultAlert = document.getElementById('vault-alert');
  const vaultDocumentsList = document.getElementById('vault-documents-list');

  // Upload Elements
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
  const selectDocType = document.getElementById('upload-doc-type') as HTMLSelectElement | null;
  const inputFacility = document.getElementById('upload-source-facility') as HTMLInputElement | null;
  const btnUpload = document.getElementById('btn-upload-file') as HTMLButtonElement | null;
  const btnUploadText = document.getElementById('btn-upload-text');
  const selectedPill = document.getElementById('selected-file-pill');
  const selectedName = document.getElementById('selected-file-name');
  const selectedSize = document.getElementById('selected-file-size');
  const uploadStatus = document.getElementById('upload-status');
  const uploadStatusIcon = document.getElementById('upload-status-icon');
  const uploadStatusText = document.getElementById('upload-status-text');

  let currentSelectedFile: File | null = null;
  let activeAccessToken: string | null = null;
  let activeUserId: string | null = null;

  function showVaultAlert(msg: string, isError: boolean = false) {
    if (!vaultAlert) return;
    vaultAlert.className = isError
      ? 'rounded-xl p-3 text-xs flex items-start gap-2 bg-rose-50 text-rose-900 border border-rose-200'
      : 'rounded-xl p-3 text-xs flex items-start gap-2 bg-emerald-50 text-emerald-900 border border-emerald-200';
    vaultAlert.textContent = msg;
    vaultAlert.classList.remove('hidden');
  }

  function showUploadStatus(msg: string, type: 'info' | 'success' | 'error') {
    if (!uploadStatus || !uploadStatusIcon || !uploadStatusText) return;
    uploadStatus.classList.remove('hidden', 'bg-rose-50', 'text-rose-900', 'border-rose-200', 'bg-emerald-50', 'text-emerald-900', 'border-emerald-200', 'bg-amber-50', 'text-amber-900', 'border-amber-200');
    
    if (type === 'error') {
      uploadStatus.classList.add('bg-rose-50', 'text-rose-900', 'border', 'border-rose-200');
      uploadStatusIcon.innerHTML = '<svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-width="2"/><line x1="12" y1="8" x2="12" y2="12" stroke-width="2"/><line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2"/></svg>';
    } else if (type === 'success') {
      uploadStatus.classList.add('bg-emerald-50', 'text-emerald-900', 'border', 'border-emerald-200');
      uploadStatusIcon.innerHTML = '<svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
    } else {
      uploadStatus.classList.add('bg-amber-50', 'text-amber-900', 'border', 'border-amber-200');
      uploadStatusIcon.innerHTML = '<svg class="w-4 h-4 text-amber-600 shrink-0 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-width="2" stroke-dasharray="32" stroke-dashoffset="16"/></svg>';
    }
    uploadStatusText.textContent = msg;
  }

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function handleFileSelected(file: File) {
    const validMimes = ['application/pdf', 'image/jpeg', 'image/png'];
    const maxBytes = 10 * 1024 * 1024; // 10 MB limit matching storage bucket configuration

    if (!validMimes.includes(file.type)) {
      showUploadStatus('Invalid file format. Please upload a PDF, PNG, or JPEG file only.', 'error');
      currentSelectedFile = null;
      if (btnUpload) btnUpload.disabled = true;
      selectedPill?.classList.add('hidden');
      return;
    }

    if (file.size > maxBytes) {
      showUploadStatus(`File size exceeds 10 MB limit (${formatBytes(file.size)}). Please choose a smaller file.`, 'error');
      currentSelectedFile = null;
      if (btnUpload) btnUpload.disabled = true;
      selectedPill?.classList.add('hidden');
      return;
    }

    currentSelectedFile = file;
    if (selectedName) selectedName.textContent = file.name;
    if (selectedSize) selectedSize.textContent = `(${formatBytes(file.size)})`;
    selectedPill?.classList.remove('hidden');
    uploadStatus?.classList.add('hidden');

    if (btnUpload) {
      btnUpload.disabled = false;
    }
  }

  // Setup Drag and Drop
  if (dropzone && fileInput) {
    dropzone.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files[0]) {
        handleFileSelected(fileInput.files[0]);
      }
    });

    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-aura-accent-orange', 'bg-aura-surface-blush');
    });

    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-aura-accent-orange', 'bg-aura-surface-blush');
    });

    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-aura-accent-orange', 'bg-aura-surface-blush');
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
        handleFileSelected(e.dataTransfer.files[0]);
      }
    });
  }

  // Handle Real Document Upload to Supabase Storage & Create Metadata
  if (btnUpload) {
    btnUpload.addEventListener('click', async () => {
      if (!currentSelectedFile) {
        showUploadStatus('Please select a file to upload.', 'error');
        return;
      }

      const supabase = getSupabaseClient();
      if (!supabase || !activeAccessToken || !activeUserId) {
        showUploadStatus('Authenticated session expired or storage not configured. Please sign in again.', 'error');
        return;
      }

      btnUpload.disabled = true;
      if (btnUploadText) btnUploadText.textContent = 'Uploading to Vault...';
      showUploadStatus('Uploading encrypted file to private vault storage...', 'info');

      const file = currentSelectedFile;
      const sanitizedName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
      const uniqueSuffix = Date.now() + '_' + Math.random().toString(36).slice(2, 8);
      const ext = file.name.split('.').pop() || 'bin';
      const storageKey = `${activeUserId}/${uniqueSuffix}_${sanitizedName}`;

      try {
        // Step 1: Upload directly to private bucket 'health_documents_vault'
        const { error: uploadErr } = await supabase.storage
          .from('health_documents_vault')
          .upload(storageKey, file, {
            contentType: file.type,
            upsert: false,
          });

        if (uploadErr) {
          // If storage bucket doesn't exist remotely yet
          if (uploadErr.message?.toLowerCase().includes('bucket not found')) {
            showUploadStatus('Storage bucket "health_documents_vault" not found. Please execute migration 02 in Supabase SQL editor.', 'error');
          } else {
            showUploadStatus(`Storage upload failed: ${uploadErr.message}`, 'error');
          }
          btnUpload.disabled = false;
          if (btnUploadText) btnUploadText.textContent = 'Upload to Vault';
          return;
        }

        // Step 2: Create health_documents record in database
        if (btnUploadText) btnUploadText.textContent = 'Saving Record Metadata...';
        showUploadStatus('File encrypted in vault. Registering document metadata...', 'info');

        const docType = selectDocType?.value || 'lab_report';
        const sourceFacility = inputFacility?.value?.trim() || undefined;

        const metaRes = await fetch('/api/vault/documents', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${activeAccessToken}`,
          },
          body: JSON.stringify({
            document_type: docType,
            storage_path: storageKey,
            original_filename_sanitized: sanitizedName,
            mime_type: file.type,
            file_size_bytes: file.size,
            document_date: new Date().toISOString().split('T')[0],
            source_facility: sourceFacility,
            is_synthetic_demo: false,
          }),
        });

        if (!metaRes.ok) {
          const errData = await metaRes.json().catch(() => ({}));
          // Rollback orphaned storage object
          await supabase.storage.from('health_documents_vault').remove([storageKey]);
          showUploadStatus(`Failed to register document in vault: ${errData.error || metaRes.statusText}. Storage cleaned up.`, 'error');
          btnUpload.disabled = false;
          if (btnUploadText) btnUploadText.textContent = 'Upload to Vault';
          return;
        }

        // Success: Reset upload form and reload real records list
        showUploadStatus(`Successfully uploaded "${sanitizedName}" (${formatBytes(file.size)}) to private vault! Status: Pending Review.`, 'success');
        currentSelectedFile = null;
        if (fileInput) fileInput.value = '';
        selectedPill?.classList.add('hidden');
        btnUpload.disabled = true;
        if (btnUploadText) btnUploadText.textContent = 'Upload to Vault';

        await loadUserDocuments(activeAccessToken);
      } catch (err: any) {
        showUploadStatus(`Upload error: ${err.message || 'An unexpected error occurred'}`, 'error');
        btnUpload.disabled = false;
        if (btnUploadText) btnUploadText.textContent = 'Upload to Vault';
      }
    });
  }

  // Download helper for authorized private documents
  async function downloadDocument(storagePath: string, fileName: string) {
    if (!activeAccessToken) {
      alert('Active authenticated session required to download.');
      return;
    }

    try {
      const res = await fetch(`/api/vault/download?storage_path=${encodeURIComponent(storagePath)}`, {
        headers: {
          Authorization: `Bearer ${activeAccessToken}`,
        },
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        alert(`Failed to generate secure download link: ${err.error || res.statusText}`);
        return;
      }

      const { signedUrl } = await res.json();
      if (signedUrl) {
        window.open(signedUrl, '_blank', 'noopener,noreferrer');
      }
    } catch (e: any) {
      alert('Network error downloading document.');
    }
  }

  // Load real user documents list
  async function loadUserDocuments(token: string) {
    if (!vaultDocumentsList) return;
    try {
      const res = await fetch('/api/vault/documents', {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      if (!res.ok) {
        vaultDocumentsList.innerHTML = `
          <div class="text-xs text-rose-700 p-3 bg-rose-50 rounded-xl border border-rose-200">
            Failed to load documents from vault. Please try again.
          </div>
        `;
        return;
      }

      const data = await res.json();
      const docs = data.documents || [];

      if (docs.length === 0) {
        vaultDocumentsList.innerHTML = `
          <div class="text-xs text-aura-text-muted p-6 text-center bg-aura-surface-cream/30 rounded-xl border border-aura-border/30 space-y-2">
            <div class="font-bold text-aura-text text-sm">No Documents Stored in Your Vault Yet</div>
            <div class="max-w-md mx-auto leading-relaxed text-[11px]">
              Use the upload dropzone above to store your first PDF or image report. Stored records are protected with PostgreSQL Row Level Security.
            </div>
          </div>
        `;
        return;
      }

      vaultDocumentsList.innerHTML = docs.map((doc: any) => {
        const docName = doc.original_filename_sanitized || 'document.pdf';
        const docDate = doc.document_date || new Date(doc.created_at).toLocaleDateString();
        const facility = doc.source_facility || 'Clinical Facility';
        const sizeStr = doc.file_size_bytes ? formatBytes(doc.file_size_bytes) : '';
        const isPending = doc.status === 'pending_review' || doc.status === 'uploaded';
        const statusBadge = isPending
          ? '<span class="text-[10px] px-2 py-0.5 rounded-full font-semibold bg-amber-50 text-amber-800 border border-amber-200">Awaiting Review</span>'
          : '<span class="text-[10px] px-2 py-0.5 rounded-full font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Reviewed</span>';

        return `
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-xl bg-white border border-aura-border/60 shadow-2xs hover:border-aura-accent-orange/40 transition">
            <div class="space-y-1">
              <div class="text-xs font-bold text-aura-text flex flex-wrap items-center gap-2">
                <span class="truncate max-w-[260px]">${docName}</span>
                ${statusBadge}
                ${doc.is_synthetic_demo ? '<span class="text-[10px] px-2 py-0.5 rounded-full font-semibold bg-purple-50 text-purple-700 border border-purple-200">Synthetic Demo</span>' : ''}
              </div>
              <div class="text-[11px] text-aura-text-muted flex flex-wrap items-center gap-2">
                <span>${facility}</span>
                <span>•</span>
                <span>${docDate}</span>
                ${sizeStr ? `<span>•</span><span>${sizeStr}</span>` : ''}
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              ${doc.storage_path ? `
                <button
                  type="button"
                  data-storage-path="${doc.storage_path}"
                  data-doc-name="${docName}"
                  class="btn-doc-download text-xs font-medium px-3 py-1.5 rounded-full bg-white hover:bg-aura-surface-blush text-aura-text transition border border-aura-border cursor-pointer inline-flex items-center gap-1"
                  title="Download secure copy"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                  <span>Download</span>
                </button>
              ` : ''}
              <a
                href="/review"
                class="text-xs font-semibold px-3.5 py-1.5 rounded-full bg-aura-surface-cream hover:bg-aura-surface-cream-light text-aura-text transition border border-black/5"
              >
                Review Findings →
              </a>
            </div>
          </div>
        `;
      }).join('');

      // Attach download listeners
      document.querySelectorAll('.btn-doc-download').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const sp = target.getAttribute('data-storage-path');
          const nm = target.getAttribute('data-doc-name') || 'document.pdf';
          if (sp) downloadDocument(sp, nm);
        });
      });
    } catch {
      vaultDocumentsList.innerHTML = `
        <div class="text-xs text-rose-700 p-3 bg-rose-50 rounded-xl border border-rose-200">
          Network error loading vault documents.
        </div>
      `;
    }
  }

  async function initVaultSession() {
    const supabase = getSupabaseClient();
    if (!supabase || !isSupabaseConfigured) return;

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session?.user && session?.access_token) {
        activeAccessToken = session.access_token;
        activeUserId = session.user.id;

        if (vaultStatusChip) {
          vaultStatusChip.innerHTML = `
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Authenticated: ${session.user.email?.split('@')[0]}
            </span>
          `;
        }
        if (vaultUserEmail) vaultUserEmail.textContent = session.user.email || session.user.id;
        if (vaultAuthView) vaultAuthView.classList.remove('hidden');
        if (vaultGuestView) vaultGuestView.classList.add('hidden');

        await loadUserDocuments(session.access_token);
      }
    } catch {
      // Graceful fallback
    }
  }

  initVaultSession();

  const supabaseClient = getSupabaseClient();
  if (supabaseClient) {
    supabaseClient.auth.onAuthStateChange(async (_event, session) => {
      if (session?.user && session?.access_token) {
        activeAccessToken = session.access_token;
        activeUserId = session.user.id;

        if (vaultStatusChip) {
          vaultStatusChip.innerHTML = `
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Authenticated: ${session.user.email?.split('@')[0]}
            </span>
          `;
        }
        if (vaultUserEmail) vaultUserEmail.textContent = session.user.email || session.user.id;
        if (vaultAuthView) vaultAuthView.classList.remove('hidden');
        if (vaultGuestView) vaultGuestView.classList.add('hidden');
        await loadUserDocuments(session.access_token);
      } else {
        activeAccessToken = null;
        activeUserId = null;
        if (vaultAuthView) vaultAuthView.classList.add('hidden');
        if (vaultGuestView) vaultGuestView.classList.remove('hidden');
      }
    });
  }
</script>
