---
import {
  FileUp,
  Sparkles,
  UploadCloud,
  Lock,
  AlertCircle,
  CheckCircle2,
  Loader2,
  FlaskConical,
  Pill,
  Activity,
  ArrowRight,
  ShieldCheck,
  FileText,
  RotateCcw,
  Info,
  Plus,
  Database,
} from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import { SYNTHETIC_REPORT_STATS } from '../fixtures/synthetic-lab-report';

const totalCount = SYNTHETIC_REPORT_STATS.totalFieldsCount;
const outOfRangeCount = SYNTHETIC_REPORT_STATS.outOfRangeCount;
const uncertainCount = SYNTHETIC_REPORT_STATS.uncertainFieldsCount;
---

<Layout title="Medical Records" subtext="Upload and manage synthetic records">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8">
    <!-- 1. Page Header & Session Context -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-2 border-b border-aura-border/30">
      <div class="space-y-2 max-w-3xl">
        <div class="flex flex-wrap items-center gap-2 text-xs text-aura-text-muted">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-aura-surface-cream text-aura-text text-[11px] font-semibold border border-black/5 shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-aura-accent-orange animate-pulse"></span>
            MEDICAL RECORDS INTAKE
          </span>
          <span class="hidden sm:inline">•</span>
          <span class="font-medium text-aura-text">Priya Sharma (34F)</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-serif font-normal text-aura-text tracking-tight">
          Upload Medical Documents
        </h1>
        <p class="text-xs sm:text-sm text-aura-text-muted leading-relaxed max-w-2xl">
          Upload laboratory reports, clinical prescriptions, or diagnostic summaries.
          The extraction pipeline verifies reference ranges, flags optical uncertainties, and prepares parameters for your review.
        </p>
      </div>

      <!-- Header status pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-aura-surface border border-aura-border/60 text-xs text-aura-text shrink-0 shadow-2xs self-start md:self-auto">
        <ShieldCheck class="w-4 h-4 text-emerald-600" stroke-width={2} />
        <span class="font-medium">Client Isolation Active</span>
      </div>
    </div>

    <!-- 2. Quick Demo: Verified Synthetic Report Hero Banner -->
    <div class="bg-aura-surface-cream rounded-aura-panel p-6 sm:p-7 border border-black/5 shadow-aura-card flex flex-col md:flex-row md:items-center justify-between gap-6 transition hover:shadow-aura-float">
      <div class="space-y-2 max-w-2xl">
        <div class="flex items-center gap-2 text-aura-text">
          <div class="w-8 h-8 rounded-full bg-white/60 flex items-center justify-center text-aura-accent-orange shadow-2xs shrink-0">
            <Sparkles class="w-4 h-4" stroke-width={2} />
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-aura-text">
            Quick Demo • Pre-Extracted Lab Fixture
          </span>
        </div>
        <h2 class="text-lg sm:text-xl font-serif font-normal text-aura-text">
          Explore Sample CBC & Metabolic Lab Panel
        </h2>
        <p class="text-xs sm:text-sm text-aura-text-muted leading-relaxed">
          Skip file selection to immediately examine a realistic synthetic report with {totalCount} clinical parameters ({outOfRangeCount} out-of-range observations, including low Hemoglobin, high Fasting Blood Sugar, and {uncertainCount} flagged optical uncertainties).
        </p>
      </div>
      <div class="shrink-0">
        <a
          href="/review"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-aura-action hover:bg-aura-action-hover text-white font-semibold text-xs sm:text-sm shadow-xs transition transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-aura-sidebar"
        >
          <span>Open Synthetic Report Fixture</span>
          <ArrowRight class="w-4 h-4" stroke-width={2} />
        </a>
      </div>
    </div>

    <!-- 2b. Supabase Private Vault Records (Protected Cloud Workflow) -->
    <div id="cloud-vault-section" class="bg-white rounded-aura-panel border border-aura-border shadow-aura-card p-6 sm:p-7 space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-aura-border/40">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-800">
            <Database class="w-4 h-4" stroke-width={2} />
          </div>
          <div>
            <h2 class="text-base font-serif font-normal text-aura-text">
              Private Cloud Vault (Supabase RLS)
            </h2>
            <p class="text-xs text-aura-text-muted">
              PostgreSQL Row Level Security ensures only your authenticated user ID can read or insert your records.
            </p>
          </div>
        </div>

        <div id="vault-status-chip" class="self-start sm:self-auto">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-aura-surface-cream text-aura-text border border-black/5">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            Guest Mode (Unauthenticated)
          </span>
        </div>
      </div>

      <!-- Authenticated Vault View (Hidden when guest) -->
      <div id="vault-auth-view" class="hidden space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-xl bg-aura-surface-blush border border-aura-border/60">
          <div class="text-xs space-y-0.5">
            <div class="font-bold text-aura-text">Active Cloud Session:</div>
            <div id="vault-user-email" class="text-aura-text-muted font-mono text-[11px]">user@example.com</div>
          </div>
          <button
            id="btn-save-sample-record"
            type="button"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-aura-action text-white text-xs font-semibold hover:bg-black transition shadow-xs cursor-pointer shrink-0"
          >
            <Plus class="w-3.5 h-3.5" />
            <span>+ Save Sample Synthetic CBC to Vault</span>
          </button>
        </div>

        <!-- Alert box for success / error messages -->
        <div id="vault-alert" class="hidden rounded-xl p-3 text-xs flex items-start gap-2"></div>

        <!-- Live Document Table / List -->
        <div class="space-y-2">
          <h3 class="text-xs font-bold text-aura-text uppercase tracking-wider">
            Your Stored Vault Documents
          </h3>
          <div id="vault-documents-list" class="space-y-2">
            <div class="text-xs text-aura-text-muted p-4 text-center bg-aura-surface-cream/30 rounded-xl border border-aura-border/30">
              Loading your private vault records...
            </div>
          </div>
        </div>
      </div>

      <!-- Unauthenticated Guest View (Shown by default) -->
      <div id="vault-guest-view" class="p-4 sm:p-5 rounded-xl bg-aura-surface-cream/40 border border-aura-border/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1 text-xs">
          <p class="font-bold text-aura-text">Want to test private document storage & multi-user isolation?</p>
          <p class="text-aura-text-muted text-[11px]">
            Sign in with an Altrix account to save synthetic records to your private Supabase vault and verify that other users cannot access them.
          </p>
        </div>
        <a
          href="/auth"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-aura-action text-white text-xs font-semibold hover:bg-black transition shadow-xs shrink-0"
        >
          <span>Sign In / Create Account</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <!-- 3. Main Document Intake Panel -->
    <div class="bg-aura-surface rounded-aura-panel border border-aura-border/40 shadow-aura-card p-6 sm:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-aura-border/30">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-aura-accent-peach/40 flex items-center justify-center text-aura-accent-orange">
            <UploadCloud class="w-4 h-4" stroke-width={2} />
          </div>
          <div>
            <h2 class="text-base font-serif font-normal text-aura-text">
              Document Intake & Inspection
            </h2>
            <p class="text-xs text-aura-text-muted">
              Select or drop your document for structured parsing
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2 text-xs text-aura-text-subtle">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Offline Mock Pipeline Ready</span>
        </div>
      </div>

      <!-- Drag & Drop Dropzone -->
      <div
        id="dropzone"
        tabindex="0"
        role="button"
        aria-label="Upload medical file dropzone. Press Enter or Space to browse, or drag PDF, JPG, or PNG files here."
        class="border-2 border-dashed border-aura-border hover:border-aura-accent-orange focus-visible:border-aura-accent-orange focus-visible:ring-4 focus-visible:ring-aura-accent-peach/50 rounded-2xl p-8 sm:p-12 text-center transition-all cursor-pointer bg-aura-surface-blush/60 hover:bg-aura-surface-blush group select-none"
      >
        <input
          type="file"
          id="file-input"
          class="hidden"
          accept=".pdf,image/jpeg,image/png"
          aria-hidden="true"
        />

        <div class="max-w-lg mx-auto space-y-5">
          <!-- Central Icon Pill -->
          <div class="w-16 h-16 mx-auto rounded-2xl bg-aura-accent-peach/60 text-aura-accent-orange flex items-center justify-center group-hover:scale-105 group-hover:bg-aura-accent-peach transition duration-300 shadow-2xs">
            <UploadCloud class="w-8 h-8" stroke-width={1.8} />
          </div>

          <!-- Instruction Text -->
          <div class="space-y-1.5">
            <p class="text-sm sm:text-base font-semibold text-aura-text">
              <span class="text-aura-accent-orange font-bold group-hover:underline">Click to browse</span> or drag and drop your document
            </p>
            <p class="text-xs sm:text-sm text-aura-text-muted">
              Supported formats: <strong class="text-aura-text font-semibold">PDF, JPG, PNG</strong> (Maximum file size: <strong class="text-aura-text font-semibold">10 MB</strong>)
            </p>
          </div>

          <!-- Feature & Security Badges -->
          <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-medium bg-white text-aura-text border border-aura-border/60 shadow-2xs">
              <Lock class="w-3 h-3 text-aura-accent-orange" stroke-width={2} />
              <span>Isolated Client Validation</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-medium bg-white text-aura-text border border-aura-border/60 shadow-2xs">
              <ShieldCheck class="w-3 h-3 text-emerald-600" stroke-width={2} />
              <span>No Cloud PHI Transmission</span>
            </span>
          </div>
        </div>
      </div>

      <!-- State: Extraction Progress (Hidden by default) -->
      <div
        id="state-loading"
        class="hidden bg-aura-surface-blush border border-aura-border/60 rounded-2xl p-6 sm:p-7 space-y-4 shadow-2xs"
        aria-live="polite"
      >
        <div class="flex items-center justify-between gap-3 text-xs sm:text-sm font-semibold text-aura-text">
          <div class="flex items-center gap-2.5">
            <Loader2 class="w-5 h-5 text-aura-accent-orange animate-spin shrink-0" stroke-width={2} />
            <span id="loading-stage-text">Validating file headers & structure...</span>
          </div>
          <span id="loading-percentage" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-white text-aura-text border border-aura-border/60 shadow-2xs">
            15%
          </span>
        </div>

        <!-- Progress track -->
        <div class="w-full bg-aura-border/50 rounded-full h-2.5 overflow-hidden">
          <div
            id="loading-bar"
            class="bg-aura-accent-orange h-2.5 rounded-full transition-all duration-300 w-[15%]"
          ></div>
        </div>

        <!-- Step status progression pills -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-1 text-[11px] text-aura-text-muted">
          <div class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-aura-accent-orange"></span>
            <span>1. File integrity & quarantine</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-aura-accent-orange/60"></span>
            <span>2. Entity & range detection</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-aura-accent-orange/40"></span>
            <span>3. Optical uncertainty check</span>
          </div>
        </div>

        <p class="text-[11px] text-aura-text-subtle border-t border-aura-border/30 pt-3">
          Simulated offline extraction in progress via <code class="font-mono text-aura-text font-semibold">SyntheticOfflineMockProvider</code>. No data is stored externally.
        </p>
      </div>

      <!-- State: Error State (Hidden by default) -->
      <div
        id="state-error"
        class="hidden bg-rose-50/90 border border-rose-200 rounded-2xl p-6 space-y-4 text-rose-900 shadow-2xs"
        role="alert"
        aria-live="assertive"
      >
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-2.5 text-sm sm:text-base font-bold text-rose-900">
            <AlertCircle class="w-5 h-5 text-rose-600 shrink-0" stroke-width={2} />
            <span id="error-title">Document Validation Error</span>
          </div>
          <button
            type="button"
            id="btn-retry"
            class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-white text-rose-800 border border-rose-200 hover:bg-rose-100 transition shadow-2xs cursor-pointer"
          >
            <RotateCcw class="w-3 h-3" stroke-width={2} />
            <span>Dismiss & Try Again</span>
          </button>
        </div>
        <p id="error-message" class="text-xs sm:text-sm leading-relaxed text-rose-800">
          The selected file could not be processed.
        </p>
        <div class="bg-white/80 rounded-xl p-3 text-xs text-rose-700 border border-rose-100 flex items-start gap-2">
          <Info class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" stroke-width={2} />
          <span>Please verify that your file is an uncorrupted PDF, JPG, or PNG document and under the 10 MB maximum file size.</span>
        </div>
      </div>

      <!-- State: Success Ready State (Hidden by default) -->
      <div
        id="state-success"
        class="hidden bg-white border border-emerald-200 rounded-2xl p-6 sm:p-7 space-y-5 shadow-aura-card"
        role="region"
        aria-live="polite"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-emerald-100">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 shrink-0">
              <CheckCircle2 class="w-5 h-5" stroke-width={2} />
            </div>
            <div>
              <h3 class="text-sm sm:text-base font-bold text-emerald-950">
                Document Successfully Extracted (Offline Mock)
              </h3>
              <p class="text-xs text-emerald-800">
                Parameters identified and staged for your clinical review
              </p>
            </div>
          </div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-xs font-bold border border-emerald-200 shrink-0 self-start sm:self-auto">
            <span>{totalCount} Parameters Extracted</span>
          </span>
        </div>

        <!-- File Details Card -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 p-4 rounded-xl bg-aura-surface-blush/60 border border-aura-border/40 text-xs">
          <div>
            <span class="text-aura-text-subtle block text-[11px] font-medium uppercase tracking-wider">File Name</span>
            <span id="success-file-name" class="font-bold text-aura-text break-all">report.pdf</span>
          </div>
          <div>
            <span class="text-aura-text-subtle block text-[11px] font-medium uppercase tracking-wider">File Size</span>
            <span id="success-file-size" class="font-medium text-aura-text">145 KB</span>
          </div>
          <div>
            <span class="text-aura-text-subtle block text-[11px] font-medium uppercase tracking-wider">Extraction Engine</span>
            <span class="font-medium text-aura-text">Synthetic Offline Provider</span>
          </div>
        </div>

        <!-- Uncertainty Guidance Alert -->
        <div class="p-4 rounded-xl bg-amber-50/90 border border-amber-200/80 text-xs text-amber-900 space-y-1">
          <div class="font-bold flex items-center gap-2 text-amber-950">
            <AlertCircle class="w-4 h-4 text-amber-600 shrink-0" stroke-width={2} />
            <span>Optical Uncertainty Detected in {uncertainCount} Fields</span>
          </div>
          <p class="text-amber-800 leading-relaxed">
            Values for <strong class="text-amber-950">Platelet Count</strong> and <strong class="text-amber-950">TSH (Thyroid Stimulating Hormone)</strong> had lower OCR confidence. Please verify these against the original document on the review screen.
          </p>
        </div>

        <!-- Actions -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="/review"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs sm:text-sm shadow-xs transition transform hover:-translate-y-0.5"
          >
            <span>Proceed to Report Review Screen</span>
            <ArrowRight class="w-4 h-4" stroke-width={2} />
          </a>
          <button
            type="button"
            id="btn-upload-another"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-aura-surface-cream hover:bg-aura-surface-cream-light text-aura-text font-medium text-xs sm:text-sm border border-black/5 transition cursor-pointer"
          >
            <RotateCcw class="w-3.5 h-3.5 text-aura-text-muted" stroke-width={2} />
            <span>Select Another Document</span>
          </button>
        </div>
      </div>
    </div>

    <!-- 4. Supported Document Types Information Cards (3-Column) -->
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs text-aura-text-subtle font-semibold uppercase tracking-wider">
        <FileText class="w-4 h-4 text-aura-accent-orange" stroke-width={2} />
        <span>Supported Document Categories</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Card 1: Laboratory Panels -->
        <div class="bg-aura-surface p-5 sm:p-6 rounded-aura-card border border-aura-border/40 shadow-aura-card space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <div class="w-9 h-9 rounded-xl bg-aura-accent-peach/50 flex items-center justify-center text-aura-accent-orange">
                <FlaskConical class="w-4.5 h-4.5" stroke-width={2} />
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-aura-text-subtle bg-white px-2.5 py-0.5 rounded-full border border-aura-border/40">
                Panel
              </span>
            </div>
            <h3 class="font-serif font-normal text-aura-text text-base sm:text-lg">
              Laboratory Panels
            </h3>
            <p class="text-xs text-aura-text-muted leading-relaxed">
              Complete blood counts (CBC), comprehensive metabolic profiles (CMP), lipid panels, thyroid panels, and HbA1c diabetic markers.
            </p>
          </div>
          <div class="pt-2 text-[11px] font-medium text-aura-accent-orange flex items-center gap-1">
            <span>Range comparison & unit extraction</span>
          </div>
        </div>

        <!-- Card 2: Prescriptions -->
        <div class="bg-aura-surface p-5 sm:p-6 rounded-aura-card border border-aura-border/40 shadow-aura-card space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <div class="w-9 h-9 rounded-xl bg-aura-surface-cream flex items-center justify-center text-aura-action">
                <Pill class="w-4.5 h-4.5" stroke-width={2} />
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-aura-text-subtle bg-white px-2.5 py-0.5 rounded-full border border-aura-border/40">
                Rx
              </span>
            </div>
            <h3 class="font-serif font-normal text-aura-text text-base sm:text-lg">
              Clinical Prescriptions
            </h3>
            <p class="text-xs text-aura-text-muted leading-relaxed">
              Medications recorded verbatim with dosage frequencies, intake timings, and doctor notes. Instructions are never modified.
            </p>
          </div>
          <div class="pt-2 text-[11px] font-medium text-aura-action flex items-center gap-1">
            <span>Verbatim extraction without dosing advice</span>
          </div>
        </div>

        <!-- Card 3: Wellness & Diagnostic Logs -->
        <div class="bg-aura-surface p-5 sm:p-6 rounded-aura-card border border-aura-border/40 shadow-aura-card space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <div class="w-9 h-9 rounded-xl bg-aura-accent-peach/50 flex items-center justify-center text-aura-accent-orange">
                <Activity class="w-4.5 h-4.5" stroke-width={2} />
              </div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-aura-text-subtle bg-white px-2.5 py-0.5 rounded-full border border-aura-border/40">
                Logs
              </span>
            </div>
            <h3 class="font-serif font-normal text-aura-text text-base sm:text-lg">
              Wellness & Diagnostic Logs
            </h3>
            <p class="text-xs text-aura-text-muted leading-relaxed">
              Home blood pressure measurements, glucometer morning logs, ultrasound impressions, and hospital discharge summaries.
            </p>
          </div>
          <div class="pt-2 text-[11px] font-medium text-aura-accent-orange flex items-center gap-1">
            <span>Longitudinal timeline aggregation</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 5. AI Safety & Privacy Notice Callout -->
    <div class="bg-aura-surface-cream/50 rounded-aura-panel p-5 sm:p-6 border border-black/5 space-y-3">
      <div class="flex items-center gap-2 text-aura-text font-bold text-xs uppercase tracking-wider">
        <ShieldCheck class="w-4 h-4 text-emerald-700" stroke-width={2} />
        <span>Privacy & Document Handling Architecture</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-aura-text-muted leading-relaxed">
        <div>
          <strong class="text-aura-text block mb-0.5">1. Local Client Isolation</strong>
          Files are validated directly in your browser. Documents are never logged to public caches or third-party servers during demo mode.
        </div>
        <div>
          <strong class="text-aura-text block mb-0.5">2. Mandatory Verification Step</strong>
          AI extractions are suggestions, not clinical ground truth. You must review and confirm all fields before adding them to your timeline.
        </div>
        <div>
          <strong class="text-aura-text block mb-0.5">3. Non-Diagnostic Purpose</strong>
          Altrix assists in personal organization and doctor consultation preparation. It does not prescribe medicines or adjust dosages.
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
  const stateLoading = document.getElementById('state-loading');
  const stateError = document.getElementById('state-error');
  const stateSuccess = document.getElementById('state-success');
  const errorMessage = document.getElementById('error-message');
  const errorTitle = document.getElementById('error-title');
  const loadingBar = document.getElementById('loading-bar');
  const loadingPercentage = document.getElementById('loading-percentage');
  const loadingStageText = document.getElementById('loading-stage-text');
  const successFileName = document.getElementById('success-file-name');
  const successFileSize = document.getElementById('success-file-size');
  const btnRetry = document.getElementById('btn-retry');
  const btnUploadAnother = document.getElementById('btn-upload-another');

  if (dropzone && fileInput) {
    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });

    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-aura-accent-orange', 'bg-aura-surface-blush', 'ring-4', 'ring-aura-accent-peach/30');
    });

    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-aura-accent-orange', 'bg-aura-surface-blush', 'ring-4', 'ring-aura-accent-peach/30');
    });

    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-aura-accent-orange', 'bg-aura-surface-blush', 'ring-4', 'ring-aura-accent-peach/30');
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        handleFileSelection(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFileSelection(fileInput.files[0]);
      }
    });
  }

  if (btnRetry) {
    btnRetry.addEventListener('click', () => {
      resetStates();
      if (fileInput) fileInput.value = '';
    });
  }

  if (btnUploadAnother) {
    btnUploadAnother.addEventListener('click', () => {
      resetStates();
      if (fileInput) fileInput.value = '';
      dropzone?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }

  function resetStates() {
    stateError?.classList.add('hidden');
    stateSuccess?.classList.add('hidden');
    stateLoading?.classList.add('hidden');
  }

  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  function handleFileSelection(file: File) {
    resetStates();

    const validExtensions = ['.pdf', '.jpg', '.jpeg', '.png'];
    const lowerName = file.name.toLowerCase();
    const isValidType = validExtensions.some((ext) => lowerName.endsWith(ext));

    if (!isValidType) {
      showError(
        'Unsupported Document Format',
        `The file "${file.name}" is not supported. Please upload a medical document in PDF, JPG, or PNG format.`
      );
      return;
    }

    const maxBytes = 10 * 1024 * 1024; // 10MB
    if (file.size > maxBytes) {
      showError(
        'File Size Exceeded',
        `The selected document (${formatBytes(file.size)}) exceeds the maximum allowed size of 10 MB. Please compress or optimize the file before uploading.`
      );
      return;
    }

    // Trigger synthetic mock extraction pipeline
    simulateExtraction(file);
  }

  function showError(title: string, msg: string) {
    if (errorTitle) errorTitle.textContent = title;
    if (errorMessage && stateError) {
      errorMessage.textContent = msg;
      stateError.classList.remove('hidden');
      stateError.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function simulateExtraction(file: File) {
    stateLoading?.classList.remove('hidden');
    stateLoading?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    const stages = [
      { progress: 25, label: 'Scanning file headers & verifying document integrity...' },
      { progress: 60, label: 'Parsing laboratory entities, units, and reference ranges...' },
      { progress: 85, label: 'Evaluating optical confidence & flagging uncertainties...' },
      { progress: 100, label: 'Finalizing extraction results for review...' },
    ];

    let currentStage = 0;

    const interval = setInterval(() => {
      if (currentStage < stages.length) {
        const stage = stages[currentStage];
        if (loadingBar) loadingBar.style.width = `${stage.progress}%`;
        if (loadingPercentage) loadingPercentage.textContent = `${stage.progress}%`;
        if (loadingStageText) loadingStageText.textContent = stage.label;
        currentStage++;
      } else {
        clearInterval(interval);
        setTimeout(() => {
          stateLoading?.classList.add('hidden');
          if (successFileName) successFileName.textContent = file.name;
          if (successFileSize) successFileSize.textContent = formatBytes(file.size);
          stateSuccess?.classList.remove('hidden');
          stateSuccess?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 350);
      }
    }, 280);
  }

  // --- Supabase Cloud Vault Document Management ---
  import { getSupabaseClient, isSupabaseConfigured } from '../lib/supabase/client';

  const vaultStatusChip = document.getElementById('vault-status-chip');
  const vaultAuthView = document.getElementById('vault-auth-view');
  const vaultGuestView = document.getElementById('vault-guest-view');
  const vaultUserEmail = document.getElementById('vault-user-email');
  const vaultAlert = document.getElementById('vault-alert');
  const vaultDocumentsList = document.getElementById('vault-documents-list');
  const btnSaveSampleRecord = document.getElementById('btn-save-sample-record');

  function showVaultAlert(msg: string, isError: boolean = false) {
    if (!vaultAlert) return;
    vaultAlert.className = isError
      ? 'rounded-xl p-3 text-xs flex items-start gap-2 bg-rose-50 text-rose-900 border border-rose-200'
      : 'rounded-xl p-3 text-xs flex items-start gap-2 bg-emerald-50 text-emerald-900 border border-emerald-200';
    vaultAlert.textContent = msg;
    vaultAlert.classList.remove('hidden');
  }

  async function loadUserDocuments(token: string) {
    if (!vaultDocumentsList) return;
    try {
      const res = await fetch('/api/vault/documents', {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      if (!res.ok) {
        vaultDocumentsList.innerHTML = `
          <div class="text-xs text-rose-700 p-3 bg-rose-50 rounded-xl border border-rose-200">
            Failed to load documents from vault. Please try again.
          </div>
        `;
        return;
      }

      const data = await res.json();
      const docs = data.documents || [];

      if (docs.length === 0) {
        vaultDocumentsList.innerHTML = `
          <div class="text-xs text-aura-text-muted p-4 text-center bg-aura-surface-cream/30 rounded-xl border border-aura-border/30">
            No documents saved in your vault yet. Click "+ Save Sample Synthetic CBC to Vault" above to add your first record.
          </div>
        `;
        return;
      }

      vaultDocumentsList.innerHTML = docs.map((doc: any) => `
        <div class="flex items-center justify-between p-3.5 rounded-xl bg-white border border-aura-border/60 shadow-2xs hover:border-aura-accent-orange/40 transition">
          <div class="space-y-0.5">
            <div class="text-xs font-bold text-aura-text flex items-center gap-2">
              <span>${doc.original_filename_sanitized || 'synthetic_report.pdf'}</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                ${doc.is_synthetic_demo ? 'Synthetic Demo' : 'Stored Record'}
              </span>
            </div>
            <div class="text-[11px] text-aura-text-muted flex items-center gap-2">
              <span>${doc.source_facility || 'Clinical Facility'}</span>
              <span>•</span>
              <span>${doc.document_date || new Date(doc.created_at).toLocaleDateString()}</span>
            </div>
          </div>
          <a
            href="/review"
            class="text-xs font-semibold px-3 py-1.5 rounded-full bg-aura-surface-cream hover:bg-aura-surface-cream-light text-aura-text transition border border-black/5"
          >
            Review Document →
          </a>
        </div>
      `).join('');
    } catch {
      vaultDocumentsList.innerHTML = `
        <div class="text-xs text-rose-700 p-3 bg-rose-50 rounded-xl border border-rose-200">
          Network error loading vault documents.
        </div>
      `;
    }
  }

  async function initVaultSession() {
    const supabase = getSupabaseClient();
    if (!supabase || !isSupabaseConfigured) return;

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session?.user && session?.access_token) {
        if (vaultStatusChip) {
          vaultStatusChip.innerHTML = `
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Authenticated: ${session.user.email?.split('@')[0]}
            </span>
          `;
        }
        if (vaultUserEmail) vaultUserEmail.textContent = session.user.email || session.user.id;
        if (vaultAuthView) vaultAuthView.classList.remove('hidden');
        if (vaultGuestView) vaultGuestView.classList.add('hidden');

        await loadUserDocuments(session.access_token);
      }
    } catch {
      // Graceful fallback
    }
  }

  initVaultSession();

  const supabaseClient = getSupabaseClient();
  if (supabaseClient) {
    supabaseClient.auth.onAuthStateChange(async (_event, session) => {
      if (session?.user && session?.access_token) {
        if (vaultStatusChip) {
          vaultStatusChip.innerHTML = `
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Authenticated: ${session.user.email?.split('@')[0]}
            </span>
          `;
        }
        if (vaultUserEmail) vaultUserEmail.textContent = session.user.email || session.user.id;
        if (vaultAuthView) vaultAuthView.classList.remove('hidden');
        if (vaultGuestView) vaultGuestView.classList.add('hidden');
        await loadUserDocuments(session.access_token);
      } else {
        if (vaultAuthView) vaultAuthView.classList.add('hidden');
        if (vaultGuestView) vaultGuestView.classList.remove('hidden');
      }
    });
  }

  if (btnSaveSampleRecord) {
    btnSaveSampleRecord.addEventListener('click', async () => {
      const supabase = getSupabaseClient();
      if (!supabase) return;
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.access_token) {
        showVaultAlert('Please sign in to save records to your vault.', true);
        return;
      }

      btnSaveSampleRecord.textContent = 'Saving to vault...';
      try {
        const res = await fetch('/api/vault/documents', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({
            document_type: 'lab_report',
            storage_path: `vault/${session.user.id}/sample_cbc_panel_${Date.now()}.pdf`,
            original_filename_sanitized: 'sample_cbc_metabolic_panel.pdf',
            mime_type: 'application/pdf',
            file_size_bytes: 148480,
            document_date: '2026-10-12',
            source_facility: 'Apollo Diagnostics (Synthetic Demo)',
            is_synthetic_demo: true,
          }),
        });

        const json = await res.json();
        if (res.ok) {
          showVaultAlert('Synthetic document successfully created in your private vault!');
          await loadUserDocuments(session.access_token);
        } else {
          showVaultAlert(json.error || 'Failed to save document record.', true);
        }
      } catch {
        showVaultAlert('Network error while saving document.', true);
      } finally {
        btnSaveSampleRecord.textContent = '+ Save Sample Synthetic CBC to Vault';
      }
    });
  }
</script>
