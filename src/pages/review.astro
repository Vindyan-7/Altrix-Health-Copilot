  // Pure helper to re-evaluate interpretation against reference range
  function evaluateValue(val: number | string, low?: number | null, high?: number | null): string {
    const num = typeof val === 'number' ? val : parseFloat(val);
    if (isNaN(num)) return 'unspecified';
    if (low !== null && low !== undefined && num < low) return 'low';
    if (high !== null && high !== undefined && num > high) return 'high';
    if (low !== null && low !== undefined && high !== null && high !== undefined && num >= low && num <= high) return 'normal';
    if (low === null && high !== null && high !== undefined && num <= high) return 'normal';
    return 'unspecified';
  }

  // Recalculates review progress dynamically from state
  function updateProgress() {
    const reviewedCount = fields.filter((f) => f.reviewStatus === 'confirmed' || f.reviewStatus === 'corrected').length;
    const total = fields.length;
    const pct = Math.round((reviewedCount / total) * 100);

    if (reviewBar) reviewBar.style.width = `${pct}%`;
    if (reviewStatusLabel) {
      reviewStatusLabel.innerHTML = `<span class="w-2 h-2 rounded-full ${pct === 100 ? 'bg-emerald-500' : 'bg-aura-accent-orange'}"></span><span>Review Progress: ${reviewedCount} of ${total} fields reviewed</span>`;
    }
    if (reviewPercentage) reviewPercentage.textContent = `${pct}% Reviewed by User`;
  }

  // Synchronizes Provenance Inspector with the selected field
  function selectField(fieldId: string) {
    activeFieldId = fieldId;
    const f = fields.find((x) => x.id === fieldId);
    if (!f) return;

    // Visual selection rings
    tableRows.forEach((r) => {
      if (r.getAttribute('data-field-id') === fieldId) {
        r.classList.add('ring-2', 'ring-aura-accent-orange', 'bg-aura-accent-peach/20');
      } else {
        r.classList.remove('ring-2', 'ring-aura-accent-orange', 'bg-aura-accent-peach/20');
      }
    });

    mobileCards.forEach((c) => {
      if (c.getAttribute('data-field-id') === fieldId) {
        c.classList.add('ring-2', 'ring-aura-accent-orange');
      } else {
        c.classList.remove('ring-2', 'ring-aura-accent-orange');
      }
    });

    // Update Provenance Inspector
    if (inspectorSnippet) inspectorSnippet.textContent = f.provenance.rawSnippet;
    if (inspectorBox) inspectorBox.textContent = `Top: ${f.provenance.top}%, Left: ${f.provenance.left}%`;
    if (inspectorLabel) inspectorLabel.textContent = `Raw Extracted Text • ${f.name}`;
    if (inspectorPageBadge) inspectorPageBadge.textContent = `Page ${f.provenance.page}`;
    if (inspectorStatusBadge) {
      if (f.isUncertain) {
        inspectorStatusBadge.textContent = 'Optical Flag';
        inspectorStatusBadge.className = 'text-[10px] font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-300';
      } else {
        inspectorStatusBadge.textContent = 'High Confidence';
        inspectorStatusBadge.className = 'text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200';
      }
    }
  }

  // Update DOM representation of a single field
  function renderFieldDOM(fieldId: string) {
    const f = fields.find((x) => x.id === fieldId);
    if (!f) return;

    // Desktop elements
    const valDisplay = document.getElementById(`val-display-${f.id}`);
    const unitDisplay = document.getElementById(`unit-display-${f.id}`);
    const editedAudit = document.getElementById(`edited-audit-${f.id}`);
    const flagBadge = document.getElementById(`flag-${f.id}`);
    const reviewBadge = document.getElementById(`review-badge-${f.id}`);
    const btnConfirmText = document.getElementById(`btn-confirm-text-${f.id}`);

    // Mobile elements
    const mobileValDisplay = document.getElementById(`mobile-val-display-${f.id}`);
    const mobileUnitDisplay = document.getElementById(`mobile-unit-display-${f.id}`);
    const mobileEditedAudit = document.getElementById(`mobile-edited-audit-${f.id}`);
    const mobileFlagBadge = document.getElementById(`mobile-flag-${f.id}`);
    const mobileReviewBadge = document.getElementById(`mobile-review-badge-${f.id}`);
    const mobileBtnConfirmText = document.getElementById(`mobile-btn-confirm-text-${f.id}`);

    if (valDisplay) valDisplay.textContent = String(f.currentValue);
    if (unitDisplay) unitDisplay.textContent = f.unit;
    if (mobileValDisplay) mobileValDisplay.textContent = String(f.currentValue);
    if (mobileUnitDisplay) mobileUnitDisplay.textContent = f.unit;

    // Corrected audit line
    if (f.reviewStatus === 'corrected') {
      editedAudit?.classList.remove('hidden');
      mobileEditedAudit?.classList.remove('hidden');
    } else {
      editedAudit?.classList.add('hidden');
      mobileEditedAudit?.classList.add('hidden');
    }

    // Flag styling
    const flagClass = f.currentInterpretation === 'low'
      ? 'bg-aura-accent-peach text-aura-text'
      : f.currentInterpretation === 'high'
      ? 'bg-rose-100 text-rose-800'
      : 'bg-emerald-100 text-emerald-800';

    if (flagBadge) {
      flagBadge.textContent = f.currentInterpretation.toUpperCase();
      flagBadge.className = `px-2 py-0.5 rounded-full text-[11px] font-semibold ${flagClass}`;
    }
    if (mobileFlagBadge) {
      mobileFlagBadge.textContent = f.currentInterpretation.toUpperCase();
      mobileFlagBadge.className = `px-2 py-0.5 rounded-full text-[10.5px] font-semibold shrink-0 ${flagClass}`;
    }

    // Review status badge & button text
    if (reviewBadge) {
      if (f.reviewStatus === 'confirmed') {
        reviewBadge.textContent = 'Confirmed';
        reviewBadge.className = 'text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200';
      } else if (f.reviewStatus === 'corrected') {
        reviewBadge.textContent = 'Corrected';
        reviewBadge.className = 'text-[10px] font-bold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-full border border-indigo-200';
      } else {
        reviewBadge.textContent = 'Unreviewed';
        reviewBadge.className = 'text-[10px] font-medium text-aura-text-muted';
      }
    }

    if (mobileReviewBadge) {
      if (f.reviewStatus === 'confirmed') {
        mobileReviewBadge.textContent = 'Confirmed';
        mobileReviewBadge.className = 'text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200';
      } else if (f.reviewStatus === 'corrected') {
        mobileReviewBadge.textContent = 'Corrected';
        mobileReviewBadge.className = 'text-[11px] font-bold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-full border border-indigo-200';
      } else {
        mobileReviewBadge.textContent = 'Unreviewed';
        mobileReviewBadge.className = 'text-[11px] font-medium text-aura-text-muted';
      }
    }

    const isVerified = f.reviewStatus === 'confirmed' || f.reviewStatus === 'corrected';
    if (btnConfirmText) btnConfirmText.textContent = isVerified ? 'Verified' : 'Confirm';
    if (mobileBtnConfirmText) mobileBtnConfirmText.textContent = isVerified ? 'Verified' : 'Confirm';

    // Desktop row styling
    const row = document.getElementById(`row-${f.id}`);
    if (row) {
      if (isVerified) {
        row.classList.add('bg-emerald-50/25');
      } else {
        row.classList.remove('bg-emerald-50/25');
      }
    }

    // Mobile card styling
    const card = document.getElementById(`mobile-card-${f.id}`);
    if (card) {
      if (isVerified) {
        card.classList.add('border-emerald-300', 'bg-emerald-50/20');
      } else {
        card.classList.remove('border-emerald-300', 'bg-emerald-50/20');
      }
    }
  }

  // Filter fields (All, Optical Flags, Out of Range)
  function applyFilter(filter: string) {
    currentFilter = filter;

    document.querySelectorAll('.filter-chip').forEach((btn) => {
      if (btn.getAttribute('data-filter') === filter) {
        btn.classList.add('bg-aura-sidebar', 'text-white');
        btn.classList.remove('bg-white', 'text-aura-text');
      } else {
        btn.classList.remove('bg-aura-sidebar', 'text-white');
        btn.classList.add('bg-white', 'text-aura-text');
      }
    });

    if (activeFilterBadge) {
      activeFilterBadge.textContent = filter === 'uncertain'
        ? `Showing 2 Optical Flags`
        : filter === 'out-of-range'
        ? `Showing 5 Out of Range`
        : `Showing All ${fields.length}`;
    }

    fields.forEach((f) => {
      let isVisible = true;
      if (filter === 'uncertain') {
        isVisible = f.isUncertain;
      } else if (filter === 'out-of-range') {
        isVisible = f.currentInterpretation === 'low' || f.currentInterpretation === 'high';
      }

      const row = document.getElementById(`row-${f.id}`);
      const card = document.getElementById(`mobile-card-${f.id}`);
      if (row) row.classList.toggle('hidden', !isVisible);
      if (card) card.classList.toggle('hidden', !isVisible);
    });
  }

  // Setup Event Listeners for Filters
  document.querySelectorAll('.filter-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      if (filter) applyFilter(filter);
    });
  });

  // Desktop Table Row selection (Mouse click & Keyboard Enter/Space)
  tableRows.forEach((row) => {
    const fid = row.getAttribute('data-field-id');
    if (!fid) return;

    row.addEventListener('click', () => selectField(fid));
    row.addEventListener('keydown', (e: any) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectField(fid);
      }
    });
  });

  // Mobile Card selection (Touch tap & Keyboard)
  mobileCards.forEach((card) => {
    const fid = card.getAttribute('data-field-id');
    if (!fid) return;

    card.addEventListener('click', () => selectField(fid));
    card.addEventListener('keydown', (e: any) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectField(fid);
      }
    });
  });

  // Mobile Collapsible Snippet Toggles
  document.querySelectorAll('.btn-toggle-snippet').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const targetId = btn.getAttribute('data-target');
      if (targetId) {
        const panel = document.getElementById(targetId);
        panel?.classList.toggle('hidden');
      }
    });
  });

  // Individual Field Confirmation Toggle
  document.querySelectorAll('.btn-confirm').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const fid = btn.getAttribute('data-id');
      if (!fid) return;

      const f = fields.find((x) => x.id === fid);
      if (!f) return;

      if (f.reviewStatus === 'confirmed' || f.reviewStatus === 'corrected') {
        f.reviewStatus = 'unreviewed';
        showToast(`Unconfirmed ${f.name}`);
      } else {
        f.reviewStatus = 'confirmed';
        showToast(`Confirmed ${f.name} (Reviewed by user)`);
      }

      renderFieldDOM(fid);
      updateProgress();
      selectField(fid);
    });
  });

  // Bulk Confirmation Modal Handlers
  function openBulkModal() {
    bulkConfirmModal?.classList.remove('hidden');
    bulkModalConfirm?.focus();
  }

  function closeBulkModal() {
    bulkConfirmModal?.classList.add('hidden');
    btnConfirmAll?.focus();
  }

  btnConfirmAll?.addEventListener('click', openBulkModal);
  bulkModalClose?.addEventListener('click', closeBulkModal);
  bulkModalCancel?.addEventListener('click', closeBulkModal);

  bulkModalConfirm?.addEventListener('click', () => {
    fields.forEach((f) => {
      if (f.reviewStatus !== 'corrected') {
        f.reviewStatus = 'confirmed';
      }
      // Note: optical flags (f.isUncertain) are strictly PRESERVED
      renderFieldDOM(f.id);
    });
    updateProgress();
    closeBulkModal();
    showToast(`All ${fields.length} fields marked as reviewed by user.`);
  });

  // Reset to Original Fixture Baseline
  btnResetDemo?.addEventListener('click', () => {
    fields = JSON.parse(JSON.stringify(initialFieldData));
    fields.forEach((f) => renderFieldDOM(f.id));
    updateProgress();
    applyFilter('all');
    selectField('f-hemoglobin');
    showToast('Reset all 8 fields to initial fixture baseline.');
  });

  // Edit Modal Dialog Handling
  let lastFocusedElement: HTMLElement | null = null;

  document.querySelectorAll('.btn-edit').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      lastFocusedElement = btn as HTMLElement;
      const fid = btn.getAttribute('data-id');
      if (!fid) return;

      const f = fields.find((x) => x.id === fid);
      if (!f) return;

      if (editFieldId) editFieldId.value = f.id;
      if (editValueInput) editValueInput.value = String(f.currentValue);
      if (editUnitInput) editUnitInput.value = f.unit;
      if (editReasonInput) editReasonInput.value = f.correctionAudit?.reason || '';
      if (originalValChip) originalValChip.textContent = `${f.originalValue} ${f.unit}`;
      if (editValidationError) editValidationError.classList.add('hidden');

      const title = document.getElementById('edit-dialog-title');
      if (title) title.textContent = `Correct: ${f.name}`;

      editModal?.classList.remove('hidden');
      editValueInput?.focus();
    });
  });

  function closeEditModal() {
    editModal?.classList.add('hidden');
    lastFocusedElement?.focus();
  }

  modalClose?.addEventListener('click', closeEditModal);
  modalCancel?.addEventListener('click', closeEditModal);

  // Close on Escape
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (!editModal?.classList.contains('hidden')) {
        closeEditModal();
      }
      if (!bulkConfirmModal?.classList.contains('hidden')) {
        closeBulkModal();
      }
    }
  });

  // Submit edit form with validation
  editForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fid = editFieldId?.value;
    const newValRaw = editValueInput?.value?.trim();
    const newUnit = editUnitInput?.value?.trim() || '';
    const reason = editReasonInput?.value?.trim() || 'Manual user verification';

    if (!fid || !newValRaw) {
      if (editValidationError && editErrorText) {
        editErrorText.textContent = 'Measurement value cannot be empty.';
        editValidationError.classList.remove('hidden');
      }
      return;
    }

    const f = fields.find((x) => x.id === fid);
    if (!f) return;

    // Check if numeric field
    const parsedNum = parseFloat(newValRaw);
    if (typeof f.originalValue === 'number' && isNaN(parsedNum)) {
      if (editValidationError && editErrorText) {
        editErrorText.textContent = 'Please enter a valid numeric value for this laboratory test.';
        editValidationError.classList.remove('hidden');
      }
      return;
    }

    const finalVal = typeof f.originalValue === 'number' ? parsedNum : newValRaw;

    // Apply correction
    f.currentValue = finalVal;
    f.unit = newUnit;
    f.currentInterpretation = evaluateValue(finalVal, f.refLow, f.refHigh);
    f.reviewStatus = 'corrected';
    f.isUncertain = false;
    f.correctionAudit = { reason, timestamp: new Date().toISOString() };

    renderFieldDOM(fid);
    updateProgress();
    selectField(fid);
    closeEditModal();
    showToast(`Saved correction for ${f.name} (${finalVal} ${newUnit}).`);
  });

  // Language Tabs
  langEn?.addEventListener('click', () => {
    langEn.classList.add('bg-white', 'text-aura-text', 'shadow-2xs');
    langEn.classList.remove('text-aura-text-muted');
    langTe?.classList.remove('bg-white', 'text-aura-text', 'shadow-2xs');
    langTe?.classList.add('text-aura-text-muted');
    summaryEn?.classList.remove('hidden');
    summaryTe?.classList.add('hidden');
  });

  langTe?.addEventListener('click', () => {
    langTe.classList.add('bg-white', 'text-aura-text', 'shadow-2xs');
    langTe.classList.remove('text-aura-text-muted');
    langEn?.classList.remove('bg-white', 'text-aura-text', 'shadow-2xs');
    langEn?.classList.add('text-aura-text-muted');
    summaryTe?.classList.remove('hidden');
    summaryEn?.classList.add('hidden');
  });

  // Initial selection
  selectField('f-hemoglobin');
  updateProgress();
</script>
