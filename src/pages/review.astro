---
import {
  ClipboardCheck,
  AlertTriangle,
  Search,
  FileText,
  X,
  Edit3,
  Check,
  RotateCcw,
  CheckCheck,
  Eye,
  Info,
  SlidersHorizontal,
  ChevronDown,
  ShieldCheck,
  ExternalLink,
  ArrowRight,
  MessageSquare,
} from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import {
  SYNTHETIC_LAB_REPORT_FIXTURE,
  SYNTHETIC_REPORT_STATS,
} from '../fixtures/synthetic-lab-report';

const doc = SYNTHETIC_LAB_REPORT_FIXTURE;
const uncertainCount = SYNTHETIC_REPORT_STATS.uncertainFieldsCount;
const outOfRangeCount = SYNTHETIC_REPORT_STATS.outOfRangeCount;
const totalCount = SYNTHETIC_REPORT_STATS.totalFieldsCount;
---

<Layout title="Report Review" subtext="Interactive field verification & provenance inspection">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-aura-text-muted mb-2">
      <a href="/" class="hover:text-aura-text transition">Dashboard</a>
      <span>/</span>
      <a href="/records" class="hover:text-aura-text transition">Records</a>
      <span>/</span>
      <span class="text-aura-text font-semibold">Report Review</span>
    </nav>

    <!-- Genuine Empty State (Displayed by default in normal user flow) -->
    <div id="review-empty-state" class="bg-aura-surface rounded-aura-panel border border-aura-border/40 shadow-aura-card p-8 sm:p-12 text-center space-y-4 max-w-2xl mx-auto my-8">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-aura-surface-cream text-aura-text-muted flex items-center justify-center shadow-2xs border border-black/5">
        <ClipboardCheck class="w-8 h-8 text-aura-accent-orange" stroke-width={1.8} />
      </div>
      <div class="space-y-1.5">
        <h2 class="text-xl font-serif font-normal text-aura-text">
          No Document Staged for Review
        </h2>
        <p class="text-xs sm:text-sm text-aura-text-muted leading-relaxed max-w-lg mx-auto">
          There are currently no pending laboratory reports or clinical documents to review in your vault. When documents are uploaded and processed in upcoming milestones, extracted parameters and optical snippets will appear here for verification.
        </p>
      </div>
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/dashboard"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-aura-action hover:bg-aura-action-hover text-white text-xs sm:text-sm font-semibold shadow-xs transition"
        >
          <span>Return to Workspace</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
        <a
          href="/copilot"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-aura-surface-cream hover:bg-aura-surface-cream-light text-aura-text text-xs sm:text-sm font-semibold border border-black/5 transition"
        >
          <MessageSquare class="w-4 h-4 text-aura-accent-orange" />
          <span>Ask Health Copilot</span>
        </a>
      </div>
    </div>

    <!-- Active Document Verification View (Hidden by default in normal flow) -->
    <div id="review-viewer-container" class="hidden space-y-6">
      <!-- 1. Action Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2 border-b border-aura-border/30">
      <div>
        <nav class="flex items-center gap-2 text-xs text-aura-text-muted mb-2">
          <a href="/" class="hover:text-aura-text transition">Dashboard</a>
          <span>/</span>
          <a href="/records" class="hover:text-aura-text transition">Records</a>
          <span>/</span>
          <span class="text-aura-text font-semibold">Report Review</span>
        </nav>
        <h1 class="text-2xl sm:text-3xl font-serif font-normal text-aura-text tracking-tight flex items-center gap-2.5">
          <ClipboardCheck class="w-6 h-6 text-aura-accent-orange" stroke-width={2} />
          <span>Review Extracted Findings</span>
        </h1>
        <p class="text-aura-text-muted text-xs sm:text-sm mt-1 max-w-2xl leading-relaxed">
          Verify extracted laboratory readings against the source document slip. Inspect source bounding boxes and confirm readings before saving to your timeline.
        </p>
      </div>

      <!-- Action buttons -->
      <div class="flex flex-wrap items-center gap-2.5">
        <button
          id="btn-confirm-all"
          type="button"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs sm:text-sm shadow-xs transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500"
          title="Open confirmation dialog to mark all remaining fields as reviewed by user"
        >
          <CheckCheck class="w-4 h-4" stroke-width={2} />
          <span>Confirm All Fields</span>
        </button>
        <button
          id="btn-reset-demo"
          type="button"
          class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-full bg-white hover:bg-aura-surface-blush text-aura-text font-medium text-xs sm:text-sm border border-aura-border transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-aura-sidebar"
        >
          <RotateCcw class="w-3.5 h-3.5 text-aura-text-muted" stroke-width={2} />
          <span>Reset to Original</span>
        </button>
      </div>
    </div>

    <!-- 2. Compact Hierarchy Strip: Document Info + Real-Time Review Progress + Interactive Filter Chips -->
    <div class="bg-aura-surface rounded-aura-panel border border-aura-border/40 shadow-aura-card p-4 sm:p-5 space-y-4">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <!-- Document summary badge & facility -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs">
          <span class="px-2.5 py-1 rounded-full font-bold bg-aura-surface-cream text-aura-text border border-black/5 text-[11px] uppercase tracking-wider">
            CBC & Metabolic Panel
          </span>
          <span class="font-bold text-aura-text">{doc.fileName}</span>
          <span class="text-aura-text-subtle hidden sm:inline">•</span>
          <span class="text-aura-text-muted">{doc.facilityName}</span>
          <span class="text-aura-text-subtle hidden sm:inline">•</span>
          <span class="text-aura-text-subtle font-mono text-[11px]">{doc.documentDate}</span>
        </div>

        <!-- Filter Chips: All, Optical Flags, Out of Range -->
        <div class="flex items-center gap-1.5 text-xs">
          <span class="text-aura-text-subtle text-[11px] uppercase font-bold mr-1 hidden sm:inline">Filter:</span>
          <button
            type="button"
            id="filter-all"
            class="filter-chip px-3 py-1 rounded-full text-xs font-semibold bg-aura-sidebar text-white transition cursor-pointer shadow-2xs"
            data-filter="all"
          >
            All Fields ({totalCount})
          </button>
          <button
            type="button"
            id="filter-uncertain"
            class="filter-chip px-3 py-1 rounded-full text-xs font-semibold bg-white text-aura-text border border-aura-border hover:bg-aura-surface-blush transition cursor-pointer flex items-center gap-1"
            data-filter="uncertain"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-aura-accent-orange"></span>
            <span>Optical Flags ({uncertainCount})</span>
          </button>
          <button
            type="button"
            id="filter-out-of-range"
            class="filter-chip px-3 py-1 rounded-full text-xs font-semibold bg-white text-aura-text border border-aura-border hover:bg-aura-surface-blush transition cursor-pointer flex items-center gap-1"
            data-filter="out-of-range"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
            <span>Out of Range ({outOfRangeCount})</span>
          </button>
        </div>
      </div>

      <!-- Real-Time Progress Bar (Derived strictly from user review state) -->
      <div class="space-y-1.5 pt-1 border-t border-aura-border/30">
        <div class="flex justify-between text-xs font-medium text-aura-text">
          <span id="review-status-label" class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Review Progress: 0 of {totalCount} fields reviewed</span>
          </span>
          <span id="review-percentage" class="font-bold text-emerald-800">0% Reviewed by User</span>
        </div>
        <div class="w-full bg-aura-border/50 rounded-full h-2 overflow-hidden">
          <div id="review-bar" class="bg-emerald-600 h-2 rounded-full transition-all duration-300 w-[0%]"></div>
        </div>
      </div>
    </div>

    <!-- 3. Main Review Section: Primary Clinical Fields (Left) + Provenance Inspector & Summary (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
      <!-- Left Column (~65% width / 8 cols): Primary Extracted Clinical Fields -->
      <div class="lg:col-span-8 space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <h2 class="text-lg font-serif font-normal text-aura-text">
              Clinical Parameter Findings
            </h2>
            <span id="active-filter-badge" class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-aura-surface-blush text-aura-text border border-aura-border/60">
              Showing All {totalCount}
            </span>
          </div>
          <span class="text-xs text-aura-text-muted hidden sm:inline">
            Click or tap any parameter to inspect provenance snippet
          </span>
        </div>

        <!-- 3A. Desktop / Tablet Table View (hidden on mobile) -->
        <div class="hidden md:block bg-aura-surface rounded-aura-panel border border-aura-border/40 shadow-aura-card overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs sm:text-sm">
              <thead>
                <tr class="bg-aura-surface-blush border-b border-aura-border text-aura-text font-semibold text-xs uppercase tracking-wider">
                  <th class="py-3.5 px-4 w-1/3">Test Parameter</th>
                  <th class="py-3.5 px-4 w-1/5">Extracted Value</th>
                  <th class="py-3.5 px-4 w-1/5">Reference Range</th>
                  <th class="py-3.5 px-4 w-1/6">Status & Flag</th>
                  <th class="py-3.5 px-4 text-right w-1/6">Actions</th>
                </tr>
              </thead>
              <tbody id="fields-table-body" class="divide-y divide-aura-border/40">
                {doc.fields.map((field) => (
                  <tr
                    id={`row-${field.id}`}
                    tabindex="0"
                    role="button"
                    aria-label={`Select ${field.name} to view source document provenance`}
                    class={`cursor-pointer transition-all select-none focus:outline-none focus:ring-2 focus:ring-aura-accent-orange/70 ${
                      field.isUncertain
                        ? 'bg-amber-50/40 hover:bg-amber-50/70 border-l-4 border-l-aura-accent-orange'
                        : 'hover:bg-aura-surface-blush/60'
                    }`}
                    data-field-id={field.id}
                    data-is-uncertain={field.isUncertain ? 'true' : 'false'}
                    data-interpretation={field.interpretation}
                    data-raw-snippet={field.provenance.rawSnippet}
                    data-page={field.provenance.page}
                    data-name={field.name}
                    data-val={field.value}
                    data-unit={field.unit || ''}
                    data-ref={field.referenceRange?.text || 'Not reported'}
                  >
                    <!-- Test Parameter -->
                    <td class="py-3.5 px-4">
                      <div class="font-bold text-aura-text flex items-center gap-1.5">
                        <span>{field.name}</span>
                        {field.isUncertain && (
                          <span
                            class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-aura-accent-orange/15 text-aura-accent-orange border border-aura-accent-orange/30"
                            title={field.uncertaintyReason || 'Low optical confidence'}
                          >
                            <AlertTriangle class="w-2.5 h-2.5 shrink-0" stroke-width={2} />
                            <span>Flagged</span>
                          </span>
                        )}
                      </div>
                      <div class="text-[11px] text-aura-text-muted">{field.category}</div>
                    </td>

                    <!-- Extracted Value -->
                    <td class="py-3.5 px-4 font-mono">
                      <div>
                        <span id={`val-display-${field.id}`} class="font-bold text-aura-text text-sm">
                          {field.value}
                        </span>
                        <span id={`unit-display-${field.id}`} class="text-aura-text-muted text-xs ml-1">
                          {field.unit || ''}
                        </span>
                      </div>
                      <span id={`edited-audit-${field.id}`} class="hidden text-[10px] font-sans font-medium text-indigo-700 block mt-0.5">
                        Edited by User
                      </span>
                    </td>

                    <!-- Reference Range -->
                    <td class="py-3.5 px-4 text-aura-text-muted font-mono text-xs">
                      {field.referenceRange?.text || 'Not reported'}
                    </td>

                    <!-- Status & Flag -->
                    <td class="py-3.5 px-4">
                      <div class="flex flex-col gap-1 items-start">
                        <!-- Flag Badge -->
                        <span
                          id={`flag-${field.id}`}
                          class={`px-2 py-0.5 rounded-full text-[11px] font-semibold ${
                            field.interpretation === 'low'
                              ? 'bg-aura-accent-peach text-aura-text'
                              : field.interpretation === 'high'
                              ? 'bg-rose-100 text-rose-800'
                              : 'bg-emerald-100 text-emerald-800'
                          }`}
                        >
                          {field.interpretation.toUpperCase()}
                        </span>

                        <!-- Review status badge -->
                        <span
                          id={`review-badge-${field.id}`}
                          class="text-[10px] font-medium text-aura-text-muted"
                        >
                          Unreviewed
                        </span>
                      </div>
                    </td>

                    <!-- Actions -->
                    <td class="py-3.5 px-4 text-right">
                      <div class="inline-flex items-center gap-1.5" onclick="event.stopPropagation();">
                        <button
                          type="button"
                          class="btn-edit inline-flex items-center gap-1 px-2.5 py-1 text-xs rounded-full border border-aura-border hover:bg-aura-surface-blush font-medium text-aura-text focus:outline-none focus:ring-2 focus:ring-aura-sidebar cursor-pointer"
                          data-id={field.id}
                          data-name={field.name}
                          data-val={field.value}
                          data-unit={field.unit || ''}
                          aria-label={`Edit ${field.name}`}
                        >
                          <Edit3 class="w-3 h-3 text-aura-text-muted" stroke-width={2} />
                          <span>Edit</span>
                        </button>
                        <button
                          type="button"
                          class="btn-confirm inline-flex items-center gap-1 px-2.5 py-1 text-xs rounded-full bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 font-medium focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
                          data-id={field.id}
                          aria-label={`Confirm ${field.name}`}
                        >
                          <Check class="w-3 h-3 text-emerald-700" stroke-width={2.2} />
                          <span id={`btn-confirm-text-${field.id}`}>Confirm</span>
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3B. Mobile Stacked Card View (block on mobile, hidden on md+) -->
        <div id="mobile-fields-list" class="block md:hidden space-y-3">
          {doc.fields.map((field) => (
            <div
              id={`mobile-card-${field.id}`}
              tabindex="0"
              role="button"
              aria-label={`Select ${field.name} to view source document provenance`}
              class={`bg-aura-surface rounded-2xl p-4 border border-aura-border/50 shadow-2xs space-y-3 cursor-pointer transition select-none focus:outline-none focus:ring-2 focus:ring-aura-accent-orange ${
                field.isUncertain ? 'bg-amber-50/40 border-l-4 border-l-aura-accent-orange' : ''
              }`}
              data-field-id={field.id}
              data-is-uncertain={field.isUncertain ? 'true' : 'false'}
              data-interpretation={field.interpretation}
              data-raw-snippet={field.provenance.rawSnippet}
              data-page={field.provenance.page}
              data-name={field.name}
              data-val={field.value}
              data-unit={field.unit || ''}
            >
              <!-- Card Top Header -->
              <div class="flex items-start justify-between gap-2">
                <div>
                  <div class="font-bold text-sm text-aura-text flex items-center gap-1.5">
                    <span>{field.name}</span>
                    {field.isUncertain && (
                      <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-aura-accent-orange/15 text-aura-accent-orange">
                        <AlertTriangle class="w-2.5 h-2.5 shrink-0" stroke-width={2} />
                        <span>Flagged</span>
                      </span>
                    )}
                  </div>
                  <div class="text-[11px] text-aura-text-muted">{field.category}</div>
                </div>

                <!-- Interpretation Flag -->
                <span
                  id={`mobile-flag-${field.id}`}
                  class={`px-2 py-0.5 rounded-full text-[10.5px] font-semibold shrink-0 ${
                    field.interpretation === 'low'
                      ? 'bg-aura-accent-peach text-aura-text'
                      : field.interpretation === 'high'
                      ? 'bg-rose-100 text-rose-800'
                      : 'bg-emerald-100 text-emerald-800'
                  }`}
                >
                  {field.interpretation.toUpperCase()}
                </span>
              </div>

              <!-- Measurement Details Box -->
              <div class="grid grid-cols-2 gap-2 p-3 rounded-xl bg-aura-surface-blush/80 border border-aura-border/40 text-xs">
                <div>
                  <span class="text-aura-text-subtle block text-[10px] font-semibold uppercase">Extracted Value</span>
                  <div class="font-bold font-mono text-aura-text text-sm">
                    <span id={`mobile-val-display-${field.id}`}>{field.value}</span>
                    <span id={`mobile-unit-display-${field.id}`} class="text-xs text-aura-text-muted ml-0.5">{field.unit || ''}</span>
                  </div>
                  <span id={`mobile-edited-audit-${field.id}`} class="hidden text-[10px] font-sans font-medium text-indigo-700 block mt-0.5">
                    Edited by User
                  </span>
                </div>
                <div>
                  <span class="text-aura-text-subtle block text-[10px] font-semibold uppercase">Reference Range</span>
                  <span class="font-mono text-aura-text-muted text-xs block mt-0.5">
                    {field.referenceRange?.text || 'Not reported'}
                  </span>
                </div>
              </div>

              <!-- Touchscreen Provenance Snippet Toggle -->
              <div class="space-y-1.5 pt-1">
                <button
                  type="button"
                  class="btn-toggle-snippet text-[11px] font-semibold text-aura-accent-orange hover:underline inline-flex items-center gap-1 cursor-pointer py-1"
                  data-target={`snippet-panel-${field.id}`}
                  onclick="event.stopPropagation();"
                >
                  <Eye class="w-3.5 h-3.5" stroke-width={2} />
                  <span>Inspect Source OCR Slip Region</span>
                </button>
                <div
                  id={`snippet-panel-${field.id}`}
                  class="hidden bg-aura-sidebar-deep rounded-xl p-3 font-mono text-xs text-emerald-300 space-y-1 transition"
                >
                  <div class="text-[9.5px] text-aura-sidebar-text uppercase tracking-widest border-b border-white/10 pb-1">
                    Raw Document Text (Page {field.provenance.page})
                  </div>
                  <div class="whitespace-pre-wrap leading-relaxed text-[11px]">
                    {field.provenance.rawSnippet}
                  </div>
                </div>
              </div>

              <!-- Mobile Card Footer Actions (Min 44px touch targets) -->
              <div class="flex items-center justify-between pt-2 border-t border-aura-border/40" onclick="event.stopPropagation();">
                <span id={`mobile-review-badge-${field.id}`} class="text-[11px] font-medium text-aura-text-muted">
                  Unreviewed
                </span>
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    class="btn-edit min-h-[44px] px-3.5 py-2 text-xs rounded-full border border-aura-border hover:bg-aura-surface-blush font-medium text-aura-text cursor-pointer flex items-center gap-1 focus:ring-2 focus:ring-aura-sidebar"
                    data-id={field.id}
                    data-name={field.name}
                    data-val={field.value}
                    data-unit={field.unit || ''}
                    aria-label={`Edit ${field.name}`}
                  >
                    <Edit3 class="w-3.5 h-3.5 text-aura-text-muted" stroke-width={2} />
                    <span>Edit</span>
                  </button>
                  <button
                    type="button"
                    class="btn-confirm min-h-[44px] px-4 py-2 text-xs rounded-full bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 font-medium cursor-pointer flex items-center gap-1 focus:ring-2 focus:ring-emerald-500"
                    data-id={field.id}
                    aria-label={`Confirm ${field.name}`}
                  >
                    <Check class="w-3.5 h-3.5 text-emerald-700" stroke-width={2.2} />
                    <span id={`mobile-btn-confirm-text-${field.id}`}>Confirm</span>
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column (~35% width / 4 cols): Provenance Inspector & Grounded Summary -->
      <div class="lg:col-span-4 space-y-6">
        <!-- 1. Source Document Provenance Inspector Box -->
        <div class="bg-aura-surface rounded-aura-panel border border-aura-border/40 shadow-aura-card p-5 space-y-3 sticky top-6">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-serif font-bold text-aura-text flex items-center gap-1.5">
              <Search class="w-4 h-4 text-aura-accent-orange" stroke-width={2} />
              <span>Source Provenance Inspector</span>
            </h3>
            <span id="inspector-page-badge" class="text-[11px] font-mono text-aura-text-subtle">Page 1</span>
          </div>

          <p class="text-xs text-aura-text-muted leading-relaxed">
            Active parameter snippet mapped from the source document slip:
          </p>

          <!-- Terminal Preview Box -->
          <div class="bg-aura-sidebar-deep rounded-xl p-3.5 font-mono text-xs text-aura-sidebar-active space-y-1">
            <div id="inspector-label" class="text-[10px] text-aura-sidebar-text uppercase tracking-widest border-b border-white/10 pb-1">
              Raw Extracted Text • Hemoglobin
            </div>
            <div id="inspector-snippet" class="whitespace-pre-wrap leading-relaxed text-emerald-300">
              Hemoglobin ................... 11.2 g/dL (Ref: 12.0 - 15.5)
            </div>
          </div>

          <div class="text-[11px] text-aura-text-muted flex items-center justify-between pt-1">
            <span>Coordinates: <strong id="inspector-box" class="font-mono text-aura-text">Top: 18%, Left: 12%</strong></span>
            <span id="inspector-status-badge" class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
              High Confidence
            </span>
          </div>

          <div class="bg-aura-surface-blush/80 rounded-xl p-2.5 text-[10.5px] text-aura-text-muted border border-aura-border/50">
            <strong>Touch/Keyboard Tip:</strong> Click any row, tap any card, or use Tab + Enter to inspect its bounding coordinates.
          </div>
        </div>

        <!-- 2. Grounded Evidence Summary Box with English / Telugu toggle -->
        <div class="bg-aura-surface rounded-aura-panel border border-aura-border/40 shadow-aura-card p-5 space-y-4">
          <div class="flex items-center justify-between border-b border-aura-border/60 pb-3">
            <h3 class="text-sm font-serif font-bold text-aura-text flex items-center gap-1.5">
              <FileText class="w-4 h-4 text-aura-accent-orange" stroke-width={2} />
              <span>Grounded Explanation</span>
            </h3>
            <!-- Language Toggle -->
