---
import {
  Calendar,
  Clock,
  ArrowRight,
  MessageSquare,
  ShieldCheck,
} from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Health Timeline" subtext="Chronological longitudinal health history">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2 border-b border-aura-border/30">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-aura-surface-cream text-aura-text border border-black/5">
          <Calendar class="w-3.5 h-3.5 text-aura-accent-orange" stroke-width={2} />
          <span>Longitudinal Health History</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-serif font-normal text-aura-text tracking-tight">
          Health Timeline
        </h1>
        <p class="text-aura-text-muted text-xs sm:text-sm max-w-2xl leading-relaxed">
          Chronological record of verified lab tests, vital measurements, and clinical encounters.
          Observations are tenant-isolated and protected by PostgreSQL Row Level Security.
        </p>
      </div>

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-aura-surface border border-aura-border/60 text-xs text-aura-text shrink-0 shadow-2xs self-start md:self-auto">
        <ShieldCheck class="w-4 h-4 text-emerald-600" stroke-width={2} />
        <span class="font-medium">Tenant Isolation Active</span>
      </div>
    </div>

    <!-- Timeline Content Shell -->
    <div id="timeline-container" class="space-y-6">
      <!-- 0. Timeline Skeleton (Shown while checking session and loading records) -->
      <div id="timeline-skeleton" class="space-y-4 max-w-2xl mx-auto py-4">
        <div class="flex items-start gap-4">
          <div class="flex flex-col items-center">
            <div class="w-8 h-8 rounded-full skeleton-shimmer"></div>
            <div class="w-0.5 h-16 bg-aura-border/70 my-1"></div>
          </div>
          <div class="flex-1 bg-white p-5 rounded-2xl border border-aura-border/60 shadow-aura-card space-y-3">
            <div class="flex items-center justify-between">
              <div class="h-4 w-40 rounded-md skeleton-shimmer"></div>
              <div class="h-4 w-24 rounded-full skeleton-shimmer"></div>
            </div>
            <div class="h-3 w-56 rounded-md skeleton-shimmer"></div>
            <div class="h-3 w-full rounded-md skeleton-shimmer"></div>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="flex flex-col items-center">
            <div class="w-8 h-8 rounded-full skeleton-shimmer"></div>
          </div>
          <div class="flex-1 bg-white p-5 rounded-2xl border border-aura-border/60 shadow-aura-card space-y-3">
            <div class="flex items-center justify-between">
              <div class="h-4 w-36 rounded-md skeleton-shimmer"></div>
              <div class="h-4 w-20 rounded-full skeleton-shimmer"></div>
            </div>
            <div class="h-3 w-48 rounded-md skeleton-shimmer"></div>
          </div>
        </div>
      </div>

      <!-- 1. Genuine Empty State for accounts without confirmed records -->
      <div id="timeline-empty-state" class="hidden bg-aura-surface rounded-aura-panel border border-aura-border/40 shadow-aura-card p-8 sm:p-12 text-center space-y-4 max-w-2xl mx-auto">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-aura-surface-cream text-aura-text-muted flex items-center justify-center shadow-2xs border border-black/5">
          <Clock class="w-8 h-8 text-aura-accent-orange" stroke-width={1.8} />
        </div>
        <div class="space-y-1.5">
          <h2 class="text-xl font-serif font-normal text-aura-text">
            Your Health Timeline is Empty
          </h2>
          <p class="text-xs sm:text-sm text-aura-text-muted leading-relaxed max-w-lg mx-auto">
            No longitudinal observations, laboratory panels, or clinical encounters have been recorded yet. Once medical documents are uploaded and confirmed in your vault, chronological trends and comparative charts will appear here.
          </p>
        </div>
        <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/dashboard"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-aura-action hover:bg-aura-action-hover text-white text-xs sm:text-sm font-semibold shadow-xs transition"
          >
            <span>Return to Dashboard</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
          <a
            href="/copilot"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-aura-surface-cream hover:bg-aura-surface-cream-light text-aura-text text-xs sm:text-sm font-semibold border border-black/5 transition"
          >
            <MessageSquare class="w-4 h-4 text-aura-accent-orange" />
            <span>Ask Health Copilot</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { getSupabaseClient, isSupabaseConfigured } from '../lib/supabase/client';

  async function checkTimelineRecords() {
    const skeletonEl = document.getElementById('timeline-skeleton');
    const emptyStateEl = document.getElementById('timeline-empty-state');
    const supabase = getSupabaseClient();

    if (!supabase || !isSupabaseConfigured) {
      if (skeletonEl) skeletonEl.classList.add('hidden');
      if (emptyStateEl) emptyStateEl.classList.remove('hidden');
      return;
    }

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session?.access_token) {
        const res = await fetch('/api/vault/documents', {
          headers: {
            Authorization: `Bearer ${session.access_token}`,
          },
        });
        if (res.ok) {
          const data = await res.json();
          const docs = data.documents || [];
          if (skeletonEl) skeletonEl.classList.add('hidden');
          if (docs.length > 0) {
            const container = document.getElementById('timeline-container');
            if (container) {
              container.innerHTML = `
                <div class="bg-aura-surface rounded-aura-panel border border-aura-border/40 shadow-aura-card p-6 space-y-4">
                  <div class="flex items-center justify-between pb-3 border-b border-aura-border/40">
                    <h2 class="text-base font-serif font-normal text-aura-text">Stored Document Encounters (${docs.length})</h2>
                    <span class="text-xs px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 font-semibold">
                      Authenticated Vault
                    </span>
                  </div>
                  <div class="divide-y divide-aura-border/40">
                    ${docs.map((d: any) => `
                      <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div>
                          <div class="text-xs font-bold text-aura-text">${d.original_filename_sanitized || 'Health Document'}</div>
                          <div class="text-[11px] text-aura-text-muted">${d.source_facility || 'Clinical Facility'} • ${d.document_date || new Date(d.created_at).toLocaleDateString()}</div>
                        </div>
                        <span class="text-[10px] px-2 py-0.5 rounded-full font-semibold bg-aura-surface-cream text-aura-text border border-black/5 self-start sm:self-auto">
                          ${d.is_synthetic_demo ? 'Synthetic Demo' : 'Stored Document'}
                        </span>
                      </div>
                    `).join('')}
                  </div>
                </div>
              `;
            }
          } else {
            if (emptyStateEl) emptyStateEl.classList.remove('hidden');
          }
        } else {
          if (skeletonEl) skeletonEl.classList.add('hidden');
          if (emptyStateEl) emptyStateEl.classList.remove('hidden');
        }
      } else {
        if (skeletonEl) skeletonEl.classList.add('hidden');
        if (emptyStateEl) emptyStateEl.classList.remove('hidden');
      }
    } catch {
      if (skeletonEl) skeletonEl.classList.add('hidden');
      if (emptyStateEl) emptyStateEl.classList.remove('hidden');
    }
  }

  checkTimelineRecords();
</script>
