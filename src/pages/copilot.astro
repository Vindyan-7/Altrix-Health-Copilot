---
import {
  Bot,
  ShieldAlert,
  Send,
  Sparkles,
  Pill,
  HeartPulse,
  Flame,
  Wind,
  Stethoscope,
  AlertTriangle,
  RotateCcw,
  ExternalLink,
  BookOpen,
  Info,
  CheckCircle2,
  PhoneCall,
  Clock,
  Sparkle,
} from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Guest Health Guide" subtext="Source-backed health education & emergency first aid">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8">
    <!-- Header -->
    <div class="space-y-2 pb-2 border-b border-aura-border/30">
      <nav class="flex items-center gap-2 text-xs text-aura-text-muted mb-1.5">
        <a href="/" class="hover:text-aura-text transition">Dashboard</a>
        <span>/</span>
        <span class="text-aura-text font-semibold">Guest Health Guide</span>
      </nav>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-aura-surface-cream text-aura-text border border-black/5 shadow-2xs">
        <Bot class="w-3.5 h-3.5 text-aura-accent-orange" stroke-width={2} />
        <span>Guest Mode • No Login or Records Required</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-serif font-normal text-aura-text tracking-tight">
        Altrix Guest Health Guide
      </h1>
      <p class="text-aura-text-muted text-xs sm:text-sm max-w-2xl leading-relaxed">
        Immediate, source-backed medical knowledge for common symptoms, medicine safety principles, and emergency first aid.
        Operates securely without AI keys, personal data, or sign-up.
      </p>
    </div>

    <!-- Red Flag Emergency Notice Banner (High Priority Visibility) -->
    <div class="bg-rose-50/90 border border-rose-200 rounded-2xl p-4 text-xs text-rose-950 flex items-start gap-3 shadow-2xs">
      <ShieldAlert class="w-5 h-5 text-rose-600 shrink-0 mt-0.5" stroke-width={2} />
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <strong class="font-bold text-rose-900 text-xs sm:text-sm">Emergency Warning Notice</strong>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-200 text-rose-900">
            India: 112 / 108 • US: 911
          </span>
        </div>
        <p class="text-rose-800 leading-relaxed text-[11.5px] sm:text-xs">
          If you or someone nearby is experiencing chest pain, difficulty breathing, slurred speech, or loss of consciousness, 
          call emergency services immediately. A digital assistant cannot diagnose emergencies or prescribe medicines.
        </p>
      </div>
    </div>

    <!-- Main Copilot Chat Shell -->
    <div class="bg-aura-surface rounded-aura-panel border border-aura-border/40 shadow-aura-card overflow-hidden flex flex-col min-h-[620px]">
      <!-- Shell Header: Status, Turns Counter, Language Switcher -->
      <div class="bg-aura-surface-blush border-b border-aura-border px-5 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-aura-sidebar text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-xs">
            <HeartPulse class="w-4 h-4 text-aura-accent-orange" stroke-width={2.2} />
          </div>
          <div>
            <div class="font-bold text-aura-text text-xs sm:text-sm flex items-center gap-1.5">
              <span>Altrix Health Guide</span>
              <span class="px-2 py-0.2 rounded-full text-[10px] font-semibold bg-emerald-100 text-emerald-800">
                Verified Local Knowledge
              </span>
            </div>
            <div class="text-[11px] text-aura-text-muted flex items-center gap-1">
              <span>CDC • MedlinePlus • AHA Sourced</span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <!-- Transient Guest Turn Budget Counter -->
          <div
            id="turn-counter-badge"
            class="px-2.5 py-1 rounded-full text-[11px] font-medium bg-white text-aura-text-muted border border-aura-border shadow-2xs"
            title="Normal guest conversations allow 6 turns. Emergencies bypass this limit."
          >
            Session: <strong id="remaining-turns-text" class="text-aura-text font-bold">6 turns remaining</strong>
          </div>

          <!-- Language Selector -->
          <div class="inline-flex rounded-full p-0.5 bg-white border border-aura-border text-xs font-semibold shadow-2xs">
            <button
              id="lang-btn-en"
              type="button"
              class="px-3 py-1 rounded-full bg-aura-sidebar text-white shadow-2xs transition cursor-pointer"
            >
              English
            </button>
            <button
              id="lang-btn-te"
              type="button"
              class="px-3 py-1 rounded-full text-aura-text-muted hover:text-aura-text transition cursor-pointer"
            >
              తెలుగు
            </button>
          </div>
        </div>
      </div>

      <!-- Scrollable Chat Messages Container -->
      <div id="chat-messages" class="flex-grow p-4 sm:p-6 space-y-4 overflow-y-auto max-h-[460px] bg-aura-canvas/40">
        <!-- Initial Welcome Bubble -->
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-full bg-aura-sidebar text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 shadow-xs">
            <Bot class="w-4 h-4 text-aura-accent-orange" stroke-width={2} />
          </div>
          <div class="bg-white rounded-2xl rounded-tl-xs p-4 sm:p-5 max-w-xl text-xs sm:text-sm text-aura-text space-y-3 leading-relaxed border border-aura-border/60 shadow-2xs">
            <p id="welcome-message" class="font-medium">
              Hello! I am your <strong>Altrix Guest Health Guide</strong>. You can freely ask about common symptoms, safe medicine use principles, or emergency first aid below without logging in.
            </p>
            <div class="p-3 rounded-xl bg-aura-surface-blush border border-aura-border/60 text-[11.5px] text-aura-text-muted space-y-1">
              <strong class="text-aura-text block">Clinical Boundary Notice:</strong>
              I provide curated educational information from authoritative sources (CDC, MedlinePlus, AHA). I cannot diagnose, provide personal doses, or replace clinical consultations.
            </div>
          </div>
        </div>
      </div>

      <!-- Categorized Quick-Reply Topic Dock -->
      <div class="p-4 bg-aura-surface-blush/80 border-t border-aura-border space-y-3">
        <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-aura-text-subtle">
          <span id="topic-dock-title">Guided Health Topics • Tap to explore:</span>
          <span class="text-[10px] lowercase font-normal">no records needed</span>
        </div>

        <!-- 5 Curated Categories Grid -->
        <div class="flex flex-wrap gap-2 text-xs">
          <!-- 1. Symptoms -->
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-guide="fever"
          >
            <Flame class="w-3.5 h-3.5 text-aura-accent-orange" />
            <span class="topic-chip-label">Fever Guidance</span>
          </button>
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-guide="cold-cough"
          >
            <Wind class="w-3.5 h-3.5 text-aura-accent-orange" />
            <span class="topic-chip-label">Cold & Cough</span>
          </button>
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-guide="headache"
          >
            <Stethoscope class="w-3.5 h-3.5 text-aura-accent-orange" />
            <span class="topic-chip-label">Headache / Migraine</span>
          </button>
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-guide="stomach-pain"
          >
            <HeartPulse class="w-3.5 h-3.5 text-aura-accent-orange" />
            <span class="topic-chip-label">Stomach Pain</span>
          </button>

          <!-- 2. Medicine Information -->
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-guide="medicine-info"
          >
            <Pill class="w-3.5 h-3.5 text-indigo-600" />
            <span class="topic-chip-label">Safe Medicine Use</span>
          </button>

          <!-- 3. Emergency Signs -->
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-rose-50 border border-rose-300 hover:border-rose-500 text-rose-900 font-semibold shadow-2xs transition cursor-pointer"
            data-guide="emergency-signs"
          >
            <AlertTriangle class="w-3.5 h-3.5 text-rose-600" />
            <span class="topic-chip-label">Heart Attack & Stroke Signs (112)</span>
          </button>

          <!-- 4. First Aid -->
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-300 hover:border-emerald-600 text-emerald-900 font-semibold shadow-2xs transition cursor-pointer"
            data-guide="cpr"
          >
            <HeartPulse class="w-3.5 h-3.5 text-emerald-700" />
            <span class="topic-chip-label">Hands-Only CPR Steps</span>
          </button>

          <!-- 5. General Wellness -->
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-guide="wellness"
          >
            <Sparkle class="w-3.5 h-3.5 text-aura-accent-orange" />
            <span class="topic-chip-label">Preventive Wellness</span>
          </button>
        </div>
      </div>

      <!-- Chat Input Field -->
      <div class="p-4 bg-white border-t border-aura-border">
        <form id="chat-form" class="flex gap-2">
          <input
            id="chat-input"
            type="text"
            placeholder="Type a health question, e.g. 'What are warning signs of high fever?'"
            class="flex-grow px-4 py-2.5 rounded-full border border-aura-border text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-aura-sidebar placeholder:text-aura-text-subtle bg-white"
            aria-label="Ask health question"
          />
          <button
            id="chat-submit"
            type="submit"
            class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-aura-action hover:bg-aura-action-hover text-white font-semibold text-xs sm:text-sm transition shadow-xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-aura-sidebar"
          >
            <span>Send</span>
            <Send class="w-3.5 h-3.5" stroke-width={2} />
          </button>
        </form>

        <div class="flex items-center justify-between text-[11px] text-aura-text-subtle mt-2 px-1">
          <span>Sources: MedlinePlus, CDC, American Heart Association</span>
          <button
            type="button"
            id="btn-restart-chat"
            class="hover:text-aura-text underline cursor-pointer"
          >
            Restart Session
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { routeGuestQuery, getGuideById } from '../lib/ai/guest-router';
  import type { SupportedLocale, HealthGuide } from '../data/health-guide-types';

  let currentLocale: SupportedLocale = 'en';
  let guestTurnsUsed = 0;
  const MAX_GUEST_TURNS = 6;

  const chatMessages = document.getElementById('chat-messages');
  const chatForm = document.getElementById('chat-form') as HTMLFormElement | null;
  const chatInput = document.getElementById('chat-input') as HTMLInputElement | null;
  const chatSubmit = document.getElementById('chat-submit') as HTMLButtonElement | null;
  const langBtnEn = document.getElementById('lang-btn-en');
  const langBtnTe = document.getElementById('lang-btn-te');
  const welcomeMessage = document.getElementById('welcome-message');
  const remainingTurnsText = document.getElementById('remaining-turns-text');
  const btnRestartChat = document.getElementById('btn-restart-chat');
  const topicChips = document.querySelectorAll('.topic-chip');

  function updateTurnsDisplay() {
    if (!remainingTurnsText) return;
    const remaining = Math.max(0, MAX_GUEST_TURNS - guestTurnsUsed);
    remainingTurnsText.textContent = `${remaining} turn${remaining === 1 ? '' : 's'} remaining`;

    if (remaining === 0) {
      remainingTurnsText.classList.add('text-amber-700');
    } else {
      remainingTurnsText.classList.remove('text-amber-700');
    }
  }

  function appendUserBubble(text: string) {
    if (!chatMessages) return;
    const div = document.createElement('div');
    div.className = 'flex items-start justify-end gap-3';
    div.innerHTML = `
      <div class="bg-aura-sidebar text-white rounded-2xl rounded-tr-xs p-3.5 sm:p-4 max-w-lg text-xs sm:text-sm leading-relaxed shadow-2xs">
        ${escapeHtml(text)}
      </div>
      <div class="w-7 h-7 rounded-full bg-aura-accent-purple text-aura-accent-purple-strong flex items-center justify-center font-bold text-xs shrink-0 mt-1 border border-aura-border">
        G
      </div>
    `;
    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function appendGuideBubble(guide: HealthGuide, isAlert = false) {
    if (!chatMessages) return;
    const div = document.createElement('div');
    div.className = 'flex items-start gap-3';
    const bgClass = isAlert
      ? 'bg-rose-50 border-rose-300 text-rose-950 shadow-md'
      : 'bg-white border-aura-border text-aura-text shadow-2xs';

    const warningHtml = guide.warningSigns && guide.warningSigns.length > 0
      ? `
        <div class="p-3 rounded-xl ${isAlert ? 'bg-rose-100/80 border-rose-300 text-rose-950 font-medium' : 'bg-amber-50 border-amber-200 text-amber-950'} border text-[11.5px] space-y-1">
          <strong class="flex items-center gap-1.5 font-bold text-xs ${isAlert ? 'text-rose-900' : 'text-amber-900'}">
            <span>⚠ Warning Signs:</span>
          </strong>
          <ul class="list-disc pl-4 space-y-0.5">
            ${guide.warningSigns.map((w) => `<li>${escapeHtml(w)}</li>`).join('')}
          </ul>
        </div>
      `
      : '';

    const detailsHtml = guide.details && guide.details.length > 0
      ? `
        <div class="space-y-1 text-xs sm:text-[13px] text-aura-text-muted">
          <strong class="text-aura-text block font-semibold text-xs">Self-Care & Important Considerations:</strong>
          <ul class="list-disc pl-4 space-y-1">
            ${guide.details.map((d) => `<li>${escapeHtml(d)}</li>`).join('')}
          </ul>
        </div>
      `
      : '';

    const nextStepsHtml = guide.nextSteps && guide.nextSteps.length > 0
      ? `
        <div class="space-y-1 text-xs sm:text-[13px]">
          <strong class="text-aura-text block font-semibold text-xs">Recommended Next Steps:</strong>
          <ul class="list-disc pl-4 space-y-0.5 text-aura-text-muted">
            ${guide.nextSteps.map((s) => `<li>${escapeHtml(s)}</li>`).join('')}
          </ul>
        </div>
      `
      : '';

    div.innerHTML = `
      <div class="w-8 h-8 rounded-full ${isAlert ? 'bg-rose-600' : 'bg-aura-sidebar'} text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 shadow-xs">
        ${isAlert ? '!' : '+'}
      </div>
      <div class="${bgClass} rounded-2xl rounded-tl-xs p-4 sm:p-5 max-w-xl space-y-3 leading-relaxed border">
        <div>
          <h3 class="font-serif font-bold text-base sm:text-lg text-aura-text">${escapeHtml(guide.title)}</h3>
          <p class="text-xs sm:text-[13px] text-aura-text-muted mt-1 leading-relaxed">${escapeHtml(guide.summary)}</p>
        </div>

        ${warningHtml}
        ${detailsHtml}
        ${nextStepsHtml}

        <div class="pt-2.5 border-t border-aura-border/60 flex flex-wrap items-center justify-between gap-2 text-[10.5px] text-aura-text-subtle">
          <span>Source: <a href="${guide.sourceUrl}" target="_blank" rel="noopener noreferrer" class="text-aura-accent-orange font-bold hover:underline inline-flex items-center gap-0.5">${escapeHtml(guide.sourceName)}</a></span>
          <span>Reviewed: ${guide.reviewedDate}</span>
        </div>

        <div class="p-2 rounded-lg bg-aura-surface-blush text-[10.5px] text-aura-text-subtle leading-tight">
          ${escapeHtml(guide.clinicalDisclaimer)}
        </div>
      </div>
    `;

    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function appendCustomAssistantBubble(htmlContent: string, sourceMeta: string, isAlert = false) {
    if (!chatMessages) return;
    const div = document.createElement('div');
    div.className = 'flex items-start gap-3';
    const bgClass = isAlert
      ? 'bg-rose-50 border-rose-300 text-rose-950'
      : 'bg-white border-aura-border text-aura-text shadow-2xs';

    div.innerHTML = `
      <div class="w-8 h-8 rounded-full ${isAlert ? 'bg-rose-600' : 'bg-aura-sidebar'} text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 shadow-xs">
        ${isAlert ? '!' : '+'}
      </div>
      <div class="${bgClass} rounded-2xl rounded-tl-xs p-4 sm:p-5 max-w-xl text-xs sm:text-sm space-y-2.5 leading-relaxed border">
        <div>${htmlContent}</div>
        <div class="text-[11px] text-aura-text-subtle pt-2 border-t border-aura-border/60">
          ${sourceMeta}
        </div>
      </div>
    `;

    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function escapeHtml(str: string) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function handleUserQuery(query: string) {
    const trimmed = query.trim();
    if (!trimmed) return;

    appendUserBubble(trimmed);
    if (chatInput) chatInput.value = '';

    // Route message through deterministic safety engine
    const result = routeGuestQuery(trimmed, currentLocale);

    // Emergency queries ALWAYS bypass turn counter limit
    if (result.isEmergency) {
      if (result.guide) {
        appendGuideBubble(result.guide, true);
      } else {
        appendCustomAssistantBubble(
          `<strong>Critical Emergency Medical Notice:</strong><br/><br/>
           Your symptoms suggest an urgent emergency. Please call <strong>112 / 108</strong> (India) or <strong>911</strong> (US) immediately or proceed to the nearest hospital emergency department.
           Do not wait to see if symptoms improve on their own.`,
          'American Heart Association & Emergency Response Guidelines',
          true
        );
      }
      return;
    }

    // Check normal guest turn limit
    if (guestTurnsUsed >= MAX_GUEST_TURNS) {
      appendCustomAssistantBubble(
        `<div class="space-y-2">
           <strong class="font-bold text-aura-text block">Guest Session Limit Reached:</strong>
           <p class="text-xs text-aura-text-muted leading-relaxed">
             You have reached the 6-turn guest consultation limit for this browser session. 
             You can tap <strong>Restart Session</strong> below to begin a new health guide topic, or sign in when account services become available.
           </p>
           <div class="pt-2">
             <button type="button" onclick="document.getElementById('btn-restart-chat')?.click()" class="px-4 py-2 rounded-full text-xs font-semibold bg-aura-action text-white hover:bg-aura-action-hover cursor-pointer">
               Restart Session
             </button>
           </div>
         </div>`,
        'Session Governance: 6-turn guest budget completed',
        false
      );
      return;
    }

    // Increment budget
    guestTurnsUsed++;
    updateTurnsDisplay();

    // Blocked dosage requests
    if (result.intent === 'blocked_dosage_request') {
      const dosageNotice = currentLocale === 'te'
        ? `<strong>క్లినికల్ భద్రతా నియమం:</strong><br/><br/>
           నేను లక్షణాల ఆధారంగా వ్యక్తిగత మందుల మోతాదు (డైలీ డోస్) నిర్ణయించలేను. దయచేసి మీ ప్రిస్క్రిప్షన్ లేదా మందుల ప్యాకేజీపై ఉన్న అధికారిక తయారీదారుల సూచనలను మాత్రమే పాటించండి. సందేహాలు ఉంటే మీ డాక్టర్ లేదా ఫార్మసిస్ట్‌ను సంప్రదించండి.`
        : `<strong>Clinical Safety Policy — No Individualized Dosing:</strong><br/><br/>
           "I want to help you use reliable information safely. I cannot choose a dose for you based on symptoms or adjust your medication schedule. Please follow your prescription or the medicine's official packaging instructions, and check with a licensed doctor or pharmacist if anything is unclear."`;

      appendCustomAssistantBubble(
        dosageNotice,
        'Safety Guardrail: assistant-boundaries.md • Sourced Medication Guidance'
      );

      if (result.guide) {
        appendGuideBubble(result.guide);
      }
      return;
    }

    // Curated guide matched
    if (result.matched && result.guide) {
      appendGuideBubble(result.guide);
      return;
    }

    // Unsupported query
    const unsupportedNotice = currentLocale === 'te'
      ? `<p>మీరు అడిగిన ప్రశ్న (<em>"${escapeHtml(trimmed)}"</em>) మా వద్ద ఉన్న ప్రామాణిక ఆరోగ్య మార్గదర్శకాలలో అందుబాటులో లేదు.</p>
         <p class="text-xs text-aura-text-muted mt-1.5">క్లినికల్ భద్రత దృష్ట్యా, మేము తప్పుడు లేదా నిరూపించబడని సమాచారాన్ని అందించము. దయచేసి క్రింది టాపిక్ బటన్ల నుండి ఒకదాన్ని ఎంచుకోండి లేదా వైద్యుడిని సంప్రదించండి.</p>`
      : `<p>I have received your query regarding <em>"${escapeHtml(trimmed)}"</em>. This topic is not covered in our current curated medical guide catalogue.</p>
         <p class="text-xs text-aura-text-muted mt-1.5">To preserve clinical accuracy, Altrix never fabricates unsupported medical guidance. Please explore one of our verified guides below or consult your licensed healthcare professional.</p>`;

    appendCustomAssistantBubble(
      unsupportedNotice,
      'Altrix Curated Knowledge Gateway • Strict Evidence Boundary'
    );
  }

  // Language buttons
  langBtnEn?.addEventListener('click', () => {
    currentLocale = 'en';
    langBtnEn.classList.add('bg-aura-sidebar', 'text-white', 'shadow-2xs');
    langBtnEn.classList.remove('text-aura-text-muted');
    langBtnTe?.classList.remove('bg-aura-sidebar', 'text-white', 'shadow-2xs');
    langBtnTe?.classList.add('text-aura-text-muted');
    if (welcomeMessage) {
      welcomeMessage.innerHTML = 'Hello! I am your <strong>Altrix Guest Health Guide</strong>. You can freely ask about common symptoms, safe medicine use principles, or emergency first aid below without logging in.';
    }
  });

  langBtnTe?.addEventListener('click', () => {
    currentLocale = 'te';
    langBtnTe.classList.add('bg-aura-sidebar', 'text-white', 'shadow-2xs');
    langBtnTe.classList.remove('text-aura-text-muted');
    langBtnEn?.classList.remove('bg-aura-sidebar', 'text-white', 'shadow-2xs');
    langBtnEn?.classList.add('text-aura-text-muted');
    if (welcomeMessage) {
      welcomeMessage.innerHTML = 'నమస్కారం! నేను మీ <strong>ఆల్ట్రిక్స్ హెల్త్ గైడ్</strong>. లాగిన్ లేకుండానే సాధారణ లక్షణాలు, మందుల భద్రత మరియు అత్యవసర ప్రథమ చికిత్స సమాచారాన్ని ఇక్కడ తెలుసుకోవచ్చు.';
    }
  });

  // Topic chip click handlers
  topicChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const guideId = chip.getAttribute('data-guide');
      if (!guideId) return;

      const guide = getGuideById(guideId, currentLocale);
      if (!guide) return;

      appendUserBubble(guide.title);

      if (guide.category === 'emergency') {
        appendGuideBubble(guide, true);
      } else {
        if (guestTurnsUsed < MAX_GUEST_TURNS) {
          guestTurnsUsed++;
          updateTurnsDisplay();
        }
        appendGuideBubble(guide, false);
      }
    });
  });

  // Form submit
  chatForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (chatInput) {
      handleUserQuery(chatInput.value);
    }
  });

  // Restart chat
  btnRestartChat?.addEventListener('click', () => {
    guestTurnsUsed = 0;
    updateTurnsDisplay();
    if (chatMessages) {
      chatMessages.innerHTML = '';
      const div = document.createElement('div');
      div.className = 'flex items-start gap-3';
      div.innerHTML = `
        <div class="w-8 h-8 rounded-full bg-aura-sidebar text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 shadow-xs">
          +
        </div>
        <div class="bg-white rounded-2xl rounded-tl-xs p-4 sm:p-5 max-w-xl text-xs sm:text-sm text-aura-text space-y-2 leading-relaxed border border-aura-border/60 shadow-2xs">
          <p class="font-medium">
            Session refreshed. You have 6 turns available. Select any guided topic below or type your question.
          </p>
        </div>
      `;
      chatMessages.appendChild(div);
    }
  });

  // Initialize turns counter
  updateTurnsDisplay();
</script>
