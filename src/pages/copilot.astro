---
import {
  Bot,
  ShieldAlert,
  Send,
  FileSpreadsheet,
  Pill,
  Stethoscope,
  AlertTriangle,
  ShieldBan,
  MapPin,
  Activity,
  CheckCircle2,
  Info,
} from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import { SYNTHETIC_REPORT_STATS } from '../fixtures/synthetic-lab-report';

const outOfRangeCount = SYNTHETIC_REPORT_STATS.outOfRangeCount;
const uncertainCount = SYNTHETIC_REPORT_STATS.uncertainFieldsCount;
---

<Layout title="Guided Health Copilot" subtext="Evidence-grounded assistant with clinical safety boundaries">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8">
    <!-- Header -->
    <div class="space-y-2 pb-2 border-b border-aura-border/30">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-aura-surface-cream text-aura-text border border-black/5 shadow-2xs">
        <Bot class="w-3.5 h-3.5 text-aura-accent-orange" stroke-width={2} />
        <span>Evidence-Grounded Assistant</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-serif font-normal text-aura-text tracking-tight">
        Altrix Health Copilot
      </h1>
      <p class="text-aura-text-muted text-xs sm:text-sm max-w-2xl leading-relaxed">
        Select a guided topic below or ask about your records. Our assistant uses curated medical knowledge templates,
        never guesses missing values, and strictly respects clinical safety boundaries.
      </p>
    </div>

    <!-- Safety Red Flag Banner (High Priority Visibility) -->
    <div class="bg-rose-50/80 border border-rose-200 rounded-2xl p-4 text-xs text-rose-950 flex items-start gap-3 shadow-2xs">
      <ShieldAlert class="w-5 h-5 text-rose-600 shrink-0 mt-0.5" stroke-width={2} />
      <div class="space-y-1">
        <strong class="font-bold text-rose-900">Deterministic Safety Routing Active</strong>
        <p class="text-rose-800 leading-relaxed">
          Urgent symptoms trigger immediate emergency guidance without waiting for an AI response.
          The copilot provides general health education and does not prescribe, diagnose, or formulate individualized drug doses.
        </p>
      </div>
    </div>

    <!-- Interactive Copilot Container -->
    <div class="bg-aura-surface rounded-aura-panel border border-aura-border/40 shadow-aura-card overflow-hidden flex flex-col min-h-[580px]">
      <!-- Chat Header -->
      <div class="bg-aura-surface-blush border-b border-aura-border px-6 py-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-aura-sidebar text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-xs">
            <Activity class="w-4 h-4 text-aura-accent-orange" stroke-width={2.2} />
          </div>
          <div>
            <div class="font-bold text-aura-text text-sm">Altrix Clinical Copilot</div>
            <div class="text-[11px] text-emerald-700 font-medium flex items-center gap-1.5">
              <CheckCircle2 class="w-3 h-3 text-emerald-600" stroke-width={2.2} />
              <span>Offline Verified Templates Ready</span>
            </div>
          </div>
        </div>

        <!-- Language Selector -->
        <div class="flex items-center gap-2">
          <span class="text-xs text-aura-text-muted">Language:</span>
          <div class="inline-flex rounded-full p-0.5 bg-white border border-aura-border text-xs font-semibold">
            <button
              id="chat-lang-en"
              type="button"
              class="px-2.5 py-1 rounded-full bg-aura-sidebar text-white shadow-2xs transition cursor-pointer"
            >
              English
            </button>
            <button
              id="chat-lang-te"
              type="button"
              class="px-2.5 py-1 rounded-full text-aura-text-muted hover:text-aura-text transition cursor-pointer"
            >
              తెలుగు
            </button>
          </div>
        </div>
      </div>

      <!-- Chat Messages Scroll Area -->
      <div id="chat-messages" class="flex-grow p-6 space-y-4 overflow-y-auto max-h-[420px]">
        <!-- Welcome Message from Assistant -->
        <div class="flex items-start gap-3">
          <div class="w-7 h-7 rounded-full bg-aura-sidebar text-white flex items-center justify-center font-bold text-xs shrink-0 mt-1 shadow-xs">
            <Activity class="w-3.5 h-3.5 text-aura-accent-orange" stroke-width={2} />
          </div>
          <div class="bg-aura-surface-blush rounded-2xl rounded-tl-xs p-4 max-w-xl text-xs sm:text-sm text-aura-text space-y-2 leading-relaxed border border-aura-border/40">
            <p id="welcome-text">
              "Hi, I'm here to help you understand your health information. You can explore a report, learn about a medicine in general, or organize your health history. What would you like help with today?"
            </p>
            <div class="text-[11px] text-aura-text-subtle pt-1 border-t border-aura-border/60">
              Source: Approved Response Catalog • Template #1
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Guided Topic Buttons (Grouped with Clear Prioritization) -->
      <div class="p-4 bg-aura-surface-cream/40 border-t border-aura-border space-y-3">
        <!-- Group 1: General Health Guidance (Primary) -->
        <div class="space-y-1.5">
          <div class="text-[11px] font-bold uppercase tracking-wider text-aura-text-subtle">
            Report & Health Guidance
          </div>
          <div class="flex flex-wrap gap-2">
            <button
              type="button"
              class="chip-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-aura-surface-blush text-xs font-medium text-aura-text transition cursor-pointer"
              data-intent="reports"
            >
              <FileSpreadsheet class="w-3.5 h-3.5 text-aura-accent-orange" stroke-width={2} />
              <span>Understand My Lab Report</span>
            </button>
            <button
              type="button"
              class="chip-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-aura-surface-blush text-xs font-medium text-aura-text transition cursor-pointer"
              data-intent="questions"
            >
              <Stethoscope class="w-3.5 h-3.5 text-aura-accent-orange" stroke-width={2} />
              <span>Questions to Ask My Doctor</span>
            </button>
            <button
              type="button"
              class="chip-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-aura-surface-blush text-xs font-medium text-aura-text transition cursor-pointer"
              data-intent="medicines"
            >
              <Pill class="w-3.5 h-3.5 text-aura-accent-orange" stroke-width={2} />
              <span>Medicine Information (Paracetamol)</span>
            </button>
          </div>
        </div>

        <!-- Group 2: Safety Boundary Demonstrations -->
        <div class="space-y-1.5 pt-1 border-t border-aura-border/40">
          <div class="text-[11px] font-bold uppercase tracking-wider text-rose-800">
            Safety Guardrail Demonstrations
          </div>
          <div class="flex flex-wrap gap-2">
            <button
              type="button"
              class="chip-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-rose-300 hover:border-rose-500 hover:bg-rose-50 text-xs font-medium text-rose-900 transition cursor-pointer"
              data-intent="emergency_demo"
            >
              <AlertTriangle class="w-3.5 h-3.5 text-rose-600" stroke-width={2} />
              <span>Safety Demo: Urgent Symptoms Test</span>
            </button>
            <button
              type="button"
              class="chip-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-amber-300 hover:border-amber-500 hover:bg-amber-50 text-xs font-medium text-amber-900 transition cursor-pointer"
              data-intent="dosing_demo"
            >
              <ShieldBan class="w-3.5 h-3.5 text-amber-600" stroke-width={2} />
              <span>Safety Demo: Dosage Request Test</span>
            </button>
            <button
              type="button"
              class="chip-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-aura-surface-blush text-xs font-medium text-aura-text transition cursor-pointer"
              data-intent="care_finder"
            >
              <MapPin class="w-3.5 h-3.5 text-aura-accent-orange" stroke-width={2} />
              <span>Mock Healthcare Finder (Demo Flow)</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Chat Input Area -->
      <div class="p-4 bg-white border-t border-aura-border">
        <form id="chat-form" class="flex gap-2">
          <input
            id="chat-input"
            type="text"
            placeholder="Ask about your records, e.g. 'What does elevated fasting glucose mean?'"
            class="flex-grow px-4 py-2.5 rounded-full border border-aura-border text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-aura-sidebar-active placeholder-aura-text-subtle"
          />
          <button
            type="submit"
            class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-aura-action hover:bg-aura-action-hover text-white font-semibold text-sm transition shadow-xs cursor-pointer"
          >
            <span>Send</span>
            <Send class="w-3.5 h-3.5" stroke-width={2} />
          </button>
        </form>
        <div class="text-[11px] text-aura-text-subtle text-center mt-2">
          Altrix Copilot provides educational information from verified medical knowledge sources. It does not replace medical advice.
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  let currentLocale: 'en' | 'te' = 'en';

  const chatMessages = document.getElementById('chat-messages');
  const chatForm = document.getElementById('chat-form') as HTMLFormElement | null;
  const chatInput = document.getElementById('chat-input') as HTMLInputElement | null;
  const chipButtons = document.querySelectorAll('.chip-btn');
  const chatLangEn = document.getElementById('chat-lang-en');
  const chatLangTe = document.getElementById('chat-lang-te');
  const welcomeText = document.getElementById('welcome-text');

  // Telugu / English greeting switch
  chatLangEn?.addEventListener('click', () => {
    currentLocale = 'en';
    chatLangEn.classList.add('bg-aura-sidebar', 'text-white', 'shadow-2xs');
    chatLangEn.classList.remove('text-aura-text-muted');
    chatLangTe?.classList.remove('bg-aura-sidebar', 'text-white', 'shadow-2xs');
    chatLangTe?.classList.add('text-aura-text-muted');
    if (welcomeText) {
      welcomeText.textContent = '"Hi, I\'m here to help you understand your health information. You can explore a report, learn about a medicine in general, or organize your health history. What would you like help with today?"';
    }
  });

  chatLangTe?.addEventListener('click', () => {
    currentLocale = 'te';
    chatLangTe.classList.add('bg-aura-sidebar', 'text-white', 'shadow-2xs');
    chatLangTe.classList.remove('text-aura-text-muted');
    chatLangEn?.classList.remove('bg-aura-sidebar', 'text-white', 'shadow-2xs');
    chatLangEn?.classList.add('text-aura-text-muted');
    if (welcomeText) {
      welcomeText.textContent = '"నమస్కారం, మీ ఆరోగ్య సమాచారాన్ని అర్థం చేసుకోవడంలో నేను సహాయం చేస్తాను. మీరు రిపోర్టును పరిశీలించవచ్చు, మందుల గురించి సాధారణ సమాచారం తెలుసుకోవచ్చు లేదా మీ ఆరోగ్య చరిత్రను నిర్వహించవచ్చు. ఈ రోజు మీకు ఎలా సహాయపడగలను?"';
    }
  });

  // Guided topic click handlers
  chipButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const intent = btn.getAttribute('data-intent');
      if (intent) {
        handleIntent(intent);
      }
    });
  });

  // Free text submit handler
  chatForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const query = chatInput?.value?.trim();
    if (!query) return;

    appendUserMessage(query);
    if (chatInput) chatInput.value = '';

    // Route query
    routeUserQuery(query);
  });

  function appendUserMessage(text: string) {
    if (!chatMessages) return;
    const userDiv = document.createElement('div');
    userDiv.className = 'flex items-start justify-end gap-3';
    userDiv.innerHTML = `
      <div class="bg-aura-sidebar text-white rounded-2xl rounded-tr-xs p-4 max-w-xl text-xs sm:text-sm leading-relaxed shadow-xs">
        ${escapeHtml(text)}
      </div>
      <div class="w-7 h-7 rounded-full bg-aura-accent-purple text-aura-accent-purple-strong flex items-center justify-center font-bold text-xs shrink-0 mt-1 border border-aura-border">
        PS
      </div>
    `;
    chatMessages.appendChild(userDiv);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function appendAssistantMessage(htmlContent: string, sourceMeta: string, isAlert = false) {
    if (!chatMessages) return;
    const assistantDiv = document.createElement('div');
    assistantDiv.className = 'flex items-start gap-3';
    const bgClass = isAlert ? 'bg-rose-50 border border-rose-200 text-rose-950' : 'bg-aura-surface-blush border border-aura-border/40 text-aura-text';

    assistantDiv.innerHTML = `
      <div class="w-7 h-7 rounded-full ${isAlert ? 'bg-rose-600' : 'bg-aura-sidebar'} text-white flex items-center justify-center font-bold text-xs shrink-0 mt-1 shadow-xs">
        ${isAlert ? '!' : '+'}
      </div>
      <div class="${bgClass} rounded-2xl rounded-tl-xs p-4 max-w-xl text-xs sm:text-sm space-y-2 leading-relaxed">
        <div>${htmlContent}</div>
        <div class="text-[11px] text-aura-text-subtle pt-1 border-t border-aura-border/60">
          ${sourceMeta}
        </div>
      </div>
    `;
    chatMessages.appendChild(assistantDiv);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function escapeHtml(str: string) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // Deterministic routing logic with safety layers
  function routeUserQuery(query: string) {
    const lower = query.toLowerCase();

    // 1. Conservative Emergency Red Flag Detection
    const emergencyKeywords = ['chest pain', 'heart attack', 'cannot breathe', 'difficulty breathing', 'severe bleeding', 'unconscious', 'stroke', 'emergency'];
    const isEmergency = emergencyKeywords.some((kw) => lower.includes(kw));

    if (isEmergency) {
      appendAssistantMessage(
        `<strong>Immediate Emergency Medical Notice:</strong><br/><br/>
         Your symptoms may require urgent medical evaluation. Please contact your local emergency service (e.g., <strong>108 / 112</strong> in India or <strong>911</strong> in the US) or proceed immediately to the nearest hospital emergency department.
         If possible, ask someone nearby to assist you. Altrix cannot assess emergencies through chat.`,
        'Safety Policy: emergency-red-flags.md • Deterministic Routing (No LLM called)',
        true
      );
      return;
    }

    // 2. Individualized Dosage / Treatment Request Detection
    const dosingKeywords = ['how much should i take', 'dosage', 'dose for my child', 'what dose', 'how many tablets', 'stop taking my'];
    const isDosing = dosingKeywords.some((kw) => lower.includes(kw));

    if (isDosing) {
      appendAssistantMessage(
        `"I want to help you use reliable information safely. I cannot choose a dose for you based on symptoms or adjust your medication schedule. Please follow your prescription or the medicine's official packaging instructions, and check with a doctor or pharmacist if anything is unclear. If you share the wording on your existing label, I can help explain what it says without changing it."`,
        'Safety Policy: assistant-boundaries.md • Approved Template #7',
        false
      );
      return;
    }

    // 3. Fallback educational response
    appendAssistantMessage(
      `"I have received your question regarding <em>${escapeHtml(query)}</em>. In accordance with Altrix clinical safety guidelines, I provide educational explanations grounded in your uploaded documents. You can review your lab findings directly or ask your doctor the recommended questions on the <a href='/review' class='text-aura-accent-orange font-bold underline'>Review screen</a>."`,
      'Curated Knowledge Router • Mode: Educational',
      false
    );
  }

  function handleIntent(intent: string) {
    if (intent === 'reports') {
      appendUserMessage('Can you help me understand my latest lab report?');
      if (currentLocale === 'te') {
        appendAssistantMessage(
          `మీ ఇటీవలి బ్లడ్ రిపోర్టులో 5 పారామితులు ప్రామాణిక పరిధి కంటే భిన్నంగా ఉన్నాయి: <strong>హీమోగ్లోబిన్ (11.2 g/dL)</strong>, <strong>ప్లేట్‌లెట్లు (145,000 /cumm)</strong>, <strong>ఫాస్టింగ్ బ్లడ్ షుగర్ (118 mg/dL)</strong>, <strong>HbA1c (6.2%)</strong>, మరియు <strong>TSH (5.4 uIU/mL)</strong>. పూర్తి వివరాలను పరిశీలించడానికి <a href="/review" class="text-aura-accent-orange font-bold underline">రిపోర్ట్ రివ్యూ పేజీని చూడండి</a>.`,
          'Source: Synthetic CBC Fixture • Telugu Template'
        );
      } else {
        appendAssistantMessage(
          `In your synthetic report, 5 parameters differ from laboratory reference ranges: <strong>Hemoglobin (11.2 g/dL)</strong> is slightly low, while <strong>Fasting Blood Sugar (118 mg/dL)</strong>, <strong>HbA1c (6.2%)</strong>, and <strong>TSH (5.4 uIU/mL)</strong> are elevated, and <strong>Platelet Count (145k)</strong> is slightly below baseline with optical uncertainty. You can inspect the bounding boxes and edit values on the <a href="/review" class="text-aura-accent-orange font-bold underline">Report Review Screen</a>.`,
          'Source: Synthetic CBC Fixture • Grounded Evidence'
        );
      }
    } else if (intent === 'medicines') {
      appendUserMessage('Tell me general information about Paracetamol (Acetaminophen)');
      appendAssistantMessage(
        `<strong>Paracetamol (Acetaminophen):</strong><br/>
         • <em>General Purpose:</em> A widely used analgesic (pain reliever) and antipyretic (fever reducer).<br/>
         • <em>Key Precautions:</em> Do not exceed recommended daily limits. Avoid combining multiple products containing acetaminophen to protect liver health.<br/>
         • <em>Prescription Guidance:</em> Always consult your physician or pharmacist for individualized clinical suitability.`,
        'Curated Source: knowledge/medicines/medicine-information-template.md'
      );
    } else if (intent === 'questions') {
      appendUserMessage('What questions should I ask my doctor about my test results?');
      appendAssistantMessage(
        `Here are grounded questions prepared for your next appointment:<br/>
         1. <em>"My fasting sugar is 118 mg/dL with HbA1c at 6.2%. What dietary or lifestyle modifications do you recommend at this stage?"</em><br/>
         2. <em>"My hemoglobin came in at 11.2 g/dL. Would you suggest testing ferritin or dietary iron adjustments?"</em><br/>
         3. <em>"Should my TSH level (5.4 uIU/mL) be re-tested along with a thyroid panel?"</em>`,
        'Evidence-Grounded Question Generator'
      );
    } else if (intent === 'emergency_demo') {
      appendUserMessage('I am experiencing severe chest pain and trouble breathing');
      routeUserQuery('I am experiencing severe chest pain and trouble breathing');
    } else if (intent === 'dosing_demo') {
      appendUserMessage('How many tablets of 500mg paracetamol should I give my child right now?');
      routeUserQuery('How many tablets of 500mg paracetamol should I give my child right now?');
    } else if (intent === 'care_finder') {
      appendUserMessage('Can I find healthcare nearby or book an appointment?');
      appendAssistantMessage(
        `<strong>Demo Mock Healthcare Provider Journey:</strong><br/>
         We can help locate medical clinics by PIN code or city. <br/><br/>
         <em>Demo Facility Available:</em> Metro Diagnostic & Multispeciality Clinic (5.2 km away).<br/>
         <div class="bg-aura-surface-cream p-2.5 rounded-xl border border-black/5 mt-2 text-xs text-aura-text">
           <strong>Demo Limitation Notice:</strong> This is an illustrative booking flow prototype. No real appointment has been scheduled and no clinical facility has been contacted.
         </div>`,
        'Knowledge Source: knowledge/responses/response-catalog.md • Template #11'
      );
    }
  }
</script>
