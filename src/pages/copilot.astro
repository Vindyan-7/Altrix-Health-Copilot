---
import {
  Bot,
  ShieldAlert,
  Send,
  Sparkles,
  Pill,
  HeartPulse,
  Flame,
  Wind,
  Stethoscope,
  AlertTriangle,
  RotateCcw,
  ExternalLink,
  BookOpen,
  Info,
  CheckCircle2,
  PhoneCall,
  Clock,
  Sparkle,
  ShieldCheck,
  User,
  LogIn,
  Cpu,
  MessageSquare,
} from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Health Copilot" subtext="Guided Clinical Scenarios & General Health AI Chat">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8">
    <!-- Header -->
    <div class="space-y-2 pb-2 border-b border-aura-border/30">
      <nav class="flex items-center gap-2 text-xs text-aura-text-muted mb-1.5">
        <a href="/" class="hover:text-aura-text transition">Home</a>
        <span>/</span>
        <span class="text-aura-text font-semibold">Health Copilot</span>
      </nav>
      <div class="flex flex-wrap items-center gap-2">
        <div id="session-mode-pill" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-aura-surface-cream text-aura-text border border-black/5 shadow-2xs">
          <Bot class="w-3.5 h-3.5 text-aura-accent-orange" stroke-width={2} />
          <span id="session-mode-text">Guest Mode • 40 Guided Scenarios Available</span>
        </div>
        <div id="auth-status-container" class="hidden sm:inline-flex items-center gap-1.5 text-xs text-aura-text-muted">
          <span>•</span>
          <a id="auth-link-text" href="/auth" class="hover:text-aura-text hover:underline">Sign In for Vault Storage & Higher AI Limits</a>
        </div>
      </div>
      <h1 class="text-2xl sm:text-3xl font-serif font-normal text-aura-text tracking-tight">
        Altrix Health Copilot
      </h1>
      <p class="text-aura-text-muted text-xs sm:text-sm max-w-2xl leading-relaxed">
        Choose between our deterministic <strong>40-Scenario Guided Health Guide</strong> (curated offline answers) and our <strong>AI Health Chat</strong> (educational health reasoning).
      </p>
    </div>

    <!-- Red Flag Emergency Notice Banner (High Priority Visibility) -->
    <div class="bg-rose-50/90 border border-rose-200 rounded-2xl p-4 text-xs text-rose-950 flex items-start gap-3 shadow-2xs">
      <ShieldAlert class="w-5 h-5 text-rose-600 shrink-0 mt-0.5" stroke-width={2} />
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <strong class="font-bold text-rose-900 text-xs sm:text-sm">Emergency Warning Notice</strong>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-200 text-rose-900">
            India: 112 / 108 • US: 911
          </span>
        </div>
        <p class="text-rose-800 leading-relaxed text-[11.5px] sm:text-xs">
          If you or someone nearby is experiencing chest pain, difficulty breathing, slurred speech, or loss of consciousness, 
          call emergency services immediately. A digital assistant cannot diagnose emergencies or prescribe medicines.
        </p>
      </div>
    </div>

    <!-- Main Copilot Chat Shell -->
    <div class="bg-aura-surface rounded-aura-panel border border-aura-border/40 shadow-aura-card overflow-hidden flex flex-col min-h-[660px]">
      <!-- Shell Header: Status, Mode Switcher, Turns Counter, Language Switcher -->
      <div class="bg-aura-surface-blush border-b border-aura-border px-5 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3">
        <!-- Dual Mode Switcher Tabs -->
        <div class="inline-flex rounded-full p-1 bg-white border border-aura-border text-xs font-semibold shadow-2xs">
          <button
            id="tab-mode-guided"
            type="button"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-aura-sidebar text-white shadow-2xs transition cursor-pointer"
          >
            <BookOpen class="w-3.5 h-3.5" />
            <span>Guided Guide (40 Scenarios)</span>
          </button>
          <button
            id="tab-mode-ai"
            type="button"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-aura-text-muted hover:text-aura-text transition cursor-pointer"
          >
            <Cpu class="w-3.5 h-3.5 text-aura-accent-orange" />
            <span>AI Health Chat</span>
          </button>
        </div>

        <div class="flex items-center gap-3">
          <!-- Session Turns Counter -->
          <div
            id="turn-counter-badge"
            class="px-2.5 py-1 rounded-full text-[11px] font-medium bg-white text-aura-text-muted border border-aura-border shadow-2xs"
            title="Guided guest conversations allow 6 turns. AI chat applies per-IP/user rate limits. Emergencies bypass all limits."
          >
            Session: <strong id="remaining-turns-text" class="text-aura-text font-bold">6 turns remaining</strong>
          </div>

          <!-- Language Selector -->
          <div class="inline-flex rounded-full p-0.5 bg-white border border-aura-border text-xs font-semibold shadow-2xs">
            <button
              id="lang-btn-en"
              type="button"
              class="px-3 py-1 rounded-full bg-aura-sidebar text-white shadow-2xs transition cursor-pointer"
            >
              English
            </button>
            <button
              id="lang-btn-te"
              type="button"
              class="px-3 py-1 rounded-full text-aura-text-muted hover:text-aura-text transition cursor-pointer"
            >
              తెలుగు
            </button>
          </div>
        </div>
      </div>

      <!-- AI Privacy Notice Banner (Active in AI mode) -->
      <div id="ai-privacy-banner" class="hidden bg-amber-50/90 border-b border-amber-200 px-5 py-2.5 text-xs text-amber-950 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <Info class="w-4 h-4 text-amber-700 shrink-0" />
          <span><strong>Educational Prototype:</strong> Do NOT submit real names, medical records, or sensitive private data. AI answers are general education only.</span>
        </div>
        <span class="text-[10.5px] font-mono px-2 py-0.5 rounded bg-amber-200/70 text-amber-900 shrink-0">Altrix Copilot</span>
      </div>

      <!-- Scrollable Chat Messages Container -->
      <div id="chat-messages" class="flex-grow p-4 sm:p-6 space-y-4 overflow-y-auto max-h-[460px] bg-aura-canvas/40">
        <!-- Initial Welcome Bubble -->
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-full bg-aura-sidebar text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 shadow-xs">
            <Bot class="w-4 h-4 text-aura-accent-orange" stroke-width={2} />
          </div>
          <div class="bg-white rounded-2xl rounded-tl-xs p-4 sm:p-5 max-w-xl text-xs sm:text-sm text-aura-text space-y-3 leading-relaxed border border-aura-border/60 shadow-2xs">
            <p id="welcome-message" class="font-medium">
              Hello! I am your <strong>Altrix Guided Health Copilot</strong>. You can freely ask about 40 health topics including fever, headaches, laboratory reports, safe medicine principles, and emergency first aid below.
            </p>
            <div class="p-3 rounded-xl bg-aura-surface-blush border border-aura-border/60 text-[11.5px] text-aura-text-muted space-y-1">
              <strong class="text-aura-text block">Clinical Boundary Notice:</strong>
              I provide curated educational information from authoritative sources. I cannot diagnose, provide personal doses, or replace clinical consultations.
            </div>
          </div>
        </div>
      </div>

      <!-- Categorized Quick-Reply Topic Dock (Active in Guided mode) -->
      <div id="guided-topic-dock" class="p-4 bg-aura-surface-blush/80 border-t border-aura-border space-y-3">
        <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-aura-text-subtle">
          <span id="topic-dock-title">Popular Guided Topics • Tap to explore:</span>
          <span class="text-[10px] lowercase font-normal">no records required</span>
        </div>

        <!-- Curated Topic Chips Grid -->
        <div class="flex flex-wrap gap-2 text-xs">
          <!-- 1. Symptoms -->
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-query="I have a fever."
          >
            <Flame class="w-3.5 h-3.5 text-aura-accent-orange" />
            <span>Fever Guidance</span>
          </button>
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-query="I have a headache."
          >
            <Stethoscope class="w-3.5 h-3.5 text-aura-accent-orange" />
            <span>Headache / Migraine</span>
          </button>
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-query="I have a cough."
          >
            <Wind class="w-3.5 h-3.5 text-aura-accent-orange" />
            <span>Cough Evaluation</span>
          </button>
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-query="My stomach hurts."
          >
            <HeartPulse class="w-3.5 h-3.5 text-aura-accent-orange" />
            <span>Stomach Pain</span>
          </button>

          <!-- 2. Lab Reports -->
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-query="Can you explain my blood test report?"
          >
            <BookOpen class="w-3.5 h-3.5 text-teal-600" />
            <span>Explain Lab Report</span>
          </button>
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-query="My HbA1c is elevated."
          >
            <Sparkle class="w-3.5 h-3.5 text-amber-600" />
            <span>High HbA1c Results</span>
          </button>

          <!-- 3. Medicine Information -->
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-aura-border hover:border-aura-sidebar hover:bg-white text-aura-text font-medium shadow-2xs transition cursor-pointer"
            data-query="Can you read my prescription?"
          >
            <Pill class="w-3.5 h-3.5 text-indigo-600" />
            <span>Read Prescription</span>
          </button>

          <!-- 4. Emergency Signs -->
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-rose-50 border border-rose-300 hover:border-rose-500 text-rose-900 font-semibold shadow-2xs transition cursor-pointer"
            data-query="I have chest pain."
          >
            <AlertTriangle class="w-3.5 h-3.5 text-rose-600" />
            <span>Chest Pain / Emergency (112)</span>
          </button>

          <!-- 5. Telugu Support -->
          <button
            type="button"
            class="topic-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-indigo-50 border border-indigo-200 hover:border-indigo-400 text-indigo-900 font-medium shadow-2xs transition cursor-pointer"
            data-query="Explain my report in Telugu."
          >
            <span>🌐 తెలుగు గైడ్ (Telugu)</span>
          </button>
        </div>
      </div>

      <!-- Chat Input Field -->
      <div class="p-4 bg-white border-t border-aura-border">
        <form id="chat-form" class="flex gap-2">
          <input
            id="chat-input"
            type="text"
            placeholder="Ask any health question, e.g. 'Can you explain my cholesterol results?'"
            class="flex-grow px-4 py-2.5 rounded-full border border-aura-border text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-aura-sidebar placeholder:text-aura-text-subtle bg-white"
            aria-label="Ask health question"
          />
          <button
            id="chat-submit"
            type="submit"
            class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-aura-action hover:bg-aura-action-hover text-white font-semibold text-xs sm:text-sm transition shadow-xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-aura-sidebar"
          >
            <span>Send</span>
            <Send class="w-3.5 h-3.5" stroke-width={2} />
          </button>
        </form>

        <div class="flex items-center justify-between text-[11px] text-aura-text-subtle mt-2 px-1">
          <span id="footer-sources-text">Sources: MedlinePlus, CDC, American Heart Association</span>
          <div class="flex items-center gap-3">
            <a href="/auth" class="hover:text-aura-text underline">Sign In / Sign Up</a>
            <span>•</span>
            <button
              type="button"
              id="btn-restart-chat"
              class="hover:text-aura-text underline cursor-pointer"
            >
              Restart Session
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes altrix-dot-bounce {
    0%, 80%, 100% {
      transform: translateY(0);
      opacity: 0.35;
    }
    40% {
      transform: translateY(-5px);
      opacity: 1;
    }
  }

  .thinking-dot {
    animation: altrix-dot-bounce 1.3s infinite ease-in-out;
  }
  .thinking-dot:nth-child(1) { animation-delay: 0s; }
  .thinking-dot:nth-child(2) { animation-delay: 0.16s; }
  .thinking-dot:nth-child(3) { animation-delay: 0.32s; }
  .thinking-dot:nth-child(4) { animation-delay: 0.48s; }
  .thinking-dot:nth-child(5) { animation-delay: 0.64s; }

  @media (prefers-reduced-motion: reduce) {
    .thinking-dot {
      animation: none !important;
      opacity: 0.85 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { ConversationEngine } from '../lib/chatbot/conversationEngine';
  import { getCurrentUser } from '../lib/supabase/auth';
  import type { ChatIntentMatch } from '../types/healthChat';
  import {
    createThinkingIndicatorHtml,
    formatMessageText,
    escapeHtml,
    sanitizeChatErrorMessage,
    getProviderDisplayLabel,
    planTypewriter,
  } from '../lib/chatbot/chat-ux';

  type ActiveMode = 'guided' | 'ai';
  let activeMode: ActiveMode = 'guided';

  let engine = new ConversationEngine({ locale: 'en' });
  let currentLocale: 'en' | 'te' = 'en';
  let aiChatHistory: Array<{ role: 'user' | 'assistant'; content: string }> = [];
  let userAuthToken: string | null = null;

  const chatMessages = document.getElementById('chat-messages');
  const chatForm = document.getElementById('chat-form') as HTMLFormElement | null;
  const chatInput = document.getElementById('chat-input') as HTMLInputElement | null;
  const chatSubmit = document.getElementById('chat-submit') as HTMLButtonElement | null;
  const langBtnEn = document.getElementById('lang-btn-en');
  const langBtnTe = document.getElementById('lang-btn-te');
  const welcomeMessage = document.getElementById('welcome-message');
  const remainingTurnsText = document.getElementById('remaining-turns-text');
  const btnRestartChat = document.getElementById('btn-restart-chat');
  const sessionModeText = document.getElementById('session-mode-text');
  const authStatusContainer = document.getElementById('auth-status-container');
  const tabModeGuided = document.getElementById('tab-mode-guided');
  const tabModeAi = document.getElementById('tab-mode-ai');
  const aiPrivacyBanner = document.getElementById('ai-privacy-banner');
  const guidedTopicDock = document.getElementById('guided-topic-dock');
  const topicChips = document.querySelectorAll('.topic-chip');

  // Check auth session
  async function initAuth() {
    try {
      const user = await getCurrentUser();
      if (user) {
        engine.setAuthenticated(true);
        if (sessionModeText) {
          sessionModeText.textContent = `Signed In: ${user.email || 'User'} • Vault Mode`;
        }
        if (authStatusContainer) {
          authStatusContainer.innerHTML = `<span>•</span> <span class="font-medium text-emerald-800">Authenticated (Unlimited Guided Turns)</span>`;
        }
        // Retrieve local access token if present in session storage or cookie
        userAuthToken = (window as any).__SUPABASE_ACCESS_TOKEN__ || null;
        updateTurnsDisplay();
      }
    } catch {
      // Keep guest mode
    }
  }

  function setMode(mode: ActiveMode) {
    activeMode = mode;
    if (mode === 'guided') {
      tabModeGuided?.classList.add('bg-aura-sidebar', 'text-white', 'shadow-2xs');
      tabModeGuided?.classList.remove('text-aura-text-muted');
      tabModeAi?.classList.remove('bg-aura-sidebar', 'text-white', 'shadow-2xs');
      tabModeAi?.classList.add('text-aura-text-muted');
      aiPrivacyBanner?.classList.add('hidden');
      guidedTopicDock?.classList.remove('hidden');
      if (chatInput) {
        chatInput.placeholder = "Ask any of the 40 health topics, e.g. 'Can you explain my cholesterol results?'";
      }
    } else {
      tabModeAi?.classList.add('bg-aura-sidebar', 'text-white', 'shadow-2xs');
      tabModeAi?.classList.remove('text-aura-text-muted');
      tabModeGuided?.classList.remove('bg-aura-sidebar', 'text-white', 'shadow-2xs');
      tabModeGuided?.classList.add('text-aura-text-muted');
      aiPrivacyBanner?.classList.remove('hidden');
      guidedTopicDock?.classList.add('hidden');
      if (chatInput) {
        chatInput.placeholder = "Ask general educational health question...";
      }
    }
    updateTurnsDisplay();
  }

  tabModeGuided?.addEventListener('click', () => setMode('guided'));
  tabModeAi?.addEventListener('click', () => setMode('ai'));

  function updateTurnsDisplay() {
    if (!remainingTurnsText) return;

    if (activeMode === 'ai') {
      const state = engine.getSessionState();
      remainingTurnsText.textContent = state.isAuthenticated ? 'AI Mode: 20 / 10m' : 'AI Mode: 5 / 10m';
      remainingTurnsText.classList.remove('text-amber-700');
      return;
    }

    const state = engine.getSessionState();
    if (state.isAuthenticated) {
      remainingTurnsText.textContent = 'Unlimited (Member)';
      remainingTurnsText.classList.remove('text-amber-700');
      return;
    }

    const remaining = state.remainingTurns;
    remainingTurnsText.textContent = `${remaining} turn${remaining === 1 ? '' : 's'} remaining`;

    if (remaining === 0) {
      remainingTurnsText.classList.add('text-amber-700');
    } else {
      remainingTurnsText.classList.remove('text-amber-700');
    }
  }

  function appendUserBubble(text: string) {
    if (!chatMessages) return;
    const div = document.createElement('div');
    div.className = 'flex items-start justify-end gap-3';
    div.innerHTML = `
      <div class="bg-aura-sidebar text-white rounded-2xl rounded-tr-xs p-3.5 sm:p-4 max-w-lg text-xs sm:text-sm leading-relaxed shadow-2xs">
        ${escapeHtml(text)}
      </div>
      <div class="w-7 h-7 rounded-full bg-aura-accent-purple text-aura-accent-purple-strong flex items-center justify-center font-bold text-xs shrink-0 mt-1 border border-aura-border">
        U
      </div>
    `;
    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  let isRequestPending = false;
  let currentTypingSessionId = 0;

  function cancelActiveTyping() {
    currentTypingSessionId++;
  }

  function setRequestPending(pending: boolean) {
    isRequestPending = pending;
    if (chatSubmit) {
      chatSubmit.disabled = pending;
      if (pending) {
        chatSubmit.classList.add('opacity-60', 'cursor-not-allowed');
      } else {
        chatSubmit.classList.remove('opacity-60', 'cursor-not-allowed');
      }
    }
    if (chatInput) {
      chatInput.setAttribute('aria-busy', String(pending));
    }
  }

  function autoScrollIfAtBottom() {
    if (!chatMessages) return;
    const isNearBottom =
      chatMessages.scrollHeight - chatMessages.scrollTop - chatMessages.clientHeight < 80;
    if (isNearBottom) {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }
  }

  function showThinkingIndicator(): HTMLElement {
    removeThinkingIndicator();
    const div = document.createElement('div');
    div.id = 'copilot-thinking-bubble';
    div.className = 'flex items-start gap-3 thinking-bubble';
    div.setAttribute('role', 'status');
    div.setAttribute('aria-live', 'polite');
    div.innerHTML = `
      <div class="w-8 h-8 rounded-full bg-aura-sidebar text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 shadow-xs">
        AI
      </div>
      <div class="bg-white rounded-2xl rounded-tl-xs p-3.5 sm:p-4 max-w-sm text-xs text-aura-text-muted space-y-1.5 border border-aura-border shadow-2xs">
        ${createThinkingIndicatorHtml()}
      </div>
    `;
    chatMessages?.appendChild(div);
    if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
    return div;
  }

  function removeThinkingIndicator() {
    const existing = document.getElementById('copilot-thinking-bubble');
    if (existing) {
      existing.remove();
    }
    const legacy = document.getElementById('ai-loading-bubble');
    if (legacy) {
      legacy.remove();
    }
  }


  function runTypewriter(params: {
    element: HTMLElement;
    fullText: string;
    isEmergency?: boolean;
    onTick?: () => void;
    onComplete?: () => void;
  }) {
    const { element, fullText, isEmergency, onTick, onComplete } = params;
    const sessionId = ++currentTypingSessionId;

    const prefersReducedMotion =
      typeof window !== 'undefined' &&
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Immediate bypass for emergency guidance or reduced-motion preference
    if (isEmergency || prefersReducedMotion || !fullText) {
      element.innerHTML = formatMessageText(fullText);
      if (onTick) onTick();
      if (onComplete) onComplete();
      return;
    }

    const tokens = fullText.split(/(\s+)/);
    if (tokens.length <= 1) {
      element.innerHTML = formatMessageText(fullText);
      if (onTick) onTick();
      if (onComplete) onComplete();
      return;
    }

    // Adaptive speed bounded between 250ms and 750ms
    const targetDuration = Math.min(750, Math.max(250, fullText.length * 1.5));
    const tickInterval = 20;
    const totalTicks = Math.max(1, Math.ceil(targetDuration / tickInterval));
    const tokensPerTick = Math.max(1, Math.ceil(tokens.length / totalTicks));

    let currentIndex = 0;
    let accumulatedText = '';
    element.innerHTML = '';

    const intervalId = window.setInterval(() => {
      // Check if session was cancelled or overwritten
      if (sessionId !== currentTypingSessionId) {
        window.clearInterval(intervalId);
        return;
      }

      const nextIndex = Math.min(tokens.length, currentIndex + tokensPerTick);
      for (let i = currentIndex; i < nextIndex; i++) {
        accumulatedText += tokens[i];
      }
      currentIndex = nextIndex;

      element.innerHTML = formatMessageText(accumulatedText);
      if (onTick) onTick();

      if (currentIndex >= tokens.length) {
        window.clearInterval(intervalId);
        element.innerHTML = formatMessageText(fullText);
        if (onTick) onTick();
        if (onComplete) onComplete();
      }
    }, tickInterval);
  }

  function appendIntentBubble(match: ChatIntentMatch) {
    if (!chatMessages) return;
    const div = document.createElement('div');
    div.className = 'flex items-start gap-3';

    let badgeClass = 'bg-emerald-50 text-emerald-800 border-emerald-200';
    let badgeLabel = 'ℹ Educational Guidance';
    let iconSymbol = '+';
    let iconBg = 'bg-aura-sidebar';

    const isEmergency = match.safetyLevel === 'urgent' || match.isEmergency;
    if (isEmergency) {
      badgeClass = 'bg-rose-100 text-rose-900 border-rose-300 font-bold';
      badgeLabel = '🚨 Urgent Emergency Priority';
      iconSymbol = '!';
      iconBg = 'bg-rose-600';
    } else if (match.safetyLevel === 'caution') {
      badgeClass = 'bg-amber-100 text-amber-900 border-amber-300 font-semibold';
      badgeLabel = '⚠ Caution / Medication Safety';
      iconSymbol = '⚠';
      iconBg = 'bg-amber-600';
    }

    let quickRepliesHtml = '';
    if (match.quickReplies && match.quickReplies.length > 0) {
      quickRepliesHtml = `
        <div class="pt-2 border-t border-aura-border/40 space-y-1.5">
          <div class="text-[10.5px] font-bold uppercase tracking-wider text-aura-text-subtle">
            ${match.type === 'disambiguation' ? 'Select specific topic:' : 'Follow-up exploration:'}
          </div>
          <div class="flex flex-wrap gap-1.5">
            ${match.quickReplies
              .map(
                (qr) => `
              <button
                type="button"
                class="quick-reply-btn px-3 py-1 rounded-full text-xs font-medium bg-aura-surface-cream hover:bg-white text-aura-text border border-aura-border transition shadow-2xs cursor-pointer"
                data-reply="${escapeHtml(qr)}"
              >
                ${escapeHtml(qr)}
              </button>
            `
              )
              .join('')}
          </div>
        </div>
      `;
    }

    // AI handoff button if fallback or user requested
    let aiHandoffHtml = '';
    if (match.type === 'fallback') {
      aiHandoffHtml = `
        <div class="p-2.5 rounded-xl bg-aura-surface-blush border border-aura-border text-xs flex items-center justify-between gap-2">
          <span>Need deeper AI exploration for this query?</span>
          <button type="button" class="btn-handoff-ai px-3 py-1 rounded-full bg-aura-action text-white text-[11px] font-semibold hover:bg-aura-action-hover cursor-pointer">
            Ask Altrix AI Chat ↗
          </button>
        </div>
      `;
    }

    let citationsHtml = '';
    if (match.citations && match.citations.length > 0) {
      citationsHtml = `
        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-aura-border/40 text-[10.5px] text-aura-text-subtle">
          <span class="font-semibold">Source Citations:</span>
          ${match.citations
            .map(
              (c) => `
            <a href="${escapeHtml(c.url)}" target="_blank" rel="noopener noreferrer" class="text-aura-accent-orange font-bold hover:underline inline-flex items-center gap-0.5">
              ${escapeHtml(c.organization)} (${escapeHtml(c.title)}) ↗
            </a>
          `
            )
            .join(' • ')}
        </div>
      `;
    }

    div.innerHTML = `
      <div class="w-8 h-8 rounded-full ${iconBg} text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 shadow-xs">
        ${iconSymbol}
      </div>
      <div class="bg-white rounded-2xl rounded-tl-xs p-4 sm:p-5 max-w-xl text-xs sm:text-sm text-aura-text space-y-3 leading-relaxed border border-aura-border/60 shadow-2xs">
        <div class="flex items-center justify-between gap-2">
          <span class="px-2 py-0.5 rounded-full text-[10px] border ${badgeClass}">
            ${badgeLabel}
          </span>
          ${match.scenario ? `<span class="text-[10px] text-aura-text-muted font-mono">Scenario #${match.scenario.scenarioNumber}</span>` : ''}
        </div>

        <div class="message-body leading-relaxed"></div>

        <div class="message-extras space-y-3 ${isEmergency ? '' : 'hidden'}">
          ${aiHandoffHtml}
          ${quickRepliesHtml}
          ${citationsHtml}
          <div class="p-2 rounded-lg bg-aura-surface-blush text-[10.5px] text-aura-text-subtle leading-tight">
            ${escapeHtml(match.disclaimer)}
          </div>
        </div>
      </div>
    `;

    chatMessages.appendChild(div);
    if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;

    // Attach listeners
    div.querySelectorAll('.quick-reply-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const reply = btn.getAttribute('data-reply');
        if (reply) {
          if (reply === 'Sign In / Sign Up') {
            window.location.href = '/auth';
          } else if (reply === 'Restart Session') {
            btnRestartChat?.click();
          } else {
            handleUserQuery(reply);
          }
        }
      });
    });

    div.querySelector('.btn-handoff-ai')?.addEventListener('click', () => {
      setMode('ai');
      appendUserBubble('Switching to AI Health Chat...');
    });

    const bodyEl = div.querySelector('.message-body') as HTMLElement;
    const extrasEl = div.querySelector('.message-extras') as HTMLElement;

    runTypewriter({
      element: bodyEl,
      fullText: match.message,
      isEmergency,
      onTick: autoScrollIfAtBottom,
      onComplete: () => {
        extrasEl?.classList.remove('hidden');
        autoScrollIfAtBottom();
      },
    });
  }

  function appendAIBubble(data: {
    message: string;
    isMockFallback: boolean;
    isUnavailable?: boolean;
    provider: string;
    disclaimer: string;
    suggestedQuestions?: string[];
    isEmergency?: boolean;
    isBlockedDosage?: boolean;
  }) {
    if (!chatMessages) return;
    const div = document.createElement('div');
    div.className = 'flex items-start gap-3';

    const isUnavailable = Boolean(data.isUnavailable || data.isMockFallback);
    let badgeClass = 'bg-indigo-50 text-indigo-900 border-indigo-200';
    let badgeLabel = '🤖 Altrix Health Copilot';
    if (data.isEmergency) {
      badgeClass = 'bg-rose-100 text-rose-900 border-rose-300 font-bold';
      badgeLabel = '🚨 Urgent Emergency Priority';
    } else if (data.isBlockedDosage) {
      badgeClass = 'bg-amber-100 text-amber-900 border-amber-300 font-semibold';
      badgeLabel = '⚠ Caution / Dosage Safety';
    } else if (isUnavailable) {
      badgeClass = 'bg-amber-100 text-amber-900 border-amber-300 font-semibold';
      badgeLabel = '⚠ Health Assistant Temporarily Unavailable';
    }

    const providerDisplay = getProviderDisplayLabel(data);

    div.innerHTML = `
      <div class="w-8 h-8 rounded-full ${isUnavailable && !data.isEmergency && !data.isBlockedDosage ? 'bg-amber-600' : 'bg-aura-sidebar'} text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 shadow-xs">
        ${isUnavailable && !data.isEmergency && !data.isBlockedDosage ? '!' : 'AI'}
      </div>
      <div class="bg-white rounded-2xl rounded-tl-xs p-4 sm:p-5 max-w-xl text-xs sm:text-sm text-aura-text space-y-3 leading-relaxed border ${isUnavailable && !data.isEmergency && !data.isBlockedDosage ? 'border-amber-200 bg-amber-50/30' : 'border-aura-border/60'} shadow-2xs">
        <div class="flex items-center justify-between gap-2">
          <span class="px-2 py-0.5 rounded-full text-[10px] border ${badgeClass}">
            ${badgeLabel}
          </span>
          <span class="text-[10px] text-aura-text-muted font-mono">
            ${providerDisplay}
          </span>
        </div>

        <div class="message-body leading-relaxed"></div>

        <div class="message-extras space-y-3 ${data.isEmergency ? '' : 'hidden'}">
          ${
            isUnavailable && !data.isEmergency && !data.isBlockedDosage
              ? `
            <div class="pt-2 border-t border-amber-200/60">
              <button
                type="button"
                class="btn-switch-to-guided inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-aura-sidebar text-white text-xs font-semibold hover:bg-black transition shadow-xs cursor-pointer"
              >
                <span>Explore Guided Health Guide (40 Scenarios)</span>
                <span>→</span>
              </button>
            </div>
          `
              : ''
          }

          ${
            data.suggestedQuestions && data.suggestedQuestions.length > 0
              ? `
            <div class="pt-2 border-t border-aura-border/40 space-y-1.5">
              <div class="text-[10.5px] font-bold uppercase tracking-wider text-aura-text-subtle">
                ${isUnavailable ? 'Available Guided Topics:' : 'Suggested Questions:'}
              </div>
              <div class="flex flex-wrap gap-1.5">
                ${data.suggestedQuestions
                  .map(
                    (q) => `
                  <button type="button" class="quick-reply-btn px-3 py-1 rounded-full text-xs font-medium bg-aura-surface-cream hover:bg-white text-aura-text border border-aura-border transition shadow-2xs cursor-pointer" data-reply="${escapeHtml(q)}">
                    ${escapeHtml(q)}
                  </button>
                `
                  )
                  .join('')}
              </div>
            </div>
          `
              : ''
          }

          <div class="p-2 rounded-lg bg-aura-surface-blush text-[10.5px] text-aura-text-subtle leading-tight">
            ${escapeHtml(data.disclaimer)}
          </div>
        </div>
      </div>
    `;

    chatMessages.appendChild(div);
    if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;

    div.querySelector('.btn-switch-to-guided')?.addEventListener('click', () => {
      setMode('guided');
    });

    div.querySelectorAll('.quick-reply-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const reply = btn.getAttribute('data-reply');
        if (reply) {
          if (isUnavailable) {
            setMode('guided');
          }
          handleUserQuery(reply);
        }
      });
    });

    const bodyEl = div.querySelector('.message-body') as HTMLElement;
    const extrasEl = div.querySelector('.message-extras') as HTMLElement;

    runTypewriter({
      element: bodyEl,
      fullText: data.message,
      isEmergency: Boolean(data.isEmergency),
      onTick: autoScrollIfAtBottom,
      onComplete: () => {
        extrasEl?.classList.remove('hidden');
        autoScrollIfAtBottom();
      },
    });
  }

  function appendErrorBubble(errorMsg: string, retryQuery: string) {
    if (!chatMessages) return;
    const div = document.createElement('div');
    div.className = 'flex items-start gap-3';
    div.innerHTML = `
      <div class="w-8 h-8 rounded-full bg-rose-600 text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 shadow-xs">
        !
      </div>
      <div class="bg-rose-50 border border-rose-200 rounded-2xl rounded-tl-xs p-4 sm:p-5 max-w-xl text-xs sm:text-sm text-rose-950 space-y-3 leading-relaxed shadow-2xs">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10.5px] border border-rose-300 bg-rose-100 text-rose-900 font-bold">
            ⚠ Service Notice
          </span>
        </div>
        <p class="leading-relaxed font-medium text-rose-950 text-xs sm:text-sm">
          ${escapeHtml(errorMsg)}
        </p>
        <div class="pt-1 flex flex-wrap items-center gap-2.5">
          <button
            type="button"
            class="btn-switch-to-guided inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-aura-sidebar hover:bg-black text-white text-xs font-semibold transition cursor-pointer shadow-xs"
          >
            <span>Continue with Guided Health Guide</span>
            <span>→</span>
          </button>
          <button
            type="button"
            class="btn-retry-chat inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white border border-rose-300 text-rose-800 text-xs font-semibold hover:bg-rose-100 transition cursor-pointer shadow-2xs"
          >
            <span>Retry</span>
          </button>
        </div>
      </div>
    `;
    chatMessages.appendChild(div);
    autoScrollIfAtBottom();

    div.querySelector('.btn-switch-to-guided')?.addEventListener('click', () => {
      setMode('guided');
    });

    div.querySelector('.btn-retry-chat')?.addEventListener('click', () => {
      div.remove();
      handleUserQuery(retryQuery);
    });
  }


  async function handleAIQuery(query: string) {
    const trimmed = query.trim();
    if (!trimmed || isRequestPending) return;

    setRequestPending(true);
    appendUserBubble(trimmed);
    if (chatInput) chatInput.value = '';

    aiChatHistory.push({ role: 'user', content: trimmed });
    const startTime = Date.now();
    showThinkingIndicator();

    try {
      const headers: Record<string, string> = {
        'Content-Type': 'application/json',
      };
      if (userAuthToken) {
        headers['Authorization'] = `Bearer ${userAuthToken}`;
      }

      const res = await fetch('/api/copilot/chat', {
        method: 'POST',
        headers,
        body: JSON.stringify({
          messages: aiChatHistory,
          locale: currentLocale,
        }),
      });

      if (!res.ok) {
        removeThinkingIndicator();
        setRequestPending(false);
        const errJson = await res.json().catch(() => null);
        const displayError = sanitizeChatErrorMessage(res.status, errJson?.error);
        appendErrorBubble(displayError, trimmed);
        return;
      }

      const data = await res.json();
      aiChatHistory.push({ role: 'assistant', content: data.message });

      // Emergency red-flag advice bypasses artificial presentation delay
      if (!data.isEmergency) {
        const elapsed = Date.now() - startTime;
        const minTransitionMs = 250;
        if (elapsed < minTransitionMs) {
          await new Promise((resolve) => setTimeout(resolve, minTransitionMs - elapsed));
        }
      }

      removeThinkingIndicator();
      setRequestPending(false);
      appendAIBubble(data);
      updateTurnsDisplay();
    } catch (err: any) {
      removeThinkingIndicator();
      setRequestPending(false);
      console.warn('AI chat request failed:', err?.message || err);
      appendErrorBubble(
        'Health Copilot is temporarily unavailable. Please try again shortly, or continue with the Guided Health Guide.',
        trimmed
      );
    }
  }

  async function handleUserQuery(query: string) {
    if (isRequestPending) return;

    const trimmed = query.trim();
    if (!trimmed) return;

    if (activeMode === 'ai') {
      await handleAIQuery(trimmed);
      return;
    }

    // Guided Mode
    // Deterministic pre-check: emergency guidance bypasses presentation delay completely
    const previewMatch = engine.processMessage(trimmed);
    const isEmergency = previewMatch.safetyLevel === 'urgent' || previewMatch.isEmergency;

    appendUserBubble(trimmed);
    if (chatInput) chatInput.value = '';

    if (isEmergency) {
      updateTurnsDisplay();
      appendIntentBubble(previewMatch);
      return;
    }

    setRequestPending(true);
    showThinkingIndicator();

    // Short visual transition for ordinary responses so indicator does not flash for 1 frame
    await new Promise((resolve) => setTimeout(resolve, 220));

    removeThinkingIndicator();
    setRequestPending(false);
    updateTurnsDisplay();
    appendIntentBubble(previewMatch);
  }

  // Language switcher
  langBtnEn?.addEventListener('click', () => {
    currentLocale = 'en';
    engine.setLocale('en');
    langBtnEn.classList.add('bg-aura-sidebar', 'text-white', 'shadow-2xs');
    langBtnEn.classList.remove('text-aura-text-muted');
    langBtnTe?.classList.remove('bg-aura-sidebar', 'text-white', 'shadow-2xs');
    langBtnTe?.classList.add('text-aura-text-muted');
    if (welcomeMessage) {
      welcomeMessage.innerHTML = 'Hello! I am your <strong>Altrix Guided Health Copilot</strong>. You can freely ask about 40 health topics including fever, headaches, laboratory reports, safe medicine principles, and emergency first aid below.';
    }
  });

  langBtnTe?.addEventListener('click', () => {
    currentLocale = 'te';
    engine.setLocale('te');
    langBtnTe.classList.add('bg-aura-sidebar', 'text-white', 'shadow-2xs');
    langBtnTe.classList.remove('text-aura-text-muted');
    langBtnEn?.classList.remove('bg-aura-sidebar', 'text-white', 'shadow-2xs');
    langBtnEn?.classList.add('text-aura-text-muted');
    if (welcomeMessage) {
      welcomeMessage.innerHTML = 'నమస్కారం! నేను మీ <strong>ఆల్ట్రిక్స్ గైడెడ్ హెల్త్ కోపైలట్</strong>. లాగిన్ అవసరం లేకుండానే 40 ఆరోగ్య అంశాలపై క్లినికల్ సమాచారాన్ని ఇక్కడ తెలుసుకోవచ్చు.';
    }
  });

  // Topic chips in dock
  topicChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const q = chip.getAttribute('data-query');
      if (q) handleUserQuery(q);
    });
  });

  // Chat form submit
  chatForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (chatInput) {
      handleUserQuery(chatInput.value);
    }
  });

  // Restart chat
  btnRestartChat?.addEventListener('click', () => {
    cancelActiveTyping();
    removeThinkingIndicator();
    setRequestPending(false);
    engine.reset();
    aiChatHistory = [];
    updateTurnsDisplay();
    if (chatMessages) {
      chatMessages.innerHTML = '';
      const div = document.createElement('div');
      div.className = 'flex items-start gap-3';
      div.innerHTML = `
        <div class="w-8 h-8 rounded-full bg-aura-sidebar text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 shadow-xs">
          +
        </div>
        <div class="bg-white rounded-2xl rounded-tl-xs p-4 sm:p-5 max-w-xl text-xs sm:text-sm text-aura-text space-y-2 leading-relaxed border border-aura-border/60 shadow-2xs">
          <p class="font-medium">
            Session refreshed. 6 guided guest turns available. Tap any popular topic below or type your health question.
          </p>
        </div>
      `;
      chatMessages.appendChild(div);
    }
  });

  // Handle URL query params
  function checkUrlParams() {
    const params = new URLSearchParams(window.location.search);
    const modeParam = params.get('mode');
    if (modeParam === 'ai') {
      setMode('ai');
    }
    const localeParam = params.get('locale');
    if (localeParam === 'te') {
      langBtnTe?.click();
    }
    const queryParam = params.get('query');
    if (queryParam) {
      setTimeout(() => {
        handleUserQuery(queryParam);
      }, 100);
    }
  }

  // Initialize
  initAuth();
  updateTurnsDisplay();
  checkUrlParams();
</script>
