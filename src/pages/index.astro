---
import {
  MessageSquare,
  ShieldCheck,
  ArrowRight,
  Sparkles,
  FileText,
  Activity,
  AlertTriangle,
  Lock,
  CheckCircle2,
  Globe,
  Upload,
} from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Home"
  description="Altrix Health Copilot — Understand your medical records with clarity, trace every parameter, and explore guided health topics."
>
  <div class="px-4 sm:px-6 lg:px-8 py-8 sm:py-12 max-w-7xl mx-auto space-y-12 sm:space-y-16">
    <!-- 1. Hero Section with Fade-in Animation -->
    <div class="hero-animate space-y-6 max-w-4xl mx-auto text-center pt-4 sm:pt-8">
      <!-- Eyebrow Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-aura-surface-cream text-aura-text text-xs font-semibold border border-black/5 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-aura-accent-orange animate-pulse"></span>
        <span>Aura Health Platform • HacXLerate 2026</span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-normal text-aura-text tracking-tight leading-[1.1]">
        Altrix Health Copilot
      </h1>

      <!-- Tagline & Description -->
      <p class="text-base sm:text-lg lg:text-xl text-aura-text-muted font-normal max-w-2xl mx-auto leading-relaxed">
        Understand your medical records with clarity, trace every clinical parameter, and explore source-backed health guidance.
      </p>

      <p class="text-xs sm:text-sm text-aura-text-muted/80 max-w-xl mx-auto leading-relaxed">
        An AI-powered personal health companion engineered to organize laboratory reports into plain-language insights grounded in reviewed evidence without inventing diagnoses or individual drug dosages.
      </p>

      <!-- Primary Call to Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <!-- Guest Guided Copilot CTA -->
        <a
          href="/copilot"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-aura-action hover:bg-aura-action-hover text-white text-sm font-semibold shadow-xs transition transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-aura-sidebar"
        >
          <MessageSquare class="w-4 h-4 text-aura-accent-orange" stroke-width={2} />
          <span>Try Health Copilot (Guest Mode)</span>
          <ArrowRight class="w-4 h-4" />
        </a>

        <!-- Continue to Workspace CTA -->
        <a
          id="btn-workspace-link"
          href="/dashboard"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-aura-surface-cream hover:bg-aura-surface-cream-light text-aura-text text-sm font-semibold shadow-xs transition border border-black/5"
        >
          <ShieldCheck class="w-4 h-4 text-emerald-700" stroke-width={2} />
          <span id="btn-workspace-text">Continue to Workspace</span>
        </a>
      </div>

      <!-- Reassuring sub-badge -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-xs text-aura-text-muted pt-2">
        <span class="inline-flex items-center gap-1.5">
          <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
          <span>No login required for health questions</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
          <span>English & Telugu support</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
          <span>Zero PHI data sharing</span>
        </span>
      </div>
    </div>

    <!-- 2. Popular Guided Topic Shortcuts -->
    <div class="bg-aura-surface rounded-aura-panel p-6 sm:p-8 shadow-aura-card border border-aura-border/40 space-y-4 max-w-5xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-aura-text-subtle">Instant Answers</span>
          <h2 class="text-xl font-serif font-normal text-aura-text mt-0.5">
            Explore Popular Clinical Topics
          </h2>
          <p class="text-xs text-aura-text-muted mt-0.5">
            Tap any topic to launch the Guided Health Copilot immediately:
          </p>
        </div>
        <a
          href="/copilot"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-aura-action hover:underline shrink-0"
        >
          <span>View all 40 scenarios</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- Chips Grid -->
      <div class="flex flex-wrap items-center gap-2.5 pt-2">
        <a
          href="/copilot?query=I%20have%20a%20fever"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-aura-surface-cream hover:bg-white text-aura-text border border-aura-border/60 text-xs font-medium transition shadow-2xs hover:shadow-xs"
        >
          <span>🌡 Fever Guidance</span>
        </a>
        <a
          href="/copilot?query=I%20have%20a%20headache"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-aura-surface-cream hover:bg-white text-aura-text border border-aura-border/60 text-xs font-medium transition shadow-2xs hover:shadow-xs"
        >
          <span>🤕 Headache / Migraine</span>
        </a>
        <a
          href="/copilot?query=Can%20you%20explain%20my%20blood%20test%20report"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-aura-surface-cream hover:bg-white text-aura-text border border-aura-border/60 text-xs font-medium transition shadow-2xs hover:shadow-xs"
        >
          <span>🧪 Explain Lab Report</span>
        </a>
        <a
          href="/copilot?query=Can%20you%20read%20my%20prescription"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-aura-surface-cream hover:bg-white text-aura-text border border-aura-border/60 text-xs font-medium transition shadow-2xs hover:shadow-xs"
        >
          <span>💊 Safe Medicine Use</span>
        </a>
        <a
          href="/copilot?query=I%20have%20chest%20pain"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-rose-50 hover:bg-rose-100 text-rose-900 border border-rose-200 text-xs font-semibold transition shadow-2xs"
        >
          <span>🚨 Emergency Red Flags (112)</span>
        </a>
        <a
          href="/copilot?query=Explain%20my%20report%20in%20Telugu&locale=te"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-indigo-50 hover:bg-indigo-100 text-indigo-900 border border-indigo-200 text-xs font-medium transition shadow-2xs"
        >
          <span>🌐 తెలుగు గైడ్ (Telugu)</span>
        </a>
        <a
          href="/copilot?mode=ai"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 text-xs font-semibold transition shadow-2xs"
        >
          <span>✨ Ask General Health AI (Gemini)</span>
        </a>
      </div>
    </div>

    <!-- 3. Four Core Architectural Pillars -->
    <div class="space-y-6 max-w-6xl mx-auto">
      <div class="text-center space-y-1">
        <span class="text-[10px] font-bold uppercase tracking-wider text-aura-text-subtle">Core Principles</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-normal text-aura-text">
          Engineered for Safety, Grounding, and Transparency
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Pillar 1: 40 Guided Scenarios -->
        <div class="bg-aura-surface rounded-aura-card p-6 shadow-aura-card border border-aura-border/40 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-aura-accent-peach/50 flex items-center justify-center text-aura-accent-orange">
              <MessageSquare class="w-5 h-5" />
            </div>
            <h3 class="font-serif font-normal text-aura-text text-lg">40 Guided Scenarios</h3>
            <p class="text-xs text-aura-text-muted leading-relaxed">
              Curated clinical question catalogue with deterministic matching, quick replies, and authoritative citations (CDC, MedlinePlus, AHA).
            </p>
          </div>
          <span class="text-[11px] font-semibold text-aura-accent-orange">Verified Sources</span>
        </div>

        <!-- Pillar 2: Traceable Extraction -->
        <div class="bg-aura-surface rounded-aura-card p-6 shadow-aura-card border border-aura-border/40 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-aura-surface-cream flex items-center justify-center text-aura-text">
              <FileText class="w-5 h-5" />
            </div>
            <h3 class="font-serif font-normal text-aura-text text-lg">Traceable Extraction</h3>
            <p class="text-xs text-aura-text-muted leading-relaxed">
              Medical document intake with structured reference range checking and optical uncertainty indicators for smudged or faint text.
            </p>
          </div>
          <span class="text-[11px] font-semibold text-aura-text">Zero Value Fabrication</span>
        </div>

        <!-- Pillar 3: Deterministic Safety Gates -->
        <div class="bg-aura-surface rounded-aura-card p-6 shadow-aura-card border border-aura-border/40 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-rose-50 flex items-center justify-center text-rose-700">
              <AlertTriangle class="w-5 h-5" />
            </div>
            <h3 class="font-serif font-normal text-aura-text text-lg">Safety Precedence</h3>
            <p class="text-xs text-aura-text-muted leading-relaxed">
              Life-threatening emergencies trigger immediate 112/108/911 escalation. Medication dosage queries receive strict clinical refusal.
            </p>
          </div>
          <span class="text-[11px] font-semibold text-rose-700">Pre-Model Interception</span>
        </div>

        <!-- Pillar 4: Tenant-Isolated Vault -->
        <div class="bg-aura-surface rounded-aura-card p-6 shadow-aura-card border border-aura-border/40 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-700">
              <Lock class="w-5 h-5" />
            </div>
            <h3 class="font-serif font-normal text-aura-text text-lg">Private Cloud Vault</h3>
            <p class="text-xs text-aura-text-muted leading-relaxed">
              Optional cloud storage backed by PostgreSQL Row Level Security. Authenticated records are accessible only by their creator.
            </p>
          </div>
          <span class="text-[11px] font-semibold text-emerald-700">Tenant-Isolated RLS</span>
        </div>
      </div>
    </div>

    <!-- 4. How It Works (3 Steps) -->
    <div class="bg-aura-surface-cream/40 rounded-aura-panel p-6 sm:p-10 border border-black/5 max-w-5xl mx-auto space-y-6">
      <div class="text-center space-y-1">
        <span class="text-[10px] font-bold uppercase tracking-wider text-aura-text-subtle">Simple Flow</span>
        <h2 class="text-2xl font-serif font-normal text-aura-text">
          How Altrix Health Copilot Works
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-aura-text-muted leading-relaxed">
        <div class="bg-white rounded-2xl p-5 shadow-2xs border border-aura-border/50 space-y-2">
          <div class="w-8 h-8 rounded-full bg-aura-surface-cream text-aura-text font-bold text-sm flex items-center justify-center">
            1
          </div>
          <h3 class="font-bold text-aura-text text-sm">Ask or Upload</h3>
          <p>
            Explore 40 clinical topics in guest mode without creating an account, or sign in to save documents to your private health vault.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-5 shadow-2xs border border-aura-border/50 space-y-2">
          <div class="w-8 h-8 rounded-full bg-aura-surface-cream text-aura-text font-bold text-sm flex items-center justify-center">
            2
          </div>
          <h3 class="font-bold text-aura-text text-sm">Review & Verify</h3>
          <p>
            Verify extracted clinical parameters, check optical uncertainty flags, and confirm values against your original source report.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-5 shadow-2xs border border-aura-border/50 space-y-2">
          <div class="w-8 h-8 rounded-full bg-aura-surface-cream text-aura-text font-bold text-sm flex items-center justify-center">
            3
          </div>
          <h3 class="font-bold text-aura-text text-sm">Consult with Clarity</h3>
          <p>
            Use plain-language summaries and tailored doctor questions to have more productive, informed discussions with your healthcare provider.
          </p>
        </div>
      </div>
    </div>

    <!-- 5. Clinical Safety Disclaimer -->
    <div class="bg-white rounded-2xl p-5 border border-aura-border shadow-2xs max-w-4xl mx-auto text-xs text-aura-text-muted leading-relaxed flex items-start gap-3">
      <AlertTriangle class="w-5 h-5 text-aura-accent-orange shrink-0 mt-0.5" stroke-width={2} />
      <div>
        <strong class="text-aura-text font-bold block mb-0.5">Clinical & Educational Notice:</strong>
        Altrix Health Copilot is an educational technology prototype. It is NOT a medical device, diagnostic engine, or clinical prescribing tool. It does not provide individualized medication dosages. In emergencies, immediately dial local emergency services (112, 108, or 911).
      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-animate {
    animation: heroFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-animate {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { getSupabaseClient } from '../lib/supabase/client';

  // Check if user is logged in to adjust hero workspace CTA
  const supabase = getSupabaseClient();
  if (supabase) {
    supabase.auth.getSession().then(({ data: { session } }) => {
      const workspaceBtn = document.getElementById('btn-workspace-link');
      const workspaceText = document.getElementById('btn-workspace-text');
      if (session?.user && workspaceBtn && workspaceText) {
        workspaceBtn.setAttribute('href', '/dashboard');
        workspaceText.textContent = 'Go to My Workspace';
      }
    });
  }
</script>
